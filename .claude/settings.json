{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/ferramenta-shorts/boot.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/ferramenta-shorts/garantir_sync.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "mcp__claude-code-remote__send_message",
      "mcp__claude-code-remote__send_later",
      "WebFetch",
      "WebSearch",
      "SendUserFile",
      "Skill",
      "NotebookEdit",
      "ToolSearch",
      "TaskCreate",
      "TaskUpdate",
      "TaskStop",
      "Monitor",
      "mcp__Firecrawl",
      "mcp__claude-code-remote__read_documentation",
      "mcp__claude-code-remote__get_session",
      "mcp__claude-code-remote__list_events",
      "mcp__claude-code-remote__list_sessions"
    ]
  }
}