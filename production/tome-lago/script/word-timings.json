{
 "voice": "pt-BR-AntonioNeural",
 "rate": "+6%",
 "pitch": "-2Hz",
 "engine": "edge-tts 7.3.1",
 "total": 69.472,
 "lines": [
  {
   "id": "L1",
   "shot": "S1",
   "beat": "gancho",
   "text": "Todo amanhecer, o velho Tomé jogava uma cadeira no lago.",
   "pause_before": 0.2,
   "start": 0.8,
   "end": 4.736,
   "dur": 3.936
  },
  {
   "id": "L2",
   "shot": "S1",
   "beat": "setup",
   "text": "Fazia três anos. Ele não pescava. Não vendia. Só jogava.",
   "pause_before": 0.35,
   "start": 5.086,
   "end": 12.286,
   "dur": 7.2
  },
  {
   "id": "L3",
   "shot": "S2",
   "beat": "zombador",
   "text": "O padeiro Zeca ria alto: Tomé, o lago não precisa de mobília!",
   "pause_before": 0.5,
   "start": 12.786,
   "end": 17.754,
   "dur": 4.968
  },
  {
   "id": "L4",
   "shot": "S3",
   "beat": "heroi",
   "text": "Tomé só sorria. E voltava no dia seguinte com a próxima.",
   "pause_before": 0.45,
   "start": 18.204,
   "end": 23.004,
   "dur": 4.8
  },
  {
   "id": "L5",
   "shot": "S4",
   "beat": "escalada",
   "text": "No segundo ano, uma mesa. No terceiro, uma cama.",
   "pause_before": 0.5,
   "start": 23.504,
   "end": 28.352,
   "dur": 4.848
  },
  {
   "id": "L6",
   "shot": "S4",
   "beat": "escalada",
   "text": "No último inverno, uma porta inteira. A cidade toda o chamava de louco.",
   "pause_before": 0.35,
   "start": 28.702,
   "end": 34.39,
   "dur": 5.688
  },
  {
   "id": "L7",
   "shot": "S5",
   "beat": "voce-ve",
   "text": "Sabe quando alguém guarda um pouco de dinheiro todo mês, e todo mundo acha exagero?",
   "pause_before": 0.5,
   "start": 34.89,
   "end": 40.05,
   "dur": 5.16
  },
  {
   "id": "L8",
   "shot": "S5",
   "beat": "voce-ve",
   "text": "Até o dia em que o carro quebra. Aí o exagero vira o único caminho.",
   "pause_before": 0.35,
   "start": 40.4,
   "end": 45.776,
   "dur": 5.376
  },
  {
   "id": "L9",
   "shot": "S6",
   "beat": "pagamento",
   "text": "No quarto inverno, a balsa afundou, e a ilha do mercado ficou isolada.",
   "pause_before": 0.5,
   "start": 46.276,
   "end": 51.484,
   "dur": 5.208
  },
  {
   "id": "L10",
   "shot": "S6",
   "beat": "pagamento",
   "text": "Até que Tomé caminhou sobre a água. Eram as cadeiras, as mesas e as camas, a um palmo da superfície.",
   "pause_before": 0.4,
   "start": 51.884,
   "end": 59.54,
   "dur": 7.656
  },
  {
   "id": "L11",
   "shot": "S6",
   "beat": "pagamento",
   "text": "Zeca atravessou primeiro, de pão na cabeça.",
   "pause_before": 0.35,
   "start": 59.89,
   "end": 63.226,
   "dur": 3.336
  },
  {
   "id": "L12",
   "shot": "S7",
   "beat": "loop",
   "text": "No dia seguinte, o padeiro chegou ao cais carregando uma cadeira.",
   "pause_before": 0.55,
   "start": 63.776,
   "end": 68.072,
   "dur": 4.296
  }
 ],
