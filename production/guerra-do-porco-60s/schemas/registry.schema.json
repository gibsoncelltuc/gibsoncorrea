{
 "title": "registry/registry.json",
 "type": "object",
 "required": [
  "registry_version",
  "project",
  "items"
 ],
 "properties": {
  "registry_version": {
   "type": "string",
   "minLength": 1
  },
  "project": {
   "type": "string",
   "minLength": 1
  },
  "items": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "version",
     "description",
     "file",
     "dependencies",
     "license",
     "source",
     "hash",
     "compatibility",
     "test_scene"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
     },
     "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
     },
     "description": {
      "type": "string",
      "minLength": 1
     },
     "file": {
      "type": "string",
      "minLength": 1
     },
     "dependencies": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "license": {
      "type": "string",
      "minLength": 1
     },
     "source": {
      "type": "string",
      "minLength": 1
     },
     "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
     },
     "compatibility": {
      "type": "string",
      "minLength": 1
     },
     "test_scene": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 },
 "$schema": "https://json-schema.org/draft/2020-12/schema"
}