{
 "title": "storyboard/shots.json",
 "type": "object",
 "required": [
  "shots",
  "shot_count"
 ],
 "properties": {
  "shot_count": {
   "type": "integer",
   "minimum": 1
  },
  "mean_shot_s": {
   "type": "number",
   "minimum": 0.5,
   "maximum": 6
  },
  "shots": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "scene",
     "start",
     "end",
     "dur",
     "beat",
     "purpose",
     "camera",
     "action",
     "audio",
     "lines"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+$"
     },
     "scene": {
      "type": "string"
     },
     "start": {
      "type": "number",
      "minimum": 0
     },
     "end": {
      "type": "number"
     },
     "dur": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "beat": {
      "type": "string",
      "minLength": 1
     },
     "purpose": {
      "type": "string",
      "minLength": 1
     },
     "camera": {
      "type": "string",
      "minLength": 1
     },
     "action": {
      "type": "string",
      "minLength": 1
     },
     "audio": {
      "type": "string",
      "minLength": 1
     },
     "lines": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^L[0-9]+$"
      }
     }
    }
   }
  }
 },
 "$schema": "https://json-schema.org/draft/2020-12/schema"
}