{
 "title": "research/claims.json",
 "type": "object",
 "required": [
  "fontes",
  "afirmacoes",
  "limitacoes"
 ],
 "properties": {
  "fontes": {
   "type": "object",
   "minProperties": 2,
   "additionalProperties": {
    "type": "object",
    "required": [
     "title",
     "url",
     "tipo",
     "acesso",
     "lido"
    ],
    "properties": {
     "url": {
      "type": "string",
      "pattern": "^https://"
     },
     "lido": {
      "type": "boolean"
     }
    }
   }
  },
  "afirmacoes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "fala",
     "afirmacao",
     "fontes",
     "confianca"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^C[0-9]+$"
     },
     "fala": {
      "type": "string",
      "minLength": 1
     },
     "afirmacao": {
      "type": "string",
      "minLength": 1
     },
     "fontes": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": "object",
       "required": [
        "fonte",
        "trecho",
        "url"
       ],
       "properties": {
        "trecho": {
         "type": "string",
         "minLength": 12
        },
        "url": {
         "type": "string",
         "pattern": "^https://"
        }
       }
      }
     },
     "confianca": {
      "enum": [
       "alta",
       "média-alta",
       "média",
       "baixa"
      ]
     }
    }
   }
  },
  "limitacoes": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  }
 },
 "$schema": "https://json-schema.org/draft/2020-12/schema"
}