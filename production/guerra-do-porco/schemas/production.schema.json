{
 "title": "production.json",
 "type": "object",
 "required": [
  "title",
  "slug",
  "language",
  "format",
  "width",
  "height",
  "fps",
  "durationSeconds",
  "visualEngine",
  "visualGeneration",
  "captions",
  "audio",
  "voice"
 ],
 "properties": {
  "title": {
   "type": "string",
   "minLength": 1
  },
  "slug": {
   "type": "string",
   "pattern": "^[a-z0-9-]+$"
  },
  "language": {
   "type": "string",
   "pattern": "^[a-z]{2}-[A-Z]{2}$"
  },
  "format": {
   "enum": [
    "short-pilot",
    "short",
    "long-form"
   ]
  },
  "width": {
   "type": "integer",
   "minimum": 270
  },
  "height": {
   "type": "integer",
   "minimum": 480
  },
  "fps": {
   "enum": [
    24,
    25,
    30,
    60
   ]
  },
  "durationSeconds": {
   "type": "number",
   "exclusiveMinimum": 0,
   "maximum": 180
  },
  "visualEngine": {
   "type": "string",
   "minLength": 1
  },
  "visualGeneration": {
   "const": "procedural-code-only"
  },
  "style_reference": {
   "type": "string",
   "minLength": 1
  },
  "captions": {
   "type": "object",
   "required": [
    "wordsPerCard",
    "font"
   ],
   "properties": {
    "keepPunctuation": {
     "type": "boolean"
    }
   }
  },
  "audio": {
   "type": "object",
   "required": [
    "sampleRate",
    "channels",
    "targetIntegratedLufs",
    "maxTruePeakDbtp"
   ],
   "properties": {
    "sampleRate": {
     "enum": [
      44100,
      48000
     ]
    },
    "channels": {
     "enum": [
      1,
      2
     ]
    },
    "targetIntegratedLufs": {
     "type": "number",
     "minimum": -24,
     "maximum": -10
    },
    "maxTruePeakDbtp": {
     "type": "number",
     "maximum": -1
    }
   }
  },
  "voice": {
   "type": "string",
   "minLength": 1
  },
  "tts": {
   "type": [
    "string",
    "null"
   ]
  }
 },
 "$schema": "https://json-schema.org/draft/2020-12/schema"
}