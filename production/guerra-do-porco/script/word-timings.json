 "lines": [
  {
   "id": "L1",
   "shot": "S1",
   "beat": "gancho",
   "text": "Um homem matou um porco, e dois países quase entraram em guerra.",
   "pause_before": 0.1,
   "start": 0.35,
   "end": 3.776,
   "dur": 3.426
  },
  {
   "id": "L2",
   "shot": "S2",
   "beat": "setup",
   "text": "O porco de um britânico invadiu a horta de um americano. Ele atirou.",
   "pause_before": 0.22,
   "start": 3.996,
   "end": 7.712,
   "dur": 3.717
  },
  {
   "id": "L3",
   "shot": "S3",
   "beat": "zombador",
   "text": "O dono exigiu cem dólares. O americano ofereceu dez.",
   "pause_before": 0.22,
   "start": 7.932,
   "end": 11.495,
   "dur": 3.563
  },
  {
   "id": "L4",
   "shot": "S4",
   "beat": "escalada",
   "text": "Vieram centenas de soldados. Depois, cinco navios de guerra.",
   "pause_before": 0.2,
   "start": 11.695,
   "end": 15.839,
   "dur": 4.144
  },
  {
   "id": "L5",
   "shot": "S5",
   "beat": "pagamento",
   "text": "Mas o almirante recusou atacar. Ninguém morreu. Só o porco.",
   "pause_before": 0.22,
   "start": 16.059,
   "end": 20.078,
   "dur": 4.018
  }
 ],
