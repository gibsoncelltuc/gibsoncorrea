  {
   "id": "L1",
   "shot": "S1",
   "beat": "gancho",
   "text": "Um homem matou um porco, e dois países quase entraram em guerra.",
   "pause_before": 0.1,
   "start": 0.35,
   "end": 3.665,
   "dur": 3.315
  },
  {
   "id": "L2",
   "shot": "S2",
   "beat": "setup",
   "text": "O porco de um britânico invadiu a horta de um americano. Ele atirou.",
   "pause_before": 0.22,
   "start": 3.885,
   "end": 7.555,
   "dur": 3.67
  },
  {
   "id": "L3",
   "shot": "S3",
   "beat": "zombador",
   "text": "O dono exigiu cem dólares. O americano ofereceu dez.",
   "pause_before": 0.22,
   "start": 7.775,
   "end": 11.35,
   "dur": 3.575
  },
  {
   "id": "L4",
   "shot": "S4",
   "beat": "escalada",
   "text": "Vieram centenas de soldados. Depois, cinco navios de guerra.",
   "pause_before": 0.2,
   "start": 11.55,
   "end": 15.505,
   "dur": 3.955
  },
  {
   "id": "L5",
   "shot": "S5",
   "beat": "pagamento",
   "text": "Mas o almirante recusou atacar. Ninguém morreu. Só o porco.",
   "pause_before": 0.22,
   "start": 15.725,
   "end": 19.515,
   "dur": 3.79
  }
 ],
