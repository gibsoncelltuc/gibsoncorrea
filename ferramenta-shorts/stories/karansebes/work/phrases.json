 "phrases": [
  {
   "text": "Em mil setecentos e oitenta e oito,",
   "s": 0.153,
   "e": 1.724
  },
  {
   "text": "o ex\u00e9rcito austr\u00edaco marchava para atacar os turcos.",
   "s": 2.05,
   "e": 4.704
  },
  {
   "text": "Eram dezenas de milhares de soldados,",
   "s": 5.562,
   "e": 7.348
  },
  {
   "text": "de v\u00e1rios pa\u00edses,",
   "s": 7.553,
   "e": 8.506
  },
  {
   "text": "falando v\u00e1rias l\u00ednguas.",
   "s": 8.785,
   "e": 9.928
  },
  {
   "text": "Numa noite,",
   "s": 10.785,
   "e": 11.369
  },
  {
   "text": "os hussardos foram na frente procurar o inimigo.",
   "s": 11.629,
   "e": 13.76
  },
  {
   "text": "N\u00e3o acharam turco nenhum.",
   "s": 14.614,
   "e": 15.857
  },
  {
   "text": "Acharam moradores vendendo aguardente.",
   "s": 16.742,
   "e": 18.665
  },
  {
   "text": "Os hussardos compraram,",
   "s": 19.523,
   "e": 20.581
  },
  {
   "text": "beberam,",
   "s": 20.797,
   "e": 21.209
  },
  {
   "text": "e a festa come\u00e7ou.",
   "s": 21.482,
   "e": 22.5
  },
  {
   "text": "A\u00ed chegou a infantaria,",
   "s": 23.374,
   "e": 24.616
  },
  {
   "text": "e queria a parte dela.",
   "s": 24.844,
   "e": 25.887
  },
  {
   "text": "A discuss\u00e3o virou empurra-empurra,",
   "s": 26.719,
   "e": 28.443
  },
  {
   "text": "e algu\u00e9m deu um tiro.",
   "s": 28.684,
   "e": 29.667
  },
  {
   "text": "Algu\u00e9m gritou:",
   "s": 30.526,
   "e": 31.282
  },
  {
   "text": "Turcos!",
   "s": 31.595,
   "e": 32.048
  },
  {
   "text": "Turcos!",
   "s": 32.928,
   "e": 33.395
  },
  {
   "text": "E o p\u00e2nico tomou o acampamento.",
   "s": 34.248,
   "e": 35.861
  },
  {
   "text": "No escuro,",
   "s": 36.709,
   "e": 37.252
  },
  {
   "text": "ningu\u00e9m entendia a l\u00edngua do vizinho.",
   "s": 37.471,
   "e": 39.158
  },
  {
   "text": "Todo mundo atirava em todo mundo,",
   "s": 40.034,
   "e": 41.572
  },
  {
   "text": "achando que eram os turcos.",
   "s": 41.799,
   "e": 43.083
  },
  {
   "text": "Chegou a ordem de usar a artilharia,",
   "s": 43.955,
   "e": 45.801
  },
  {
   "text": "e os canh\u00f5es dispararam contra o pr\u00f3prio ex\u00e9rcito.",
   "s": 46.117,
   "e": 48.338
  },
  {
   "text": "Dias depois,",
   "s": 49.186,
   "e": 49.949
  },
  {
   "text": "os turcos chegaram e encontraram o campo cheio de austr\u00edacos.",
   "s": 50.218,
   "e": 53.046
  },
  {
   "text": "Contam que foram at\u00e9 dez mil baixas,",
   "s": 53.905,
   "e": 55.847
  },
  {
   "text": "mas os historiadores discutem esse n\u00famero.",
   "s": 56.089,
   "e": 58.107
  },
  {
   "text": "Dizem que foi o maior desastre de fogo amigo da hist\u00f3ria.",
   "s": 58.953,
   "e": 61.593
  }
 ]
