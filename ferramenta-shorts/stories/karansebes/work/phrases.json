 "phrases": [
  {
   "text": "Um ex\u00e9rcito inteiro conseguiu perder uma batalha contra si mesmo.",
   "s": 0.146,
   "e": 3.223
  },
  {
   "text": "Era o ex\u00e9rcito austr\u00edaco,",
   "s": 4.086,
   "e": 5.292
  },
  {
   "text": "marchando contra os turcos,",
   "s": 5.552,
   "e": 6.815
  },
  {
   "text": "com soldados de v\u00e1rios pa\u00edses,",
   "s": 7.093,
   "e": 8.634
  },
  {
   "text": "que mal se entendiam.",
   "s": 8.885,
   "e": 9.782
  },
  {
   "text": "Numa noite,",
   "s": 10.658,
   "e": 11.242
  },
  {
   "text": "os hussardos foram na frente procurar o inimigo.",
   "s": 11.502,
   "e": 13.63
  },
  {
   "text": "N\u00e3o acharam turco nenhum.",
   "s": 14.487,
   "e": 15.73
  },
  {
   "text": "Acharam moradores vendendo aguardente.",
   "s": 16.615,
   "e": 18.538
  },
  {
   "text": "Compraram tudo,",
   "s": 19.403,
   "e": 20.215
  },
  {
   "text": "beberam,",
   "s": 20.43,
   "e": 20.868
  },
  {
   "text": "e a festa come\u00e7ou.",
   "s": 21.164,
   "e": 22.152
  },
  {
   "text": "A\u00ed chegou a infantaria,",
   "s": 23.031,
   "e": 24.238
  },
  {
   "text": "querendo a parte dela.",
   "s": 24.446,
   "e": 25.504
  },
  {
   "text": "\"N\u00e3o tem pra voc\u00eas\",",
   "s": 26.349,
   "e": 27.449
  },
  {
   "text": "disseram os hussardos.",
   "s": 27.632,
   "e": 28.757
  },
  {
   "text": "A discuss\u00e3o virou empurra-empurra,",
   "s": 29.603,
   "e": 31.327
  },
  {
   "text": "e algu\u00e9m deu um tiro.",
   "s": 31.568,
   "e": 32.551
  },
  {
   "text": "No escuro,",
   "s": 33.404,
   "e": 34.024
  },
  {
   "text": "algu\u00e9m gritou:",
   "s": 34.18,
   "e": 34.881
  },
  {
   "text": "\"Turcos!",
   "s": 35.182,
   "e": 35.61
  },
  {
   "text": "Turcos!\"",
   "s": 36.494,
   "e": 36.961
  },
  {
   "text": "E o p\u00e2nico tomou o acampamento.",
   "s": 37.814,
   "e": 39.427
  },
  {
   "text": "Acontece que ningu\u00e9m entendia a l\u00edngua do vizinho.",
   "s": 40.294,
   "e": 42.633
  },
  {
   "text": "Todo mundo atirava em todo mundo,",
   "s": 43.509,
   "e": 45.047
  },
  {
   "text": "achando que eram os turcos.",
   "s": 45.273,
   "e": 46.557
  },
  {
   "text": "Um oficial mandou usar a artilharia,",
   "s": 47.407,
   "e": 49.32
  },
  {
   "text": "e os canh\u00f5es dispararam contra o pr\u00f3prio ex\u00e9rcito.",
   "s": 49.626,
   "e": 51.91
  },
  {
   "text": "Dois dias depois,",
   "s": 52.745,
   "e": 53.742
  },
  {
   "text": "os turcos chegaram de verdade,",
   "s": 53.996,
   "e": 55.396
  },
  {
   "text": "e acharam o acampamento abandonado.",
   "s": 55.671,
   "e": 57.368
  },
  {
   "text": "Contam que foram at\u00e9 dez mil baixas,",
   "s": 58.223,
   "e": 60.152
  },
  {
   "text": "mas os historiadores duvidam desse n\u00famero.",
   "s": 60.396,
   "e": 62.413
  },
  {
   "text": "Os turcos venceram sem dar um \u00fanico tiro.",
   "s": 63.264,
   "e": 65.422
  }
 ]
