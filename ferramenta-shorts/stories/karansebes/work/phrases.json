 "phrases": [
  {
   "text": "Um ex\u00e9rcito inteiro perdeu uma batalha contra ele mesmo.",
   "s": 0.0,
   "e": 2.457
  },
  {
   "text": "E o inimigo venceu sem disparar um tiro.",
