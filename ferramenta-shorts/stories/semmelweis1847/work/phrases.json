 "phrases": [
  {
   "text": "Um m\u00e9dico pediu uma coisa simples aos colegas:",
   "s": 0.15,
   "e": 2.662
  },
  {
   "text": "lavem as m\u00e3os.",
   "s": 2.845,
   "e": 3.71
  },
  {
   "text": "E foi expulso do hospital por isso.",
   "s": 4.565,
   "e": 6.276
  },
  {
   "text": "Era mil oitocentos e quarenta e sete,",
   "s": 7.146,
   "e": 8.936
  },
  {
   "text": "no grande hospital de Viena,",
   "s": 9.181,
   "e": 10.526
  },
  {
   "text": "na \u00c1ustria.",
   "s": 10.701,
   "e": 11.217
  },
  {
   "text": "O hospital tinha duas alas de parto.",
   "s": 12.088,
   "e": 14.019
  },
  {
   "text": "Numa,",
   "s": 14.869,
   "e": 15.236
  },
  {
   "text": "as m\u00e3es eram atendidas por parteiras.",
   "s": 15.448,
   "e": 17.47
  },
  {
   "text": "Na outra,",
   "s": 18.323,
   "e": 18.807
  },
  {
   "text": "por m\u00e9dicos.",
   "s": 19.112,
   "e": 19.756
  },
  {
   "text": "E acontece que,",
   "s": 20.607,
   "e": 21.484
  },
  {
   "text": "na ala dos m\u00e9dicos,",
   "s": 21.684,
   "e": 22.692
  },
  {
   "text": "morriam muito mais m\u00e3es,",
   "s": 22.994,
   "e": 24.264
  },
  {
   "text": "de uma febre misteriosa.",
   "s": 24.467,
   "e": 25.656
  },
  {
   "text": "As mulheres imploravam de joelhos para n\u00e3o ir para a ala dos m\u00e9dicos.",
   "s": 26.527,
   "e": 29.941
  },
  {
   "text": "Um dia,",
   "s": 30.792,
   "e": 31.245
  },
  {
   "text": "o amigo dele,",
   "s": 31.48,
   "e": 32.224
  },
  {
   "text": "Kolletschka,",
   "s": 32.507,
   "e": 33.049
  },
  {
   "text": "cortou o dedo com um bisturi,",
   "s": 33.317,
   "e": 34.647
  },
  {
   "text": "examinando um corpo,",
   "s": 34.846,
   "e": 35.806
  },
  {
   "text": "e morreu da mesma febre.",
   "s": 36.159,
   "e": 37.352
  },
  {
   "text": "Semmelweis entendeu tudo:",
   "s": 38.236,
   "e": 39.588
  },
  {
   "text": "os m\u00e9dicos sa\u00edam das aut\u00f3psias e iam direto para os partos,",
   "s": 39.903,
   "e": 42.854
  },
  {
   "text": "com as m\u00e3os sujas.",
   "s": 43.109,
   "e": 44.093
  },
  {
   "text": "Ele colocou uma bacia com \u00e1gua e cloro na porta,",
   "s": 44.954,
   "e": 47.333
  },
  {
   "text": "e obrigou todo mundo a lavar as m\u00e3os antes de entrar.",
   "s": 47.592,
   "e": 50.132
  },
  {
   "text": "As mortes despencaram quase dez vezes.",
   "s": 50.945,
   "e": 53.175
  },
  {
   "text": "Centenas de m\u00e3es foram salvas.",
   "s": 54.05,
   "e": 55.786
  },
  {
   "text": "Mas os m\u00e9dicos se ofenderam.",
   "s": 56.642,
   "e": 58.102
  },
  {
   "text": "Um cavalheiro,",
   "s": 58.958,
   "e": 59.675
  },
  {
   "text": "diziam,",
   "s": 59.901,
   "e": 60.393
  },
  {
   "text": "tem as m\u00e3os limpas.",
   "s": 60.706,
   "e": 61.706
  },
  {
   "text": "Semmelweis brigou com todos,",
   "s": 62.591,
   "e": 64.102
  },
  {
   "text": "e foi mandado embora.",
   "s": 64.285,
   "e": 65.306
  },
  {
   "text": "Ele morreu em mil oitocentos e sessenta e cinco,",
   "s": 66.164,
   "e": 68.257
  },
  {
   "text": "sem ver ningu\u00e9m dar raz\u00e3o a ele.",
   "s": 68.501,
   "e": 70.101
  },
  {
   "text": "Anos depois,",
   "s": 70.958,
   "e": 71.711
  },
  {
   "text": "a ci\u00eancia provou os micr\u00f3bios.",
   "s": 71.864,
   "e": 73.514
  },
  {
   "text": "Hoje,",
   "s": 74.373,
   "e": 74.698
  },
  {
   "text": "ele \u00e9 chamado de salvador das m\u00e3es.",
   "s": 74.887,
   "e": 76.655
  }
 ]
}