 "phrases": [
  {
   "text": "Um m\u00e9dico pediu aos colegas para lavarem as m\u00e3os,",
   "s": 0.158,
   "e": 2.663
  },
  {
   "text": "e foi expulso do hospital.",
   "s": 2.957,
   "e": 4.234
  },
  {
   "text": "Era mil oitocentos e quarenta e sete,",
   "s": 5.078,
   "e": 6.868
  },
  {
   "text": "no grande hospital de Viena,",
   "s": 7.113,
   "e": 8.458
  },
  {
   "text": "na \u00c1ustria.",
   "s": 8.633,
   "e": 9.149
  },
  {
   "text": "O hospital tinha duas alas de parto:",
   "s": 10.027,
   "e": 11.845
  },
  {
   "text": "uma de parteiras e outra de m\u00e9dicos.",
   "s": 12.111,
   "e": 13.886
  },
  {
   "text": "Acontece que,",
   "s": 14.738,
   "e": 15.55
  },
  {
   "text": "na ala dos m\u00e9dicos,",
   "s": 15.723,
   "e": 16.741
  },
  {
   "text": "morriam muito mais m\u00e3es,",
   "s": 17.038,
   "e": 18.288
  },
  {
   "text": "de uma febre misteriosa.",
   "s": 18.495,
   "e": 19.7
  },
  {
   "text": "Um dia,",
   "s": 20.553,
   "e": 21.026
  },
  {
   "text": "o amigo Kolletschka se cortou com um bisturi numa aut\u00f3psia,",
   "s": 21.251,
   "e": 23.852
  },
  {
   "text": "e morreu da mesma febre.",
   "s": 24.201,
   "e": 25.393
  },
  {
   "text": "Ele entendeu:",
   "s": 26.241,
   "e": 26.871
  },
  {
   "text": "os m\u00e9dicos sa\u00edam das aut\u00f3psias e iam direto aos partos,",
   "s": 27.172,
   "e": 30.047
  },
  {
   "text": "de m\u00e3os sujas.",
   "s": 30.234,
   "e": 31.124
  },
  {
   "text": "Ele p\u00f4s uma bacia com \u00e1gua e cloro na porta,",
   "s": 31.982,
   "e": 34.248
  },
  {
   "text": "e obrigou os m\u00e9dicos a lavar as m\u00e3os antes de entrar.",
   "s": 34.569,
   "e": 37.153
  },
  {
   "text": "As mortes despencaram quase dez vezes.",
   "s": 37.955,
   "e": 40.184
  },
  {
   "text": "Mas os m\u00e9dicos se ofenderam,",
   "s": 41.041,
   "e": 42.461
  },
  {
   "text": "e Semmelweis foi mandado embora.",
   "s": 42.823,
   "e": 44.421
  },
  {
   "text": "Ele morreu em mil oitocentos e sessenta e cinco,",
   "s": 45.271,
   "e": 47.39
  },
  {
   "text": "sem ser reconhecido.",
   "s": 47.66,
   "e": 48.772
  },
  {
   "text": "Anos depois,",
   "s": 49.604,
   "e": 50.347
  },
  {
   "text": "a ci\u00eancia provou que ele estava certo.",
   "s": 50.539,
   "e": 52.396
  },
  {
   "text": "Hoje,",
   "s": 53.254,
   "e": 53.557
  },
  {
   "text": "\u00e9 chamado de salvador das m\u00e3es.",
   "s": 53.683,
   "e": 55.327
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 56.177,
   "e": 57.621
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 57.914,
   "e": 59.676
  }
 ]
}