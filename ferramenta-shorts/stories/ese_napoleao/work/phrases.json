 "phrases": [
  {
   "text": "Uma \u00fanica tarde mudou a hist\u00f3ria da Europa.",
   "s": 0.152,
   "e": 2.296
  },
  {
   "text": "E se Napole\u00e3o tivesse vencido em Waterloo?",
   "s": 3.149,
   "e": 5.299
  },
  {
   "text": "Era dezoito de junho de mil oitocentos e quinze,",
   "s": 6.153,
   "e": 8.523
  },
  {
   "text": "perto de Waterloo,",
   "s": 8.773,
   "e": 9.685
  },
  {
   "text": "na B\u00e9lgica.",
   "s": 9.914,
   "e": 10.527
  },
  {
   "text": "Napole\u00e3o tinha fugido do ex\u00edlio,",
   "s": 11.375,
   "e": 13.026
  },
  {
   "text": "reunido um ex\u00e9rcito,",
   "s": 13.294,
   "e": 14.295
  },
  {
   "text": "e voltado ao poder na Fran\u00e7a em poucos dias.",
   "s": 14.6,
   "e": 17.01
  },
  {
   "text": "Na batalha,",
   "s": 17.865,
   "e": 18.497
  },
  {
   "text": "ele enfrentou os ingleses do duque de Wellington.",
   "s": 18.666,
   "e": 20.822
  },
  {
   "text": "Canh\u00f5es dispararam o dia inteiro.",
   "s": 21.702,
   "e": 23.343
  },
  {
   "text": "Os ingleses resistiram por horas,",
   "s": 24.202,
   "e": 25.878
  },
  {
   "text": "e o combate ficou por um fio.",
   "s": 26.106,
   "e": 27.533
  },
  {
   "text": "No fim da tarde,",
   "s": 28.388,
   "e": 29.235
  },
  {
   "text": "chegou o ex\u00e9rcito prussiano para ajudar Wellington.",
   "s": 29.524,
   "e": 31.843
  },
  {
   "text": "E Napole\u00e3o foi derrotado.",
   "s": 32.714,
   "e": 34.007
  },
  {
   "text": "Ele foi mandado para Santa Helena,",
   "s": 34.869,
   "e": 36.414
  },
  {
   "text": "uma ilha perdida no oceano Atl\u00e2ntico,",
   "s": 36.715,
   "e": 38.479
  },
  {
   "text": "e morreu l\u00e1.",
   "s": 38.73,
   "e": 39.357
  },
  {
   "text": "E se ele tivesse ganhado?",
   "s": 40.218,
   "e": 41.453
  },
  {
   "text": "Muita gente imagina um imp\u00e9rio franc\u00eas dominando a Europa.",
   "s": 42.28,
   "e": 45.075
  },
  {
   "text": "Acontece que a maioria dos historiadores pensa diferente:",
   "s": 45.94,
   "e": 48.785
  },
  {
   "text": "ele provavelmente perderia mesmo assim.",
   "s": 49.075,
   "e": 50.977
  },
  {
   "text": "Ex\u00e9rcitos enormes da R\u00fassia e da \u00c1ustria j\u00e1 marchavam contra ele.",
   "s": 51.839,
   "e": 55.047
  },
  {
   "text": "Waterloo s\u00f3 apressou o fim.",
   "s": 55.901,
   "e": 57.282
  },
  {
   "text": "\u00c0s vezes,",
   "s": 58.151,
   "e": 58.779
  },
  {
   "text": "um dia famoso n\u00e3o muda o destino.",
   "s": 59.022,
   "e": 60.691
  },
  {
   "text": "S\u00f3 escolhe a data em que ele vem.",
   "s": 61.583,
   "e": 63.114
  }
 ]
}