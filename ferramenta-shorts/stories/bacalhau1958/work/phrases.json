 "phrases": [
  {
   "text": "A Isl\u00e2ndia derrotou a marinha inglesa com um cortador de rede.",
   "s": 0.159,
   "e": 2.94
  },
  {
   "text": "Entre mil novecentos e cinquenta e oito e setenta e seis,",
   "s": 3.793,
   "e": 6.229
  },
  {
   "text": "os dois pa\u00edses travaram tr\u00eas Guerras do Bacalhau.",
   "s": 6.542,
   "e": 9.028
  },
  {
   "text": "A Isl\u00e2ndia vivia da pesca,",
   "s": 9.896,
   "e": 11.213
  },
  {
   "text": "mas barcos ingleses pescavam pertinho da sua costa.",
   "s": 11.467,
   "e": 14.178
  },
  {
   "text": "Ent\u00e3o ela ampliou os limites do mar:",
   "s": 15.03,
   "e": 16.887
  },
  {
   "text": "doze milhas,",
   "s": 17.082,
   "e": 17.868
  },
  {
   "text": "cinquenta,",
   "s": 18.056,
   "e": 18.623
  },
  {
   "text": "e por fim duzentas.",
   "s": 18.844,
   "e": 19.926
  },
  {
   "text": "A Inglaterra mandou a marinha proteger os barcos de pesca.",
   "s": 20.782,
   "e": 23.57
  },
  {
   "text": "Acontece que a Isl\u00e2ndia s\u00f3 tinha barquinhos da guarda costeira,",
   "s": 24.414,
   "e": 27.405
  },
  {
   "text": "mas eles tinham cortadores de rede.",
   "s": 27.651,
   "e": 29.292
  },
  {
   "text": "Eles cortavam os cabos das redes inglesas,",
   "s": 30.146,
   "e": 32.28
  },
  {
   "text": "e os navios batiam um no outro.",
   "s": 32.533,
   "e": 34.011
  },
  {
   "text": "A Isl\u00e2ndia ainda amea\u00e7ou fechar a base da Otan no pa\u00eds.",
   "s": 34.86,
   "e": 37.73
  },
  {
   "text": "Em mil novecentos e setenta e seis,",
   "s": 38.588,
   "e": 40.167
  },
  {
   "text": "a Inglaterra cedeu,",
   "s": 40.398,
   "e": 41.373
  },
  {
   "text": "e as duzentas milhas se espalharam pelo mundo.",
   "s": 41.675,
   "e": 43.751
  },
  {
   "text": "Uma guerra inteira,",
   "s": 44.618,
   "e": 45.494
  },
  {
   "text": "por causa de um bacalhau.",
   "s": 45.745,
   "e": 46.807
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 47.659,
   "e": 49.104
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 49.396,
   "e": 51.158
  }
 ]
}