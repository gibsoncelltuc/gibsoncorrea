 "phrases": [
  {
   "text": "A Isl\u00e2ndia derrotou a marinha inglesa com um cortador de rede.",
   "s": 0.159,
   "e": 2.94
  },
  {
   "text": "Entre mil novecentos e cinquenta e oito e setenta e seis,",
   "s": 3.793,
   "e": 6.229
  },
  {
   "text": "os dois pa\u00edses travaram tr\u00eas Guerras do Bacalhau.",
   "s": 6.542,
   "e": 9.028
  },
  {
   "text": "A Isl\u00e2ndia vivia da pesca,",
   "s": 9.893,
   "e": 11.211
  },
  {
   "text": "mas barcos ingleses pescavam bacalhau pertinho da sua costa.",
   "s": 11.479,
   "e": 14.614
  },
  {
   "text": "Ent\u00e3o ela ampliou os limites do mar:",
   "s": 15.451,
   "e": 17.302
  },
  {
   "text": "doze milhas,",
   "s": 17.503,
   "e": 18.29
  },
  {
   "text": "cinquenta,",
   "s": 18.475,
   "e": 19.043
  },
  {
   "text": "e por fim duzentas.",
   "s": 19.264,
   "e": 20.346
  },
  {
   "text": "A marinha mandou fragatas para proteger os barcos de pesca.",
   "s": 21.199,
   "e": 24.046
  },
  {
   "text": "Acontece que a Isl\u00e2ndia s\u00f3 tinha barquinhos da guarda costeira,",
   "s": 24.895,
   "e": 27.883
  },
  {
   "text": "mas eles tinham cortadores de rede.",
   "s": 28.128,
   "e": 29.77
  },
  {
   "text": "Eles cortavam os cabos das redes,",
   "s": 30.616,
   "e": 32.312
  },
  {
   "text": "e os navios batiam um no outro,",
   "s": 32.556,
   "e": 33.968
  },
  {
   "text": "de prop\u00f3sito.",
   "s": 34.17,
   "e": 34.868
  },
  {
   "text": "A Isl\u00e2ndia amea\u00e7ou fechar a base da Otan e rompeu rela\u00e7\u00f5es com a Inglaterra.",
   "s": 35.722,
   "e": 39.451
  },
  {
   "text": "Em mil novecentos e setenta e seis,",
   "s": 40.302,
   "e": 41.928
  },
  {
   "text": "a Inglaterra cedeu,",
   "s": 42.158,
   "e": 43.155
  },
  {
   "text": "e a zona de duzentas milhas se espalhou pelo mundo.",
   "s": 43.465,
   "e": 45.821
  },
  {
   "text": "Uma guerra inteira,",
   "s": 46.684,
   "e": 47.56
  },
  {
   "text": "por causa de um bacalhau.",
   "s": 47.796,
   "e": 48.873
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 49.725,
   "e": 51.167
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 51.462,
   "e": 53.224
  }
 ]
}