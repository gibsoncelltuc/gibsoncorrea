 "phrases": [
  {
   "text": "A Isl\u00e2ndia derrotou a marinha inglesa usando um cortador de rede.",
   "s": 0.151,
   "e": 2.815
  },
  {
   "text": "E o motivo da briga era o bacalhau.",
   "s": 3.604,
   "e": 5.082
