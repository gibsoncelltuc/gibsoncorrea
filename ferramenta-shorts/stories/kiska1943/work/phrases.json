 "phrases": [
  {
   "text": "Trinta e quatro mil soldados invadiram uma ilha onde n\u00e3o havia inimigo nenhum.",
   "s": 0.158,
   "e": 3.724
  },
  {
   "text": "Foi em agosto de mil novecentos e quarenta e tr\u00eas,",
   "s": 4.646,
   "e": 6.926
  },
  {
   "text": "em Kiska,",
   "s": 7.101,
   "e": 7.564
  },
  {
   "text": "no Alasca,",
   "s": 7.814,
   "e": 8.368
  },
  {
   "text": "ocupada pelos japoneses.",
   "s": 8.588,
   "e": 9.99
  },
  {
   "text": "Foram mais de trinta e quatro mil soldados americanos e canadenses,",
   "s": 10.906,
   "e": 14.082
  },
  {
   "text": "com navios,",
   "s": 14.326,
   "e": 14.918
  },
  {
   "text": "avi\u00f5es e tanques.",
   "s": 15.2,
   "e": 16.238
  },
  {
   "text": "Antes do desembarque,",
   "s": 17.083,
   "e": 18.094
  },
  {
   "text": "bombardearam Kiska durante semanas.",
   "s": 18.343,
   "e": 20.199
  },
  {
   "text": "No meio do nevoeiro,",
   "s": 21.05,
   "e": 22.041
  },
  {
   "text": "os soldados desceram em sil\u00eancio,",
   "s": 22.34,
   "e": 23.927
  },
  {
   "text": "prontos para um combate duro.",
   "s": 24.317,
   "e": 25.693
  },
  {
   "text": "Mas teve um problema:",
   "s": 26.533,
   "e": 27.575
  },
  {
   "text": "os japoneses j\u00e1 tinham ido embora.",
   "s": 27.896,
   "e": 29.618
  },
  {
   "text": "Duas semanas antes,",
   "s": 30.454,
   "e": 31.622
  },
  {
   "text": "uma frota tinha evacuado cerca de cinco mil homens,",
   "s": 31.879,
   "e": 34.532
  },
  {
   "text": "escondida na neblina.",
   "s": 34.742,
   "e": 35.737
  },
  {
   "text": "Sem inimigo \u00e0 vista,",
   "s": 36.625,
   "e": 37.678
  },
  {
   "text": "os Aliados come\u00e7aram a atirar uns nos outros,",
   "s": 37.932,
   "e": 40.13
  },
  {
   "text": "no escuro e na neblina.",
   "s": 40.341,
   "e": 41.334
  },
  {
   "text": "No fim,",
   "s": 42.189,
   "e": 42.595
  },
  {
   "text": "s\u00f3 acharam na ilha alguns cachorros abandonados.",
   "s": 42.83,
   "e": 45.05
  },
  {
   "text": "Uma das maiores invas\u00f5es do Pac\u00edfico Norte tomou uma ilha completamente vazia.",
   "s": 45.907,
   "e": 49.882
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 50.711,
   "e": 52.156
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 52.453,
   "e": 54.21
  }
 ]
