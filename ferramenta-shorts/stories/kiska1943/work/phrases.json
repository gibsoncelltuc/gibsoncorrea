 "phrases": [
  {
   "text": "Trinta e quatro mil soldados desembarcaram numa ilha sem nenhum inimigo.",
   "s": 0.154,
   "e": 3.2
  },
  {
   "text": "E mesmo assim,",
   "s": 3.981,
   "e": 4.693
  },
  {
   "text": "houve mortos nessa invas\u00e3o.",
   "s": 4.923,
   "e": 6.127
  },
  {
   "text": "Em 1943, a ilha de Kiska,",
   "s": 6.926,
   "e": 8.369
  },
  {
   "text": "no Alasca,",
   "s": 8.563,
   "e": 9.311
  },
  {
   "text": "estava com os japoneses.",
   "s": 9.546,
   "e": 11.315
  },
  {
   "text": "Americanos e canadenses chegaram com navios,",
   "s": 12.111,
   "e": 14.129
  },
  {
   "text": "avi\u00f5es e tanques.",
   "s": 14.39,
   "e": 15.331
  },
  {
   "text": "Bombardearam a ilha durante semanas inteiras.",
   "s": 16.111,
   "e": 18.206
  },
  {
   "text": "Acontece que os japoneses j\u00e1 tinham ido embora.",
   "s": 19.004,
   "e": 21.142
  },
  {
   "text": "Sa\u00edram escondidos na neblina,",
   "s": 21.911,
   "e": 23.356
  },
  {
   "text": "semanas antes.",
   "s": 23.545,
   "e": 24.456
  },
  {
   "text": "No nevoeiro,",
   "s": 25.238,
   "e": 25.823
  },
  {
   "text": "os Aliados atiraram uns nos outros.",
   "s": 26.084,
   "e": 27.755
  },
  {
   "text": "Mais de vinte soldados morreram,",
   "s": 28.534,
   "e": 29.968
  },
  {
   "text": "e um navio bateu numa mina.",
   "s": 30.22,
   "e": 31.374
  },
  {
   "text": "Na ilha inteira,",
   "s": 32.145,
   "e": 32.858
  },
  {
   "text": "s\u00f3 acharam alguns cachorros abandonados.",
   "s": 33.031,
   "e": 34.806
  },
  {
   "text": "Uma invas\u00e3o contra cachorros.",
   "s": 35.589,
   "e": 36.954
  },
  {
   "text": "E foi assim que...",
