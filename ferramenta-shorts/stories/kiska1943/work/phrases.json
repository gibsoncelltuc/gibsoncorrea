 "phrases": [
  {
   "text": "Trinta e quatro mil soldados invadiram uma ilha onde n\u00e3o havia inimigo nenhum.",
   "s": 0.158,
   "e": 3.724
  },
  {
   "text": "Era agosto de mil novecentos e quarenta e tr\u00eas.",
   "s": 4.578,
   "e": 6.824
  },
  {
   "text": "A ilha de Kiska,",
   "s": 7.686,
   "e": 8.522
  },
  {
   "text": "no Alasca,",
   "s": 8.767,
   "e": 9.348
  },
  {
   "text": "estava ocupada pelos japoneses.",
   "s": 9.569,
   "e": 11.17
  },
  {
   "text": "Americanos e canadenses chegaram com navios,",
   "s": 12.031,
   "e": 14.233
  },
  {
   "text": "avi\u00f5es e tanques.",
   "s": 14.522,
   "e": 15.543
  },
  {
   "text": "Antes do desembarque,",
   "s": 16.392,
   "e": 17.403
  },
  {
   "text": "bombardearam Kiska durante semanas.",
   "s": 17.652,
   "e": 19.507
  },
  {
   "text": "No meio do nevoeiro,",
   "s": 20.359,
   "e": 21.35
  },
  {
   "text": "os soldados desceram em sil\u00eancio,",
   "s": 21.649,
   "e": 23.236
  },
  {
   "text": "prontos para um combate duro.",
   "s": 23.625,
   "e": 25.002
  },
  {
   "text": "Mas teve um problema:",
   "s": 25.842,
   "e": 26.884
  },
  {
   "text": "os japoneses j\u00e1 tinham ido embora.",
   "s": 27.204,
   "e": 28.927
  },
  {
   "text": "Eles procuraram o inimigo por dias,",
   "s": 29.76,
   "e": 31.531
  },
  {
   "text": "em trincheiras vazias.",
   "s": 31.693,
   "e": 32.893
  },
  {
   "text": "Semanas antes,",
   "s": 33.785,
   "e": 34.752
  },
  {
   "text": "navios japoneses levaram cinco mil homens embora em menos de uma hora,",
   "s": 34.959,
   "e": 38.411
  },
  {
   "text": "escondidos na neblina.",
   "s": 38.611,
   "e": 39.727
  },
  {
   "text": "Sem inimigo \u00e0 vista,",
   "s": 40.613,
   "e": 41.662
  },
  {
   "text": "os Aliados come\u00e7aram a atirar uns nos outros,",
   "s": 41.92,
   "e": 44.117
  },
  {
   "text": "no escuro e na neblina.",
   "s": 44.329,
   "e": 45.323
  },
  {
   "text": "Mais de vinte soldados morreram nesses tiros,",
   "s": 46.192,
   "e": 48.373
  },
  {
   "text": "e um navio americano ainda bateu numa mina.",
   "s": 48.609,
   "e": 50.642
  },
  {
   "text": "No fim,",
   "s": 51.506,
   "e": 51.913
  },
  {
   "text": "s\u00f3 acharam na ilha alguns cachorros abandonados.",
   "s": 52.147,
   "e": 54.368
  },
  {
   "text": "Uma das maiores invas\u00f5es do Pac\u00edfico Norte tomou uma ilha completamente vazia.",
   "s": 55.225,
   "e": 59.199
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 60.029,
   "e": 61.471
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 61.766,
   "e": 63.528
  }
 ]
