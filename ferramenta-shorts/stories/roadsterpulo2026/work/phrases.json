 "phrases": [
  {
   "text": "Elon Musk prometeu um carro que voa.",
   "s": 0.155,
   "e": 2.143
  },
  {
   "text": "E,",
   "s": 2.989,
   "e": 3.126
  },
  {
   "text": "diante de convidados,",
   "s": 3.392,
   "e": 4.494
  },
  {
   "text": "o carro dele saiu do ch\u00e3o.",
   "s": 4.756,
   "e": 6.167
  },
  {
   "text": "Foi em outubro de dois mil e vinte e seis,",
   "s": 7.078,
   "e": 8.728
  },
  {
   "text": "\u00e0 noite,",
   "s": 8.916,
   "e": 9.41
  },
  {
   "text": "numa base de testes da SpaceX em McGregor,",
   "s": 9.668,
   "e": 12.18
  },
  {
   "text": "no Texas.",
   "s": 12.402,
   "e": 13.06
  },
  {
   "text": "O novo Roadster da Tesla tinha sido prometido em dois mil e dezessete.",
   "s": 13.914,
   "e": 17.29
  },
  {
   "text": "Foram nove anos de atraso.",
   "s": 18.176,
   "e": 19.5
  },
  {
   "text": "O segredo s\u00e3o propulsores da SpaceX escondidos no carro:",
   "s": 20.339,
   "e": 23.376
  },
  {
   "text": "dez bocais que sopram ar comprimido para baixo.",
   "s": 23.671,
   "e": 26.05
  },
  {
   "text": "E um sistema de suc\u00e7\u00e3o gruda o carro na pista,",
   "s": 26.915,
   "e": 29.18
  },
  {
   "text": "como uma ventosa,",
   "s": 29.472,
   "e": 30.354
  },
  {
   "text": "at\u00e9 de cabe\u00e7a para baixo.",
   "s": 30.536,
   "e": 31.895
  },
  {
   "text": "Diante dos convidados,",
   "s": 32.754,
   "e": 33.973
  },
  {
   "text": "o carro acelerou,",
   "s": 34.212,
   "e": 34.995
  },
  {
   "text": "subiu uma rampa curva gigante e ficou de cabe\u00e7a para baixo.",
   "s": 35.252,
   "e": 38.191
  },
  {
   "text": "Ent\u00e3o se soltou,",
   "s": 39.05,
   "e": 39.932
  },
  {
   "text": "voou girando no ar e pousou numa nuvem de fuma\u00e7a branca.",
   "s": 40.224,
   "e": 42.946
  },
  {
   "text": "Depois decolou de outra rampa e voou,",
   "s": 43.8,
   "e": 45.711
  },
  {
   "text": "nos propulsores,",
   "s": 45.928,
   "e": 46.805
  },
  {
   "text": "por cima de uma fileira de ve\u00edculos parados.",
   "s": 47.103,
   "e": 49.265
  },
  {
   "text": "Segundo a Tesla,",
   "s": 50.152,
   "e": 51.019
  },
  {
   "text": "ele vai de zero a quase cem por hora em menos de um segundo.",
   "s": 51.186,
   "e": 53.823
  },
  {
   "text": "Mas especialistas lembraram:",
   "s": 54.696,
   "e": 56.128
  },
  {
   "text": "aquilo durou poucos segundos,",
   "s": 56.38,
   "e": 57.78
  },
  {
   "text": "n\u00e3o foi um voo de verdade.",
   "s": 58.036,
   "e": 59.379
  },
  {
   "text": "O v\u00eddeo correu o mundo.",
   "s": 60.232,
   "e": 61.309
  },
  {
   "text": "Metade ficou impressionada,",
   "s": 62.176,
   "e": 63.639
  },
  {
   "text": "a outra metade desconfiada.",
   "s": 63.813,
   "e": 65.328
  },
  {
   "text": "Carro voador ou carro que pula?",
   "s": 66.176,
   "e": 67.694
  },
  {
   "text": "Voc\u00ea decide.",
   "s": 68.543,
   "e": 69.371
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 70.233,
   "e": 71.678
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 71.97,
   "e": 73.732
  }
 ]
