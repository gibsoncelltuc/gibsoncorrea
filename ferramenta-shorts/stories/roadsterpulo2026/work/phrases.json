 "phrases": [
  {
   "text": "Um carro saiu do ch\u00e3o e voou na frente de convidados.",
   "s": 0.164,
   "e": 2.939
  },
  {
   "text": "E n\u00e3o era efeito especial.",
   "s": 3.8,
   "e": 5.103
  },
  {
   "text": "Era a nova inven\u00e7\u00e3o de Elon Musk,",
   "s": 5.983,
   "e": 7.585
  },
  {
   "text": "numa base da SpaceX,",
   "s": 7.861,
   "e": 9.168
  },
  {
   "text": "no Texas,",
   "s": 9.35,
   "e": 10.027
  },
  {
   "text": "em outubro de dois mil e vinte e seis.",
   "s": 10.197,
   "e": 11.821
  },
  {
   "text": "O primeiro truque:",
   "s": 12.679,
   "e": 13.404
  },
  {
   "text": "um sistema de suc\u00e7\u00e3o gruda o carro na pista,",
   "s": 13.689,
   "e": 15.833
  },
  {
   "text": "como uma ventosa.",
   "s": 16.115,
   "e": 16.971
  },
  {
   "text": "Com ele,",
   "s": 17.841,
   "e": 18.263
  },
  {
   "text": "o carro acelerou,",
   "s": 18.54,
   "e": 19.349
  },
  {
   "text": "subiu uma rampa curva gigante e ficou de cabe\u00e7a para baixo.",
   "s": 19.559,
   "e": 22.529
  },
  {
   "text": "Ent\u00e3o se soltou,",
   "s": 23.392,
   "e": 24.274
  },
  {
   "text": "voou girando no ar e pousou numa nuvem de fuma\u00e7a branca.",
   "s": 24.566,
   "e": 27.287
  },
  {
   "text": "O segundo truque:",
   "s": 28.141,
   "e": 28.929
  },
  {
   "text": "dez bocais escondidos,",
   "s": 29.189,
   "e": 30.496
  },
  {
   "text": "que sopram ar comprimido para baixo.",
   "s": 30.707,
   "e": 32.421
  },
  {
   "text": "Foi assim que ele decolou e voou,",
   "s": 33.343,
   "e": 34.79
  },
  {
   "text": "nos propulsores,",
   "s": 35.041,
   "e": 35.927
  },
  {
   "text": "por cima de ve\u00edculos parados.",
   "s": 36.162,
   "e": 37.68
  },
  {
   "text": "E,",
   "s": 38.535,
   "e": 38.695
  },
  {
   "text": "segundo a Tesla,",
   "s": 38.933,
   "e": 39.769
  },
  {
   "text": "ele vai de zero a quase cem por hora em menos de um segundo.",
   "s": 39.907,
   "e": 42.558
  },
  {
   "text": "Mas especialistas lembraram:",
   "s": 43.409,
   "e": 44.854
  },
  {
   "text": "o voo durou poucos segundos.",
   "s": 45.187,
   "e": 46.649
  },
  {
   "text": "Ainda n\u00e3o \u00e9 um carro voador de verdade.",
   "s": 47.487,
   "e": 49.443
  },
  {
   "text": "Carro voador ou carro que pula?",
   "s": 50.308,
   "e": 51.827
  },
  {
   "text": "Voc\u00ea decide.",
   "s": 52.676,
   "e": 53.505
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 54.366,
   "e": 55.811
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 56.103,
   "e": 57.865
  }
 ]
