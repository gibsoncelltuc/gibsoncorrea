 "phrases": [
  {
   "text": "Em mil oitocentos e doze,",
   "s": 0.16,
   "e": 1.384
  },
  {
   "text": "uma batalha estranha aconteceu na costa de Portugal.",
   "s": 1.657,
   "e": 3.991
  },
  {
   "text": "Os navios ingleses chegaram na praia,",
   "s": 4.865,
   "e": 6.566
  },
  {
   "text": "e o batalh\u00e3o desembarcou na areia.",
   "s": 6.873,
   "e": 8.384
  },
  {
   "text": "Mas o batalh\u00e3o franc\u00eas do general Dupont j\u00e1 estava esperando atr\u00e1s das dunas.",
   "s": 9.232,
   "e": 13.008
  },
  {
   "text": "Come\u00e7ou a batalha.",
   "s": 13.873,
   "e": 14.838
  },
  {
   "text": "Os dois ex\u00e9rcitos avan\u00e7aram um contra o outro,",
   "s": 15.683,
   "e": 17.925
  },
  {
   "text": "com tiros,",
   "s": 18.262,
   "e": 18.839
  },
  {
   "text": "canh\u00f5es e explos\u00f5es.",
   "s": 19.069,
   "e": 20.2
  },
  {
   "text": "Uma bomba explodiu no meio da praia,",
   "s": 21.064,
   "e": 22.762
  },
  {
   "text": "e soldados voaram pelos ares.",
   "s": 23.052,
   "e": 24.645
  },
  {
   "text": "No fim da tarde,",
   "s": 25.494,
   "e": 26.357
  },
  {
   "text": "os dois generais decidiram conversar no meio do campo.",
   "s": 26.646,
   "e": 29.24
  },
  {
   "text": "Depois de horas negociando,",
   "s": 30.076,
   "e": 31.494
  },
  {
   "text": "eles apertaram as m\u00e3os e fizeram as pazes.",
   "s": 31.745,
   "e": 33.836
  },
  {
   "text": "Os soldados comemoraram,",
   "s": 34.701,
   "e": 35.902
  },
  {
   "text": "e cada ex\u00e9rcito voltou para casa.",
   "s": 36.198,
   "e": 37.865
  }
 ]
