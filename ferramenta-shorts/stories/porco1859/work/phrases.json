 "phrases": [
  {
   "text": "Dois pa\u00edses quase foram \u00e0 guerra por causa de um porco.",
   "s": 0.146,
   "e": 2.634
  },
  {
   "text": "E a \u00fanica baixa da guerra foi ele.",
   "s": 3.398,
   "e": 4.973
  },
  {
   "text": "A ilha de San Juan n\u00e3o tinha dono definido.",
   "s": 5.769,
   "e": 7.761
  },
  {
   "text": "Um fazendeiro americano viu um porco comendo suas batatas.",
   "s": 8.532,
   "e": 11.226
  },
  {
   "text": "Ele atirou.",
   "s": 12.006,
   "e": 12.538
  },
  {
   "text": "O porco era de um vizinho ingl\u00eas.",
   "s": 13.339,
   "e": 14.827
  },
  {
   "text": "Ofereceu dez d\u00f3lares.",
   "s": 15.611,
   "e": 16.9
  },
  {
   "text": "O dono exigiu cem.",
   "s": 17.676,
   "e": 18.63
  },
  {
   "text": "Os americanos mandaram soldados para a ilha.",
   "s": 19.419,
   "e": 21.445
  },
  {
   "text": "A Inglaterra respondeu com navios de guerra.",
   "s": 22.229,
   "e": 24.247
  },
  {
   "text": "Acontece que o almirante ingl\u00eas se recusou a atacar.",
   "s": 25.031,
   "e": 27.444
  },
  {
   "text": "Os soldados acabaram fazendo festas juntos.",
   "s": 28.178,
   "e": 30.301
  },
  {
   "text": "Ningu\u00e9m deu um tiro,",
   "s": 31.083,
   "e": 31.992
  },
  {
   "text": "s\u00f3 no porco.",
   "s": 32.206,
   "e": 32.862
  },
  {
   "text": "E foi assim que...",
   "s": 33.642,
   "e": 34.385
  }
