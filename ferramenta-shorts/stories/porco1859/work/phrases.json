 "phrases": [
  {
   "text": "Dois pa\u00edses quase entraram em guerra por causa de um porco.",
   "s": 0.149,
   "e": 2.892
  },
  {
   "text": "Era uma ilha pequena,",
   "s": 3.726,
   "e": 4.691
  },
  {
   "text": "entre os Estados Unidos e o Canad\u00e1,",
   "s": 4.894,
   "e": 6.502
  },
  {
   "text": "e ningu\u00e9m sabia de quem ela era.",
   "s": 6.761,
   "e": 8.387
  },
  {
   "text": "Um dia,",
   "s": 9.228,
   "e": 9.699
  },
  {
   "text": "um fazendeiro americano encontrou um porco comendo as batatas da horta dele.",
   "s": 9.93,
   "e": 13.474
  },
  {
   "text": "Ele pegou a espingarda,",
   "s": 14.333,
   "e": 15.564
  },
  {
   "text": "e atirou.",
   "s": 15.78,
   "e": 16.247
  },
  {
   "text": "O porco era de um vizinho ingl\u00eas.",
   "s": 17.11,
   "e": 18.735
  },
  {
   "text": "O fazendeiro foi at\u00e9 a casa do vizinho,",
   "s": 19.584,
   "e": 21.488
  },
  {
   "text": "com as notas na m\u00e3o.",
   "s": 21.807,
   "e": 22.777
  },
  {
   "text": "\"Eu pago dez d\u00f3lares\",",
   "s": 23.645,
   "e": 24.887
  },
  {
   "text": "ofereceu ele.",
   "s": 25.165,
   "e": 25.879
  },
  {
   "text": "\"Dez?",
   "s": 26.737,
   "e": 27.113
  },
  {
   "text": "Ele vale cem!\",",
   "s": 27.97,
   "e": 28.773
  },
  {
   "text": "gritou o dono,",
   "s": 29.014,
   "e": 29.731
  },
  {
   "text": "empurrando o dinheiro de volta.",
   "s": 29.971,
   "e": 31.363
  },
  {
   "text": "Ningu\u00e9m cedeu.",
   "s": 32.212,
   "e": 33.018
  },
  {
   "text": "Os ingleses amea\u00e7aram prender o fazendeiro.",
   "s": 33.888,
   "e": 36.039
  },
  {
   "text": "Ent\u00e3o os Estados Unidos mandaram soldados para a ilha.",
   "s": 36.88,
   "e": 39.652
  },
  {
   "text": "Acontece que a Inglaterra respondeu com navios de guerra.",
   "s": 40.503,
   "e": 43.352
  },
  {
   "text": "Logo eram centenas de soldados e dezenas de canh\u00f5es,",
   "s": 44.208,
   "e": 46.895
  },
  {
   "text": "apontados uns para os outros.",
   "s": 47.159,
   "e": 48.573
  },
  {
   "text": "O almirante ingl\u00eas recebeu a ordem de atacar.",
   "s": 49.432,
   "e": 51.691
  },
  {
   "text": "\"N\u00e3o vou come\u00e7ar uma guerra por causa de um porco\",",
   "s": 52.517,
   "e": 54.826
  },
  {
   "text": "respondeu ele.",
   "s": 55.194,
   "e": 55.913
  },
  {
   "text": "Os soldados passaram meses trocando insultos,",
   "s": 56.77,
   "e": 59.035
  },
  {
   "text": "e depois,",
   "s": 59.211,
   "e": 59.751
  },
  {
   "text": "festas.",
   "s": 60.028,
   "e": 60.519
  },
  {
   "text": "Ningu\u00e9m deu um tiro.",
   "s": 61.375,
   "e": 62.422
  },
  {
   "text": "Treze anos depois,",
   "s": 63.265,
   "e": 64.317
  },
  {
   "text": "um \u00e1rbitro decidiu que a ilha era americana.",
   "s": 64.539,
   "e": 66.67
  },
  {
   "text": "A \u00fanica baixa da guerra foi o porco.",
   "s": 67.517,
   "e": 69.288
  }
 ]
