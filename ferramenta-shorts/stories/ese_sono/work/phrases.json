 "phrases": [
  {
   "text": "Voc\u00ea passa um ter\u00e7o da vida dormindo.",
   "s": 0.151,
   "e": 2.009
  },
  {
   "text": "E se ningu\u00e9m precisasse dormir nunca mais?",
   "s": 2.875,
   "e": 5.12
  },
  {
   "text": "Numa vida de setenta e cinco anos,",
   "s": 5.973,
   "e": 7.532
  },
  {
   "text": "isso daria uns vinte e cinco anos a mais,",
   "s": 7.72,
   "e": 9.679
  },
  {
   "text": "acordado.",
   "s": 9.867,
   "e": 10.406
  },
  {
   "text": "As cidades funcionariam vinte e quatro horas por dia.",
   "s": 11.263,
   "e": 13.713
  },
  {
   "text": "Escola,",
   "s": 14.555,
   "e": 15.043
  },
  {
   "text": "trabalho e festa a qualquer hora.",
   "s": 15.245,
   "e": 16.752
  },
  {
   "text": "Daria tempo de aprender tr\u00eas l\u00ednguas,",
   "s": 17.62,
   "e": 19.573
  },
  {
   "text": "um instrumento,",
   "s": 19.842,
   "e": 20.506
  },
  {
   "text": "e ver todas as s\u00e9ries.",
   "s": 20.872,
   "e": 22.14
  },
  {
   "text": "Mas ser\u00e1 que o corpo aguenta?",
   "s": 22.988,
   "e": 24.333
  },
  {
   "text": "Em mil novecentos e sessenta e quatro,",
   "s": 25.182,
   "e": 26.736
  },
  {
   "text": "um estudante americano tentou descobrir.",
   "s": 27.013,
   "e": 29.031
  },
  {
   "text": "Randy Gardner,",
   "s": 29.888,
   "e": 30.649
  },
  {
   "text": "de dezessete anos,",
   "s": 30.881,
   "e": 31.89
  },
  {
   "text": "ficou acordado por onze dias seguidos,",
   "s": 32.153,
   "e": 34.156
  },
  {
   "text": "num experimento de escola.",
   "s": 34.377,
   "e": 35.537
  },
  {
   "text": "Acontece que,",
   "s": 36.41,
   "e": 37.227
  },
  {
   "text": "no fim,",
   "s": 37.438,
   "e": 37.85
  },
  {
   "text": "ele j\u00e1 esquecia palavras,",
   "s": 38.041,
   "e": 39.259
  },
  {
   "text": "ficava confuso e via coisas que n\u00e3o existiam.",
   "s": 39.483,
   "e": 41.699
  },
  {
   "text": "Hoje sabemos por qu\u00ea:",
   "s": 42.581,
   "e": 43.673
  },
  {
   "text": "dormindo,",
   "s": 43.915,
   "e": 44.433
  },
  {
   "text": "o c\u00e9rebro faz uma faxina e lava o que acumulou durante o dia.",
   "s": 44.697,
   "e": 47.556
  },
  {
   "text": "Para n\u00e3o dormir,",
   "s": 48.404,
   "e": 49.174
  },
  {
   "text": "precisar\u00edamos de outro c\u00e9rebro.",
   "s": 49.403,
   "e": 50.957
  },
  {
   "text": "Nenhum caf\u00e9 resolve isso.",
   "s": 51.811,
   "e": 53.26
  },
  {
   "text": "Ou seja:",
   "s": 54.117,
   "e": 54.626
  },
  {
   "text": "sem dormir,",
   "s": 54.874,
   "e": 55.528
  },
  {
   "text": "a humanidade n\u00e3o ganharia tempo.",
   "s": 55.72,
   "e": 57.296
  },
  {
   "text": "Ganharia sono.",
   "s": 58.13,
   "e": 58.964
  },
  {
   "text": "Ent\u00e3o,",
   "s": 59.813,
   "e": 60.238
  },
  {
   "text": "se voc\u00ea est\u00e1 vendo isso de madrugada,",
   "s": 60.536,
   "e": 62.305
  },
  {
   "text": "a ci\u00eancia manda um recado:",
   "s": 62.537,
   "e": 63.944
  },
  {
   "text": "vai dormir.",
   "s": 64.166,
   "e": 64.741
  }
 ]
