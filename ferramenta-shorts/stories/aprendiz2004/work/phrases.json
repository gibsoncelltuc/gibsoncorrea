 "phrases": [
  {
   "text": "Duas palavras transformaram um empres\u00e1rio de Nova York numa estrela mundial:",
   "s": 0.155,
   "e": 3.774
  },
  {
   "text": "voc\u00ea est\u00e1 demitido.",
   "s": 4.127,
   "e": 5.111
  },
  {
   "text": "Em dois mil e quatro,",
   "s": 5.948,
   "e": 6.747
  },
  {
   "text": "estreou nos Estados Unidos o programa O Aprendiz.",
   "s": 7.005,
   "e": 9.38
  },
  {
   "text": "Dezesseis candidatos disputavam um emprego numa empresa de Donald Trump.",
   "s": 10.237,
   "e": 13.966
  },
  {
   "text": "Toda semana,",
