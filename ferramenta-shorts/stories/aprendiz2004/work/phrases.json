 "phrases": [
  {
   "text": "O que ningu\u00e9m lembra:",
   "s": 0.158,
   "e": 1.066
  },
  {
   "text": "duas palavras deixaram Trump famoso no mundo todo.",
   "s": 1.353,
   "e": 3.929
  },
  {
   "text": "E n\u00e3o foi na pol\u00edtica.",
   "s": 4.782,
   "e": 5.804
  },
  {
   "text": "Foi num programa de TV.",
   "s": 6.696,
   "e": 7.834
  },
  {
   "text": "Em 2004,",
   "s": 8.671,
   "e": 9.47
  },
  {
   "text": "estreou nos Estados Unidos o programa O Aprendiz.",
   "s": 9.728,
   "e": 12.103
  },
  {
   "text": "Dezesseis candidatos disputavam um emprego na empresa de Trump.",
   "s": 12.961,
   "e": 16.192
  },
  {
   "text": "Toda semana,",
   "s": 17.053,
   "e": 17.702
  },
  {
   "text": "a equipe perdedora ia para a sala de reuni\u00e3o.",
   "s": 17.951,
   "e": 20.233
  },
  {
   "text": "E algu\u00e9m ouvia,",
   "s": 21.095,
   "e": 21.826
  },
  {
   "text": "com o dedo na cara:",
   "s": 22.096,
   "e": 23.014
  },
  {
   "text": "voc\u00ea est\u00e1 demitido.",
   "s": 23.274,
   "e": 24.325
  },
  {
   "text": "A final teve cerca de vinte e oito milh\u00f5es de espectadores.",
   "s": 25.164,
   "e": 27.966
  },
  {
   "text": "No Brasil,",
   "s": 28.824,
   "e": 29.402
  },
  {
   "text": "O Aprendiz estreou no mesmo ano,",
   "s": 29.68,
   "e": 31.277
  },
  {
   "text": "com Roberto Justus.",
   "s": 31.596,
   "e": 32.74
  },
  {
   "text": "Trump apresentou o programa por mais de dez anos.",
   "s": 33.604,
   "e": 36.063
  },
  {
   "text": "Um programa de emprego,",
   "s": 36.918,
   "e": 37.988
  },
  {
   "text": "famoso por demitir.",
   "s": 38.302,
   "e": 39.394
  },
  {
   "text": "Tudo por causa de duas palavras.",
