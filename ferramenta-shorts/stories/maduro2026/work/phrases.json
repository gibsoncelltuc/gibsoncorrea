 "phrases": [
  {
   "text": "Numa madrugada de janeiro de dois mil e vinte e seis,",
   "s": 0.141,
   "e": 2.517
  },
  {
   "text": "Trump autorizou uma das opera\u00e7\u00f5es militares mais ousadas dos \u00faltimos anos.",
   "s": 2.747,
   "e": 6.643
  },
  {
   "text": "O alvo estava em Caracas,",
   "s": 7.495,
   "e": 8.725
  },
  {
   "text": "a capital da Venezuela.",
   "s": 8.887,
   "e": 10.12
  },
  {
   "text": "Era o presidente venezuelano Nicol\u00e1s Maduro,",
   "s": 10.959,
   "e": 13.056
  },
  {
   "text": "acusado pela justi\u00e7a americana de narcoterrorismo.",
   "s": 13.302,
   "e": 15.894
  },
  {
   "text": "Durante meses,",
   "s": 16.742,
   "e": 17.566
  },
  {
   "text": "a intelig\u00eancia americana estudou cada passo dele,",
   "s": 17.787,
   "e": 20.202
  },
  {
   "text": "em segredo.",
   "s": 20.424,
   "e": 20.994
  },
  {
   "text": "\u00c0s duas da manh\u00e3,",
   "s": 21.834,
   "e": 22.747
  },
  {
   "text": "helic\u00f3pteros levaram os soldados da For\u00e7a Delta direto para o complexo onde Maduro estava.",
   "s": 22.985,
   "e": 27.297
  },
  {
   "text": "Ao mesmo tempo, ataques a\u00e9reos desligaram as defesas antia\u00e9reas do pa\u00eds.",
   "s": 28.164,
   "e": 32.136
  },
  {
   "text": "Acontece que,",
   "s": 33.003,
   "e": 33.828
  },
  {
   "text": "em menos de tr\u00eas horas,",
   "s": 34.032,
   "e": 35.176
  },
  {
   "text": "Maduro foi capturado e levado para fora da Venezuela.",
   "s": 35.422,
   "e": 38.221
  },
  {
   "text": "Trump acompanhou tudo de longe,",
   "s": 39.08,
   "e": 40.653
  },
  {
   "text": "na Fl\u00f3rida,",
   "s": 40.885,
   "e": 41.521
  },
  {
   "text": "ao lado do diretor da CIA e do secret\u00e1rio de Estado.",
   "s": 41.752,
   "e": 44.332
  },
  {
   "text": "Maduro foi levado de avi\u00e3o para Nova York,",
   "s": 45.19,
   "e": 47.387
  },
  {
   "text": "onde responde a um processo na justi\u00e7a.",
   "s": 47.605,
   "e": 49.55
  },
  {
   "text": "Nenhum militar americano morreu.",
   "s": 50.395,
   "e": 51.964
  },
  {
   "text": "A not\u00edcia parou o mundo,",
   "s": 52.807,
   "e": 53.985
  },
  {
   "text": "e dividiu opini\u00f5es entre pa\u00edses.",
   "s": 54.206,
   "e": 55.904
  },
  {
   "text": "A opera\u00e7\u00e3o ganhou um nome que resume tudo:",
   "s": 56.754,
   "e": 58.847
  },
  {
   "text": "Resolu\u00e7\u00e3o Absoluta.",
   "s": 59.122,
   "e": 60.235
  }
 ]
