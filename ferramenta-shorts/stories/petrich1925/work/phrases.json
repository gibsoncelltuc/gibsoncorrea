 "phrases": [
  {
   "text": "Outubro de mil novecentos e vinte e cinco,",
   "s": 0.16,
   "e": 2.029
  },
  {
   "text": "na fronteira entre a Gr\u00e9cia e a Bulg\u00e1ria.",
   "s": 2.288,
   "e": 4.064
  },
  {
   "text": "Conta a hist\u00f3ria que um soldado grego estava de guarda,",
   "s": 4.916,
   "e": 7.211
  },
  {
   "text": "e o cachorro dele fugiu para o outro lado da fronteira.",
   "s": 7.5,
   "e": 9.989
  },
  {
   "text": "O soldado correu atr\u00e1s do cachorro,",
   "s": 10.847,
   "e": 12.61
  },
  {
   "text": "e atravessou a fronteira.",
   "s": 12.909,
   "e": 14.091
  },
  {
   "text": "Uma sentinela b\u00falgara viu o soldado,",
   "s": 14.93,
   "e": 16.84
  },
  {
   "text": "e atirou.",
   "s": 17.11,
   "e": 17.553
  },
  {
   "text": "A Gr\u00e9cia ficou furiosa,",
   "s": 18.413,
   "e": 19.693
  },
  {
   "text": "e deu um ultimato.",
   "s": 19.98,
   "e": 20.864
  },
  {
   "text": "Poucos dias depois,",
   "s": 21.742,
   "e": 22.782
  },
  {
   "text": "o ex\u00e9rcito grego invadiu a Bulg\u00e1ria e ocupou a regi\u00e3o de Petrich.",
   "s": 23.003,
   "e": 26.261
  },
  {
   "text": "A Bulg\u00e1ria apelou para a Liga das Na\u00e7\u00f5es,",
   "s": 27.114,
   "e": 28.962
  },
  {
   "text": "o antecessor da ONU.",
   "s": 29.193,
   "e": 30.226
  },
  {
   "text": "A Liga mandou a Gr\u00e9cia parar,",
   "s": 31.102,
   "e": 32.437
  },
  {
   "text": "retirar as tropas e pagar uma indeniza\u00e7\u00e3o.",
   "s": 32.651,
   "e": 34.682
  },
  {
   "text": "A Gr\u00e9cia obedeceu,",
   "s": 35.53,
   "e": 36.49
  },
  {
   "text": "e ningu\u00e9m sabe o que aconteceu com o cachorro.",
   "s": 36.789,
   "e": 38.798
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 39.633,
   "e": 41.077
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 41.37,
   "e": 43.132
  }
 ]
}