 "phrases": [
  {
   "text": "Em setembro de dois mil e vinte e um,",
   "s": 0.161,
   "e": 1.612
  },
  {
   "text": "o presidente de El Salvador,",
   "s": 1.872,
   "e": 3.123
  },
  {
   "text": "Nayib Bukele,",
   "s": 3.326,
   "e": 4.215
  },
  {
   "text": "trocou a descri\u00e7\u00e3o do pr\u00f3prio perfil,",
   "s": 4.478,
   "e": 6.192
  },
  {
   "text": "uma coisa bem pequena.",
   "s": 6.433,
   "e": 7.609
  },
  {
   "text": "Poucos dias antes,",
   "s": 8.488,
   "e": 9.515
  },
  {
   "text": "milhares de pessoas tinham protestado nas ruas de San Salvador.",
   "s": 9.716,
   "e": 12.811
  },
  {
   "text": "Primeiro,",
   "s": 13.642,
   "e": 14.005
  },
  {
   "text": "ele escreveu s\u00f3 uma palavra no perfil:",
   "s": 14.251,
   "e": 16.09
  },
  {
   "text": "ditador.",
   "s": 16.389,
   "e": 16.847
  },
  {
   "text": "Alguns dias depois,",
   "s": 17.686,
   "e": 18.745
  },
  {
   "text": "trocou por uma frase mais longa:",
   "s": 18.939,
   "e": 20.469
  },
  {
   "text": "o ditador mais legal do mundo.",
   "s": 20.785,
   "e": 22.16
  },
  {
   "text": "Acontece que a not\u00edcia se espalhou pelo mundo.",
   "s": 23.028,
   "e": 25.216
  },
  {
   "text": "Jornais de v\u00e1rios pa\u00edses publicaram a frase,",
   "s": 26.07,
   "e": 28.303
  },
  {
   "text": "e muita gente ficou discutindo se era piada ou n\u00e3o.",
   "s": 28.643,
   "e": 31.059
  },
  {
   "text": "V\u00e1rios comentaristas leram aquilo como uma ironia,",
   "s": 31.91,
   "e": 34.234
  },
  {
   "text": "feita para os cr\u00edticos dele.",
   "s": 34.49,
   "e": 35.7
  },
  {
   "text": "Anos depois,",
   "s": 36.562,
   "e": 37.312
  },
  {
   "text": "no dia da elei\u00e7\u00e3o de dois mil e vinte e quatro,",
   "s": 37.477,
   "e": 39.351
  },
  {
   "text": "o perfil dele dizia:",
   "s": 39.651,
   "e": 40.756
  },
  {
   "text": "rei fil\u00f3sofo.",
   "s": 41.048,
   "e": 41.75
  },
  {
   "text": "Ali\u00e1s,",
   "s": 42.603,
   "e": 43.124
  },
  {
   "text": "esse perfil muda bastante:",
   "s": 43.329,
   "e": 44.594
  },
  {
   "text": "Bukele costuma trocar o nome e a descri\u00e7\u00e3o.",
   "s": 44.869,
   "e": 47.047
  },
  {
   "text": "Conclus\u00e3o:",
   "s": 47.922,
   "e": 48.443
  },
  {
   "text": "se a sua biografia estiver chata,",
   "s": 48.68,
   "e": 50.285
  },
  {
   "text": "lembre que d\u00e1 para trocar em dez segundos.",
   "s": 50.565,
   "e": 52.504
  }
 ]
