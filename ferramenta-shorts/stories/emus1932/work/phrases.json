 "phrases": [
  {
   "text": "A Austr\u00e1lia declarou guerra a um bando de p\u00e1ssaros.",
   "s": 0.156,
   "e": 2.633
  },
  {
   "text": "E perdeu.",
   "s": 3.486,
   "e": 4.06
  },
  {
   "text": "Vinte mil emus estavam devorando as planta\u00e7\u00f5es de trigo no oeste do pa\u00eds,",
   "s": 4.93,
   "e": 8.619
  },
  {
   "text": "e os fazendeiros foram pedir socorro ao governo.",
   "s": 8.906,
   "e": 11.16
  },
  {
   "text": "\"Mande o ex\u00e9rcito\",",
   "s": 12.005,
   "e": 12.92
  },
  {
   "text": "pediram eles.",
   "s": 13.164,
   "e": 13.953
  },
  {
   "text": "E o ministro mandou.",
   "s": 14.809,
   "e": 15.769
  },
  {
   "text": "Soldados,",
   "s": 16.665,
   "e": 17.317
  },
  {
   "text": "duas metralhadoras,",
   "s": 17.603,
   "e": 18.759
  },
  {
   "text": "e dez mil balas.",
   "s": 18.989,
   "e": 20.043
  },
  {
   "text": "Contra emus.",
   "s": 20.909,
   "e": 21.625
  },
  {
   "text": "Acontece que emu \u00e9 r\u00e1pido,",
   "s": 22.492,
   "e": 23.927
  },
  {
   "text": "e n\u00e3o fica parado.",
   "s": 24.169,
   "e": 25.133
  },
  {
   "text": "Quando os soldados miravam,",
   "s": 26.003,
   "e": 27.174
  },
  {
   "text": "os p\u00e1ssaros se espalhavam,",
   "s": 27.428,
   "e": 28.607
  },
  {
   "text": "e sumiam correndo.",
   "s": 28.867,
   "e": 29.776
  },
  {
   "text": "Um atirador montou a metralhadora num caminh\u00e3o.",
   "s": 30.621,
   "e": 32.815
  },
  {
   "text": "Mas o caminh\u00e3o pulava tanto,",
   "s": 33.686,
   "e": 35.053
  },
  {
   "text": "que ele n\u00e3o acertou nenhum.",
   "s": 35.344,
   "e": 36.455
  },
  {
   "text": "Depois de uma semana,",
   "s": 37.322,
   "e": 38.411
  },
  {
   "text": "milhares de balas gastas,",
   "s": 38.61,
   "e": 40.009
  },
  {
   "text": "e os emus quase sem um arranh\u00e3o.",
   "s": 40.237,
   "e": 41.797
  },
  {
   "text": "A tropa bateu em retirada.",
   "s": 42.652,
   "e": 44.042
  },
  {
   "text": "A imprensa gargalhou,",
   "s": 44.864,
   "e": 45.948
  },
  {
   "text": "e o comandante admitiu:",
   "s": 46.274,
   "e": 47.401
  },
  {
   "text": "\"Eles aguentam bala como tanques.\"",
   "s": 47.682,
   "e": 49.231
  },
  {
   "text": "O ex\u00e9rcito tentou de novo,",
   "s": 50.081,
   "e": 51.491
  },
  {
   "text": "abateu algumas centenas,",
   "s": 51.742,
   "e": 53.062
  },
  {
   "text": "e os emus continuaram voltando.",
   "s": 53.299,
   "e": 54.765
  },
  {
   "text": "No fim,",
   "s": 55.62,
   "e": 56.018
  },
  {
   "text": "o governo desistiu da guerra,",
   "s": 56.301,
   "e": 57.738
  },
  {
   "text": "e passou a pagar recompensa aos fazendeiros por cada emu abatido.",
   "s": 58.098,
   "e": 61.377
  },
  {
   "text": "Humanos,",
   "s": 62.231,
   "e": 62.766
  },
  {
   "text": "zero.",
   "s": 63.008,
   "e": 63.381
  },
  {
   "text": "Emus,",
   "s": 64.223,
   "e": 64.722
  },
  {
   "text": "um.",
   "s": 65.026,
   "e": 65.194
  }
 ]
