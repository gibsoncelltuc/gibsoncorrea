 "phrases": [
  {
   "text": "Um ex\u00e9rcito perdeu uma guerra contra p\u00e1ssaros.",
   "s": 0.143,
   "e": 2.231
  },
  {
   "text": "E o placar final virou piada no mundo inteiro.",
   "s": 3.017,
   "e": 5.072
  },
  {
   "text": "Em 1932,",
   "s": 5.856,
   "e": 7.217
  },
  {
   "text": "vinte mil emus tomaram as lavouras da Austr\u00e1lia.",
   "s": 7.419,
   "e": 9.602
  },
  {
   "text": "Os agricultores pediram ajuda,",
   "s": 10.393,
   "e": 11.778
  },
  {
   "text": "e o governo mandou soldados.",
   "s": 12.049,
   "e": 13.447
  },
  {
   "text": "O major Meredith levou duas metralhadoras e dez mil balas.",
   "s": 14.229,
   "e": 17.216
  },
  {
   "text": "Acontece que os emus se espalharam,",
   "s": 18.009,
   "e": 19.504
  },
  {
   "text": "e as balas s\u00f3 acertavam poeira.",
   "s": 19.809,
   "e": 21.341
  },
  {
   "text": "Uma metralhadora num caminh\u00e3o sacudia tanto que ningu\u00e9m acertava.",
   "s": 22.119,
   "e": 24.987
  },
  {
   "text": "O major comparou os emus a tanques.",
   "s": 25.778,
   "e": 27.499
  },
  {
   "text": "A imprensa riu.",
   "s": 28.282,
   "e": 29.053
  },
  {
   "text": "Seis dias,",
   "s": 29.86,
   "e": 30.509
  },
  {
   "text": "milhares de balas,",
   "s": 30.7,
   "e": 31.584
  },
  {
   "text": "poucos emus abatidos.",
   "s": 31.812,
   "e": 32.859
  },
  {
   "text": "Ex\u00e9rcito zero,",
   "s": 33.643,
