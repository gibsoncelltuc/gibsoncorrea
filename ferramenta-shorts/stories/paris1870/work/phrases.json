   "e": 14.625
  },
  {
   "text": "os roedores,",
   "s": 14.912,
   "e": 15.628
  },
  {
   "text": "que viraram um prato chique.",
   "s": 15.849,
   "e": 17.136
  },
  {
   "text": "Quando acabou tudo,",
   "s": 18.007,
   "e": 18.858
  },
  {
