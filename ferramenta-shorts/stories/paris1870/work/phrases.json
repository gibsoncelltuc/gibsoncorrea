 "phrases": [
  {
   "text": "Paris j\u00e1 serviu elefante no jantar.",
   "s": 0.173,
   "e": 2.039
  },
  {
   "text": "Era mil oitocentos e setenta.",
   "s": 2.848,
   "e": 4.43
  },
  {
   "text": "A Pr\u00fassia cercou a cidade,",
   "s": 5.283,
   "e": 6.599
  },
  {
   "text": "e a comida acabou.",
   "s": 6.854,
   "e": 7.681
  },
  {
   "text": "Primeiro,",
   "s": 8.54,
   "e": 8.938
  },
  {
   "text": "os parisienses comeram os cavalos.",
   "s": 9.181,
   "e": 11.027
  },
  {
   "text": "Depois,",
   "s": 11.885,
   "e": 12.396
  },
  {
   "text": "os cachorros e os gatos.",
   "s": 12.718,
   "e": 14.006
  },
  {
   "text": "Depois,",
   "s": 14.864,
   "e": 15.397
  },
  {
   "text": "os roedores,",
   "s": 15.687,
   "e": 16.399
  },
  {
   "text": "que viraram um prato chique.",
   "s": 16.622,
   "e": 17.909
  },
  {
   "text": "Quando acabou tudo,",
   "s": 18.78,
   "e": 19.631
  },
  {
   "text": "olharam para o zool\u00f3gico da cidade.",
   "s": 19.86,
   "e": 21.549
  },
  {
   "text": "O a\u00e7ougueiro comprou dois elefantes,",
   "s": 22.406,
   "e": 24.247
  },
  {
   "text": "Castor e P\u00f3lux,",
   "s": 24.469,
   "e": 25.465
  },
  {
   "text": "e vendeu a carne em peda\u00e7os.",
   "s": 25.716,
   "e": 27.217
  },
  {
   "text": "No Natal,",
   "s": 28.069,
   "e": 28.612
  },
  {
   "text": "o restaurante Voisin serviu consom\u00ea de elefante,",
   "s": 28.927,
   "e": 31.433
  },
  {
   "text": "ensopado de canguru e pernil de lobo.",
   "s": 31.679,
   "e": 33.597
  },
  {
   "text": "Acontece que carne de elefante custava uma fortuna.",
   "s": 34.461,
   "e": 37.088
  },
  {
   "text": "S\u00f3 os ricos comiam.",
   "s": 37.97,
   "e": 38.999
  },
  {
   "text": "Enquanto isso,",
   "s": 39.897,
   "e": 40.579
  },
  {
   "text": "o povo fazia fila no frio,",
   "s": 40.862,
   "e": 42.275
  },
  {
   "text": "com comida racionada.",
   "s": 42.617,
   "e": 43.697
  },
  {
   "text": "Para mandar not\u00edcias,",
   "s": 44.552,
   "e": 45.6
  },
  {
   "text": "usavam bal\u00f5es e pombos-correio.",
   "s": 45.793,
   "e": 47.365
  },
  {
   "text": "Em janeiro de mil oitocentos e setenta e um,",
   "s": 48.218,
   "e": 50.196
  },
  {
   "text": "Paris se rendeu.",
   "s": 50.461,
   "e": 51.303
  },
  {
   "text": "De barriga vazia.",
   "s": 52.165,
   "e": 53.185
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 54.016,
   "e": 55.46
  },
  {
