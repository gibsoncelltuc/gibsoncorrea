 "phrases": [
  {
   "text": "Em mil oitocentos e setenta,",
   "s": 0.156,
   "e": 1.659
  },
  {
   "text": "a Pr\u00fassia cercou Paris.",
   "s": 1.826,
   "e": 3.062
  },
  {
   "text": "Ningu\u00e9m entrava,",
   "s": 3.902,
   "e": 4.75
  },
  {
   "text": "ningu\u00e9m sa\u00eda,",
   "s": 4.962,
   "e": 5.804
  },
  {
   "text": "e a comida acabou.",
   "s": 6.039,
   "e": 6.895
  },
  {
   "text": "Primeiro,",
   "s": 7.767,
   "e": 8.165
  },
  {
   "text": "os parisienses comeram os cavalos.",
