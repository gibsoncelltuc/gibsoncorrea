 "phrases": [
  {
   "text": "Paris j\u00e1 serviu elefante no jantar.",
   "s": 0.173,
   "e": 2.039
  },
  {
   "text": "Era mil oitocentos e setenta.",
   "s": 2.848,
   "e": 4.43
  },
  {
   "text": "A Pr\u00fassia cercou a cidade,",
   "s": 5.291,
   "e": 6.571
  },
  {
   "text": "ningu\u00e9m entrava,",
   "s": 6.786,
   "e": 7.625
  },
  {
   "text": "ningu\u00e9m sa\u00eda,",
   "s": 7.801,
   "e": 8.623
  },
  {
   "text": "e a comida acabou.",
   "s": 8.853,
   "e": 9.699
  },
  {
   "text": "Primeiro,",
   "s": 10.562,
   "e": 10.96
  },
  {
   "text": "os parisienses comeram os cavalos.",
   "s": 11.203,
   "e": 13.056
  },
  {
   "text": "Depois,",
   "s": 13.908,
   "e": 14.418
  },
  {
   "text": "os cachorros e os gatos.",
   "s": 14.74,
   "e": 16.029
  },
  {
   "text": "Depois,",
   "s": 16.887,
   "e": 17.419
  },
  {
   "text": "os roedores,",
   "s": 17.708,
   "e": 18.418
  },
  {
   "text": "que viraram um prato chique.",
   "s": 18.644,
   "e": 19.931
  },
  {
   "text": "Quando acabou tudo,",
   "s": 20.803,
   "e": 21.654
  },
  {
   "text": "olharam para o zool\u00f3gico da cidade.",
   "s": 21.883,
   "e": 23.572
  },
  {
   "text": "O a\u00e7ougueiro comprou dois elefantes,",
   "s": 24.429,
   "e": 26.271
  },
  {
   "text": "Castor e P\u00f3lux,",
   "s": 26.491,
   "e": 27.49
  },
  {
   "text": "e vendeu a carne em peda\u00e7os.",
   "s": 27.739,
   "e": 29.24
  },
  {
   "text": "No Natal,",
   "s": 30.091,
   "e": 30.635
  },
  {
   "text": "o restaurante Voisin serviu consom\u00ea de elefante,",
   "s": 30.95,
   "e": 33.456
  },
  {
   "text": "ensopado de canguru e pernil de lobo.",
   "s": 33.701,
   "e": 35.62
  },
  {
   "text": "Para mandar not\u00edcias,",
   "s": 36.483,
   "e": 37.508
  },
  {
   "text": "os parisienses usavam bal\u00f5es e pombos-correio.",
   "s": 37.693,
   "e": 40.036
  },
  {
   "text": "Um ministro chegou a fugir da cidade num bal\u00e3o,",
   "s": 40.883,
   "e": 43.172
  },
  {
   "text": "por cima das tropas inimigas.",
   "s": 43.519,
   "e": 45.015
  },
  {
   "text": "O cerco durou mais de quatro meses,",
   "s": 45.868,
   "e": 47.809
  },
  {
   "text": "em pleno inverno.",
   "s": 47.996,
   "e": 48.823
  },
  {
   "text": "O cerco acabou em janeiro de mil oitocentos e setenta e um,",
   "s": 49.686,
   "e": 52.404
  },
  {
   "text": "e Paris se rendeu,",
   "s": 52.773,
   "e": 53.693
  },
  {
   "text": "de barriga vazia.",
   "s": 53.935,
   "e": 54.888
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 55.711,
   "e": 57.156
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
