  },
  {
   "text": "Castor e P\u00f3lux,",
   "s": 23.696,
   "e": 24.693
  },
  {
   "text": "e vendeu a carne em peda\u00e7os.",
   "s": 24.944,
   "e": 26.438
  },
  {
   "text": "No Natal,",
   "s": 27.298,
   "e": 27.833
  },
  {
   "text": "um restaurante famoso serviu consom\u00ea de elefante,",
   "s": 28.087,
   "e": 30.645
  },
  {
   "text": "dromed\u00e1rio assado e ensopado de canguru.",
   "s": 30.884,
   "e": 32.845
  },
  {
   "text": "Tinha at\u00e9 gato com roedores,",
   "s": 33.709,
   "e": 35.119
  },
  {
   "text": "e pernil de lobo.",
   "s": 35.357,
   "e": 36.175
  },
  {
   "text": "Para mandar not\u00edcias,",
   "s": 37.04,
   "e": 38.064
  },
  {
