 "phrases": [
  {
   "text": "Uma das inven\u00e7\u00f5es mais usadas do mundo nasceu de um passeio com o cachorro.",
   "s": 0.152,
   "e": 3.799
  },
  {
   "text": "Em mil novecentos e quarenta e um,",
   "s": 4.646,
   "e": 6.06
  },
  {
   "text": "na Su\u00ed\u00e7a,",
   "s": 6.325,
   "e": 6.938
  },
  {
   "text": "o engenheiro George de Mestral voltou de uma caminhada com o seu cachorro.",
   "s": 7.184,
   "e": 10.527
  },
  {
   "text": "O pelo do cachorro e a cal\u00e7a dele estavam cheios de carrapichos.",
   "s": 11.402,
   "e": 14.576
  },
  {
   "text": "Curioso,",
   "s": 15.44,
   "e": 15.954
  },
  {
   "text": "ele levou um carrapicho para casa e olhou no microsc\u00f3pio.",
   "s": 16.221,
   "e": 18.766
  },
  {
   "text": "Acontece que cada espinho tinha um ganchinho na ponta,",
   "s": 19.641,
   "e": 22.049
  },
  {
   "text": "que agarrava nas voltinhas do tecido.",
   "s": 22.328,
   "e": 24.048
  },
  {
   "text": "Ele pensou:",
   "s": 24.872,
   "e": 25.525
  },
  {
   "text": "e se uma fita tiver ganchinhos,",
   "s": 25.893,
   "e": 27.466
  },
  {
   "text": "e a outra,",
   "s": 27.665,
   "e": 28.148
  },
  {
   "text": "voltinhas?",
   "s": 28.441,
   "e": 29.152
  },
  {
   "text": "Os tecel\u00f5es riram da ideia.",
   "s": 30.0,
   "e": 31.479
  },
  {
   "text": "Levou quase dez anos de tentativas at\u00e9 acertar o material.",
   "s": 32.33,
   "e": 35.524
  },
  {
   "text": "O segredo foi o n\u00e1ilon.",
   "s": 36.38,
   "e": 37.548
  },
  {
   "text": "E o nome juntou velours,",
   "s": 38.404,
   "e": 39.714
  },
  {
   "text": "veludo,",
   "s": 39.961,
   "e": 40.403
  },
  {
   "text": "e crochet,",
   "s": 40.709,
   "e": 41.29
  },
  {
   "text": "gancho.",
   "s": 41.471,
   "e": 41.838
  },
  {
   "text": "At\u00e9 que astronautas passaram a usar velcro no espa\u00e7o,",
   "s": 42.691,
   "e": 45.359
  },
  {
   "text": "e o mundo inteiro quis.",
   "s": 45.662,
   "e": 46.787
  },
  {
   "text": "Hoje ele est\u00e1 em t\u00eanis,",
   "s": 47.658,
   "e": 48.728
  },
  {
   "text": "mochilas e roupas.",
   "s": 48.961,
   "e": 49.967
  },
  {
   "text": "Gra\u00e7as a um cachorro cheio de carrapichos.",
   "s": 50.822,
   "e": 52.933
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 53.789,
   "e": 55.233
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 55.53,
   "e": 57.288
  }
 ]
