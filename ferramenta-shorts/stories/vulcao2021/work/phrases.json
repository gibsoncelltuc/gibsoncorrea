 "phrases": [
  {
   "text": "O presidente de El Salvador resolveu fabricar dinheiro digital com a energia de um vulc\u00e3o.",
   "s": 0.158,
   "e": 4.356
  },
  {
   "text": "El Salvador \u00e9 um pa\u00eds pequeno da Am\u00e9rica Central,",
