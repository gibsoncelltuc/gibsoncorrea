 "phrases": [
  {
   "text": "Um homem apostou cinquenta milh\u00f5es de d\u00f3lares numa conversa no Twitter.",
   "s": 0.154,
   "e": 3.579
  },
  {
   "text": "Em dois mil e dezessete,",
   "s": 4.422,
   "e": 5.529
  },
  {
   "text": "Elon Musk prometeu baterias gigantes para a Austr\u00e1lia do Sul em cem dias,",
