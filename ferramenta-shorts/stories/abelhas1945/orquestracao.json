  },
  {
   "cena": "b3",
   "frase": "Depois pintou pontinhos coloridos nas costas das abelhas, para saber quem era quem.",
   "classe": "simples",
   "sujeito": "personagem",
   "briefing": {},
   "acoes_faltando": [],
