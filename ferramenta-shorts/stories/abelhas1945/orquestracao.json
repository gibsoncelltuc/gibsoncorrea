  },
  {
   "cena": "b2",
   "frase": "Ele construiu uma colmeia com vidro para ver tudo lá dentro, e colocou pratinhos com água e açúcar no jardim.",
   "classe": "chave",
   "sujeito": "personagem",
   "briefing": {
