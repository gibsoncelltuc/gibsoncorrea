   "sujeito": "personagem",
   "briefing": {},
   "acoes_faltando": [],
   "cenario": "loc_campo"
  },
  {
   "cena": "b5",
   "frase": "Se a comida estava perto, ela dava voltinhas. Se estava longe, fazia um oito, rebolando no meio.",
