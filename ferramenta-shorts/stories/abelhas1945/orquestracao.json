  {
   "cena": "b1",
   "frase": "Karl von Frisch nasceu na Áustria, e passou a vida inteira estudando abelhas.",
   "classe": "simples",
   "sujeito": "personagem",
   "briefing": {},
   "acoes_faltando": [],
