 "phrases": [
  {
   "text": "Um menino de nove anos foi o primeiro vacinado contra a raiva.",
   "s": 0.0,
   "e": 2.63
  },
  {
   "text": "E quem aplicou a vacina nem era m\u00e9dico.",
   "s": 3.008,
   "e": 4.876
  },
  {
   "text": "Em 1885,",
   "s": 5.248,
   "e": 6.704
  },
  {
   "text": "Louis Pasteur estudava micr\u00f3bios na Fran\u00e7a.",
   "s": 6.951,
   "e": 8.872
  },
  {
   "text": "Mordida de animal com raiva quase sempre matava.",
   "s": 9.251,
   "e": 11.642
  },
  {
   "text": "A vacina dele s\u00f3 tinha sido testada em animais.",
   "s": 12.021,
   "e": 14.361
  },
  {
   "text": "Um dia,",
   "s": 14.732,
   "e": 15.163
  },
  {
   "text": "chegou o menino Joseph,",
   "s": 15.374,
   "e": 16.483
  },
  {
   "text": "mordido por um cachorro.",
   "s": 16.687,
   "e": 17.692
  },
  {
   "text": "Pasteur tinha medo,",
   "s": 18.071,
   "e": 18.89
  },
  {
   "text": "mas decidiu tentar.",
   "s": 19.09,
   "e": 19.984
  },
  {
   "text": "Acontece que,",
   "s": 20.337,
   "e": 21.063
  },
  {
   "text": "depois de dez dias de inje\u00e7\u00f5es,",
   "s": 21.264,
   "e": 22.767
  },
  {
   "text": "o menino n\u00e3o adoeceu.",
   "s": 22.97,
   "e": 23.94
  },
  {
   "text": "Joseph sobreviveu,",
   "s": 24.316,
   "e": 25.284
  },
  {
   "text": "e a not\u00edcia correu o mundo.",
   "s": 25.553,
   "e": 26.703
  },
  {
   "text": "Um qu\u00edmico arriscou tudo.",
   "s": 27.08,
   "e": 28.266
  },
  {
   "text": "E foi assim que...",
