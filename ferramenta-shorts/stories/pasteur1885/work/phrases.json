 "phrases": [
  {
   "text": "Um menino de nove anos foi o primeiro a receber a vacina contra a raiva.",
   "s": 0.147,
   "e": 3.303
  },
  {
   "text": "Era mil oitocentos e oitenta e cinco,",
   "s": 4.163,
   "e": 5.875
  },
  {
   "text": "na Fran\u00e7a,",
   "s": 6.109,
   "e": 6.702
  },
  {
   "text": "e Louis Pasteur j\u00e1 era famoso por estudar micr\u00f3bios.",
   "s": 6.97,
   "e": 9.681
  },
  {
   "text": "Na \u00e9poca,",
   "s": 10.527,
   "e": 11.12
  },
  {
   "text": "quem era mordido por um animal com raiva quase nunca se salvava.",
   "s": 11.334,
   "e": 14.374
  },
  {
   "text": "Pasteur tinha criado uma vacina e testado s\u00f3 em animais,",
   "s": 15.244,
   "e": 17.976
  },
  {
   "text": "nunca em uma pessoa.",
   "s": 18.198,
   "e": 19.211
  },
  {
   "text": "Um dia,",
   "s": 20.073,
   "e": 20.551
  },
  {
   "text": "uma m\u00e3e chegou \u00e0 porta dele com o filho Joseph,",
   "s": 20.686,
   "e": 22.97
  },
  {
   "text": "mordido por um cachorro com raiva.",
   "s": 23.247,
   "e": 24.829
  },
  {
   "text": "Pasteur n\u00e3o era m\u00e9dico e tinha medo,",
   "s": 25.688,
   "e": 27.395
  },
  {
   "text": "mas decidiu tentar.",
   "s": 27.62,
   "e": 28.619
  },
  {
   "text": "Acontece que,",
   "s": 29.422,
   "e": 30.259
  },
  {
   "text": "durante dez dias,",
   "s": 30.482,
   "e": 31.539
  },
  {
   "text": "ele aplicou inje\u00e7\u00f5es,",
   "s": 31.727,
   "e": 32.765
  },
  {
   "text": "e o menino nunca ficou doente.",
   "s": 33.0,
   "e": 34.514
  },
  {
   "text": "Joseph sobreviveu,",
   "s": 35.35,
   "e": 36.408
  },
  {
   "text": "e a not\u00edcia correu o mundo.",
   "s": 36.701,
   "e": 37.956
  },
  {
   "text": "Anos depois,",
   "s": 38.807,
   "e": 39.534
  },
  {
   "text": "ele virou o guarda do instituto de Pasteur,",
   "s": 39.8,
   "e": 41.686
  },
  {
   "text": "e cuidou do lugar at\u00e9 o fim da vida.",
   "s": 42.026,
   "e": 43.799
  },
  {
   "text": "Hoje o Instituto Pasteur ainda leva o nome dele,",
   "s": 44.654,
   "e": 46.867
  },
  {
   "text": "e a vacina salva vidas no mundo inteiro.",
   "s": 47.123,
   "e": 49.078
  },
  {
   "text": "No fim,",
   "s": 49.929,
   "e": 50.345
  },
  {
   "text": "uma picada salvou mais que mil discursos.",
   "s": 50.635,
   "e": 52.923
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 53.779,
   "e": 55.224
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 55.517,
   "e": 57.278
  }
 ]
