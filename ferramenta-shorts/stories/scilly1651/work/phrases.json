 "phrases": [
  {
   "text": "Uma ilha min\u00fascula ficou 335 anos em guerra com a Holanda,",
   "s": 0.145,
   "e": 3.86
  },
  {
   "text": "e ningu\u00e9m deu um tiro.",
   "s": 4.146,
   "e": 5.112
  },
  {
   "text": "Tudo come\u00e7ou em mil seiscentos e cinquenta e um,",
   "s": 5.976,
   "e": 8.111
  },
  {
   "text": "nas ilhas Scilly,",
   "s": 8.339,
   "e": 9.157
  },
  {
   "text": "perto da Inglaterra.",
   "s": 9.409,
   "e": 10.303
  },
  {
   "text": "Piratas das ilhas atacavam navios holandeses,",
   "s": 11.17,
   "e": 13.535
  },
  {
   "text": "e a Holanda ficou furiosa.",
   "s": 13.832,
   "e": 15.178
  },
  {
   "text": "A Holanda mandou navios de guerra e exigiu o dinheiro de volta.",
   "s": 16.029,
   "e": 19.119
  },
  {
   "text": "Dizem que,",
   "s": 19.959,
   "e": 20.561
  },
  {
   "text": "como ningu\u00e9m pagou,",
   "s": 20.799,
   "e": 21.684
  },
  {
   "text": "o almirante holand\u00eas declarou guerra \u00e0s ilhas.",
   "s": 22.0,
   "e": 24.133
  },
  {
   "text": "Acontece que os ingleses assumiram as ilhas pouco depois,",
   "s": 25.006,
   "e": 27.878
  },
  {
   "text": "e ningu\u00e9m se lembrou de fazer a paz.",
   "s": 28.101,
   "e": 29.828
  },
  {
   "text": "A guerra seguiu esquecida por mais de trezentos anos.",
   "s": 30.67,
   "e": 33.352
  },
  {
   "text": "As ilhas seguiram a vida normal,",
   "s": 34.219,
   "e": 35.848
  },
  {
   "text": "sem soldados e sem nenhum navio holand\u00eas por perto.",
   "s": 36.144,
   "e": 38.626
  },
  {
   "text": "Em mil novecentos e oitenta e cinco,",
   "s": 39.494,
   "e": 41.059
  },
  {
   "text": "um historiador perguntou se a guerra ainda valia.",
   "s": 41.338,
   "e": 43.6
  },
  {
   "text": "No ano seguinte,",
   "s": 44.427,
   "e": 45.233
  },
  {
   "text": "o embaixador holand\u00eas foi at\u00e9 as ilhas.",
   "s": 45.508,
   "e": 47.466
  },
  {
   "text": "Os dois assinaram a paz,",
   "s": 48.325,
   "e": 49.626
  },
  {
   "text": "e a guerra de 335 anos acabou.",
   "s": 49.848,
   "e": 52.153
  },
  {
   "text": "A guerra mais longa e mais calma da hist\u00f3ria.",
   "s": 53.007,
   "e": 55.113
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 55.959,
   "e": 57.404
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 57.696,
   "e": 59.458
  }
 ]
}