 "phrases": [
  {
   "text": "Voc\u00ea acha que guerra precisa de tiro?",
   "s": 0.157,
   "e": 1.953
  },
  {
   "text": "Esta durou 335 anos sem nenhum.",
   "s": 2.8,
   "e": 5.315
  },
  {
   "text": "E o jeito que ela acabou \u00e9 ainda mais absurdo.",
   "s": 6.147,
   "e": 8.442
  },
  {
   "text": "Em 1651,",
   "s": 9.293,
   "e": 10.765
  },
  {
   "text": "piratas das ilhas Scilly atacavam navios holandeses.",
   "s": 11.051,
   "e": 13.734
  },
  {
   "text": "Dizem que a Holanda mandou navios e declarou guerra \u00e0s ilhas.",
   "s": 14.588,
   "e": 17.488
  },
  {
   "text": "Acontece que a Inglaterra tomou as ilhas antes da Holanda atacar.",
   "s": 18.337,
   "e": 21.513
  },
  {
   "text": "Os holandeses foram embora.",
   "s": 22.3,
   "e": 23.674
  },
  {
   "text": "E ningu\u00e9m assinou a paz.",
   "s": 24.53,
   "e": 25.774
  },
  {
   "text": "Em 1985,",
   "s": 26.63,
   "e": 28.19
  },
  {
   "text": "um historiador perguntou \u00e0 Holanda:",
   "s": 28.511,
   "e": 31.283
  },
  {
   "text": "a guerra ainda vale?",
   "s": 32.126,
   "e": 33.686
  },
  {
   "text": "Em 1986, o embaixador holand\u00eas foi \u00e0s ilhas assinar a paz.",
   "s": 33.971,
   "e": 36.433
  },
  {
   "text": "335 anos de guerra,",
   "s": 37.295,
   "e": 39.21
  },
  {
   "text": "zero tiros.",
   "s": 39.397,
   "e": 40.09
  },
  {
   "text": "E voc\u00ea achando que guerra precisa de tiro.",
   "s": 40.949,
   "e": 42.874
  }
 ]
