 "phrases": [
  {
   "text": "Um cachorro fugiu,",
   "s": 0.151,
   "e": 1.15
  },
  {
   "text": "e por causa dele dois pa\u00edses entraram em guerra,",
   "s": 1.439,
   "e": 3.781
  },
  {
   "text": "e dezenas de pessoas morreram.",
   "s": 4.074,
   "e": 5.54
  },
  {
   "text": "Em mil novecentos e vinte e cinco,",
   "s": 6.398,
   "e": 7.844
  },
  {
   "text": "a fronteira entre a Gr\u00e9cia e a Bulg\u00e1ria era tensa,",
   "s": 8.059,
   "e": 10.212
  },
  {
   "text": "e os dois pa\u00edses viviam desconfiados.",
   "s": 10.499,
   "e": 12.52
  },
  {
   "text": "Um soldado grego estava de guarda quando o cachorro dele fugiu para o outro lado da fronteira,",
   "s": 13.355,
   "e": 17.555
  },
  {
   "text": "atr\u00e1s de nada.",
   "s": 17.768,
   "e": 18.522
  },
  {
   "text": "O soldado correu atr\u00e1s do cachorro,",
   "s": 19.358,
   "e": 21.115
  },
  {
   "text": "e atravessou a fronteira sem pensar.",
   "s": 21.433,
   "e": 23.29
  },
  {
   "text": "Do outro lado,",
   "s": 24.088,
   "e": 24.832
  },
  {
   "text": "uma sentinela b\u00falgara viu um estranho armado,",
   "s": 25.056,
   "e": 27.188
  },
  {
   "text": "e atirou.",
   "s": 27.457,
   "e": 27.925
  },
  {
   "text": "Acontece que o soldado morreu,",
   "s": 28.784,
   "e": 30.347
  },
  {
   "text": "e a Gr\u00e9cia deu um ultimato furioso \u00e0 Bulg\u00e1ria.",
   "s": 30.674,
   "e": 33.028
  },
  {
   "text": "Poucos dias depois,",
   "s": 33.886,
   "e": 34.903
  },
  {
   "text": "o ex\u00e9rcito grego invadiu a Bulg\u00e1ria e ocupou a regi\u00e3o de Petrich,",
   "s": 35.12,
   "e": 38.296
  },
  {
   "text": "e dezenas de pessoas morreram nos combates.",
   "s": 38.579,
   "e": 40.805
  },
  {
   "text": "A Bulg\u00e1ria pediu ajuda \u00e0 Liga das Na\u00e7\u00f5es,",
   "s": 41.662,
   "e": 43.746
  },
  {
   "text": "a antecessora da ONU.",
   "s": 43.98,
   "e": 45.102
  },
  {
   "text": "A Liga mandou a Gr\u00e9cia parar,",
   "s": 45.972,
   "e": 47.309
  },
  {
   "text": "retirar as tropas e pagar uma indeniza\u00e7\u00e3o.",
   "s": 47.526,
   "e": 49.556
  },
  {
   "text": "A Gr\u00e9cia obedeceu,",
   "s": 50.404,
   "e": 51.364
  },
  {
   "text": "e ningu\u00e9m sabe o que aconteceu com o cachorro.",
   "s": 51.663,
   "e": 53.673
  }
 ]
