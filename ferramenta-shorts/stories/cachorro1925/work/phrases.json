 "phrases": [
  {
   "text": "Um cachorro fugiu pela fronteira e quase come\u00e7ou uma guerra na Europa.",
   "s": 0.152,
   "e": 3.297
  },
  {
   "text": "Em outubro de mil novecentos e vinte e cinco,",
   "s": 4.162,
   "e": 6.16
  },
  {
   "text": "a fronteira entre a Gr\u00e9cia e a Bulg\u00e1ria estava tensa.",
   "s": 6.409,
   "e": 8.825
  },
  {
   "text": "Dizem que um soldado grego correu atr\u00e1s do cachorro,",
   "s": 9.679,
   "e": 12.135
  },
  {
   "text": "e cruzou a fronteira.",
   "s": 12.413,
   "e": 13.466
  },
  {
   "text": "Do outro lado,",
   "s": 14.338,
   "e": 15.12
  },
  {
   "text": "soldados b\u00falgaros atiraram,",
   "s": 15.33,
   "e": 16.82
  },
  {
   "text": "e o soldado caiu morto.",
   "s": 17.139,
   "e": 18.405
  },
  {
   "text": "A Bulg\u00e1ria pediu desculpas e prop\u00f4s investigar juntos.",
   "s": 19.252,
   "e": 21.992
  },
  {
   "text": "A Gr\u00e9cia recusou,",
   "s": 22.839,
   "e": 23.791
  },
  {
   "text": "e deu quarenta e oito horas para a Bulg\u00e1ria punir os culpados,",
   "s": 24.097,
   "e": 26.762
  },
  {
   "text": "pedir desculpas e pagar.",
   "s": 27.018,
   "e": 28.205
  },
  {
   "text": "Dias depois,",
   "s": 29.002,
   "e": 29.74
  },
  {
   "text": "em vinte e dois de outubro,",
   "s": 29.986,
   "e": 31.067
  },
  {
   "text": "o ex\u00e9rcito grego,",
   "s": 31.326,
   "e": 32.243
  },
  {
   "text": "com vinte mil soldados,",
   "s": 32.564,
   "e": 33.791
  },
  {
   "text": "invadiu a Bulg\u00e1ria e ocupou a cidade de Petrich.",
   "s": 34.021,
   "e": 36.427
  },
  {
   "text": "S\u00f3 que a Bulg\u00e1ria apelou \u00e0 Liga das Na\u00e7\u00f5es,",
   "s": 37.312,
   "e": 39.362
  },
  {
   "text": "a antecessora da ONU.",
   "s": 39.585,
   "e": 40.687
  },
  {
   "text": "A Liga mandou parar a guerra de dez dias,",
   "s": 41.564,
   "e": 43.595
  },
  {
   "text": "e a Gr\u00e9cia retirou as tropas e pagou quarenta e cinco mil libras.",
   "s": 43.841,
   "e": 47.018
  },
  {
   "text": "At\u00e9 hoje,",
   "s": 47.869,
   "e": 48.459
  },
  {
   "text": "n\u00e3o h\u00e1 acordo nem sobre a exist\u00eancia do cachorro.",
   "s": 48.686,
   "e": 50.992
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 51.838,
   "e": 53.283
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 53.576,
   "e": 55.337
  }
 ]
}