 "phrases": [
  {
   "text": "Um monge contando ervilhas descobriu como herdamos o que somos.",
   "s": 0.0,
   "e": 2.866
  },
  {
   "text": "E ningu\u00e9m acreditou nele enquanto estava vivo.",
   "s": 3.237,
   "e": 7.101
  },
  {
   "text": "Em 1856, Gregor Mendel cuidava da horta de um mosteiro.",
   "s": 7.309,
   "e": 9.289
  },
  {
   "text": "Cruzou ervilhas amarelas com ervilhas verdes.",
   "s": 9.668,
   "e": 11.951
  },
  {
   "text": "Todas sa\u00edram amarelas,",
   "s": 12.319,
   "e": 13.427
  },
  {
   "text": "como se o verde tivesse sumido.",
   "s": 13.678,
   "e": 15.133
  },
  {
   "text": "Ele plantou de novo e contou ervilha por ervilha,",
   "s": 15.512,
   "e": 17.66
  },
  {
   "text": "por anos.",
   "s": 17.848,
   "e": 18.284
  },
  {
   "text": "Acontece que o verde voltou:",
   "s": 18.657,
   "e": 20.043
  },
  {
   "text": "tr\u00eas amarelas para uma verde.",
   "s": 20.275,
   "e": 21.596
  },
  {
   "text": "Cada filho herda uma instru\u00e7\u00e3o do pai e outra da m\u00e3e.",
   "s": 21.975,
   "e": 24.182
  },
  {
   "text": "S\u00f3 depois da morte dele,",
   "s": 24.56,
   "e": 25.66
  },
  {
   "text": "viram que estava certo.",
   "s": 25.926,
   "e": 26.916
  },
  {
   "text": "Ele morreu sem saber.",
   "s": 27.272,
   "e": 28.276
  },
  {
   "text": "E foi assim que...",
   "s": 28.646,
   "e": 29.386
  }
 ]
