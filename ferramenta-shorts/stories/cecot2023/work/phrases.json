 "phrases": [
  {
   "text": "Uma pris\u00e3o para quarenta mil presos virou not\u00edcia no mundo inteiro.",
   "s": 0.16,
   "e": 3.297
  },
  {
   "text": "E ningu\u00e9m concorda se ela \u00e9 solu\u00e7\u00e3o ou problema.",
   "s": 4.144,
   "e": 6.488
  },
  {
   "text": "Ela fica em El Salvador e abriu em 2023.",
   "s": 7.359,
   "e": 10.004
  },
  {
   "text": "O pa\u00eds tinha uma das maiores taxas de assassinato do mundo.",
   "s": 10.885,
   "e": 13.623
  },
  {
   "text": "Em 2022,",
   "s": 14.478,
   "e": 15.509
  },
  {
   "text": "Nayib Bukele decretou estado de exce\u00e7\u00e3o.",
   "s": 15.717,
   "e": 17.875
  },
  {
   "text": "Muralhas altas,",
   "s": 18.738,
   "e": 19.639
  },
  {
   "text": "cercas el\u00e9tricas e torres de vigia por todo lado.",
   "s": 19.847,
   "e": 22.449
  },
  {
   "text": "Acontece que os assassinatos despencaram de 106 para 2, 4 por cem mil.",
   "s": 23.291,
   "e": 27.846
  },
  {
   "text": "Mas grupos de direitos humanos denunciaram pris\u00f5es sem julgamento.",
