 "phrases": [
  {
   "text": "Uma barra de chocolate derretida no bolso inventou o forno de micro-ondas.",
   "s": 0.157,
   "e": 3.916
  },
  {
   "text": "Era por volta de mil novecentos e quarenta e cinco,",
   "s": 4.778,
   "e": 7.02
  },
  {
   "text": "nos Estados Unidos,",
   "s": 7.291,
   "e": 8.328
  },
  {
   "text": "e o engenheiro Percy Spencer trabalhava numa f\u00e1brica de radares.",
   "s": 8.578,
   "e": 11.741
  },
  {
   "text": "Esses radares tinham uma pe\u00e7a potente,",
   "s": 12.602,
   "e": 14.563
  },
  {
   "text": "que mandava ondas invis\u00edveis o dia inteiro.",
   "s": 14.841,
   "e": 16.888
  },
  {
   "text": "Um dia,",
   "s": 17.726,
   "e": 18.191
  },
  {
   "text": "ele chegou perto dessa pe\u00e7a com uma barra de chocolate no bolso.",
   "s": 18.404,
   "e": 21.383
  },
  {
   "text": "Pouco depois,",
   "s": 22.266,
   "e": 22.994
  },
  {
   "text": "sentiu o bolso quente:",
   "s": 23.261,
   "e": 24.375
  },
  {
   "text": "o chocolate tinha derretido.",
   "s": 24.621,
   "e": 26.048
  },
  {
   "text": "Spencer ficou curioso e perguntou o que mais aquelas ondas fariam.",
   "s": 26.883,
   "e": 30.233
  },
  {
   "text": "Acontece que ele testou milho de pipoca,",
   "s": 31.097,
   "e": 33.176
  },
  {
   "text": "e os gr\u00e3os come\u00e7aram a estourar pela sala.",
   "s": 33.361,
   "e": 35.528
  },
  {
   "text": "Depois testou um ovo,",
   "s": 36.393,
   "e": 37.518
  },
  {
   "text": "e o ovo explodiu bem na cara de um colega.",
   "s": 37.766,
   "e": 39.8
  },
  {
   "text": "Dois anos depois,",
   "s": 40.63,
   "e": 41.674
  },
  {
   "text": "saiu o primeiro forno,",
   "s": 41.904,
   "e": 42.979
  },
  {
   "text": "mais alto que uma pessoa e com mais de trezentos quilos.",
   "s": 43.178,
   "e": 45.9
  },
  {
   "text": "Hoje ele cabe em qualquer cozinha,",
   "s": 46.754,
   "e": 48.36
  },
  {
   "text": "e esquenta a sobra do jantar em um minuto.",
   "s": 48.568,
   "e": 50.529
  },
  {
   "text": "No fim,",
   "s": 51.38,
   "e": 51.77
  },
  {
   "text": "o chocolate perdeu,",
   "s": 52.023,
   "e": 53.017
  },
  {
   "text": "mas a pipoca agradece.",
   "s": 53.28,
   "e": 54.545
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 55.39,
   "e": 56.839
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 57.132,
   "e": 58.894
  }
 ]
