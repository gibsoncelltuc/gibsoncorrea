 "phrases": [
  {
   "text": "Um banquinho dourado come\u00e7ou uma guerra na \u00c1frica.",
   "s": 0.0,
   "e": 2.159
  },
  {
   "text": "E quem pediu para sentar nele nunca conseguiu.",
   "s": 2.537,
   "e": 4.668
  },
  {
   "text": "Em 1900,",
   "s": 5.039,
   "e": 5.912
  },
  {
   "text": "os ingleses mandavam na atual Gana.",
   "s": 6.138,
   "e": 7.738
  },
  {
   "text": "O povo ashanti tinha um banquinho sagrado.",
   "s": 8.117,
   "e": 10.004
  },
  {
   "text": "Nem o rei sentava.",
   "s": 10.381,
   "e": 11.322
  },
  {
   "text": "O governador ingl\u00eas exigiu sentar nele.",
   "s": 11.702,
   "e": 13.624
  },
  {
   "text": "Era como sentar na alma do povo ashanti.",
   "s": 14.004,
   "e": 15.961
  },
  {
   "text": "Eles se revoltaram e cercaram o forte do governador.",
   "s": 16.338,
   "e": 18.737
  },
  {
   "text": "Soldados ingleses vieram,",
   "s": 19.109,
   "e": 20.401
  },
  {
   "text": "e a guerra durou meses.",
   "s": 20.684,
   "e": 21.767
  },
  {
   "text": "Os ingleses venceram.",
   "s": 22.137,
   "e": 23.228
  },
  {
   "text": "Acontece que o banquinho tinha sumido.",
   "s": 23.604,
   "e": 25.31
  },
  {
   "text": "Os ashanti esconderam o banquinho na mata.",
   "s": 25.69,
   "e": 27.531
  },
  {
   "text": "O governador ganhou,",
   "s": 27.904,
   "e": 28.79
  },
  {
   "text": "mas nunca teve o banquinho.",
