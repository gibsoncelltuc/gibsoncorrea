 "phrases": [
  {
   "text": "Para destruir um bunker escondido dentro de uma montanha,",
   "s": 0.171,
   "e": 2.686
  },
  {
   "text": "os Estados Unidos usaram uma bomba que nunca tinha sa\u00eddo do papel.",
   "s": 2.948,
   "e": 6.305
  },
  {
   "text": "Foi em junho de dois mil e vinte e cinco.",
   "s": 7.217,
   "e": 8.941
  },
  {
   "text": "O alvo eram as usinas nucleares do Ir\u00e3.",
   "s": 9.798,
   "e": 11.928
  },
  {
   "text": "A principal,",
   "s": 12.747,
   "e": 13.384
  },
  {
   "text": "Fordow,",
   "s": 13.675,
   "e": 14.031
  },
  {
   "text": "fica a quase noventa metros de profundidade,",
   "s": 14.326,
   "e": 16.416
  },
  {
   "text": "dentro de uma montanha.",
   "s": 16.64,
   "e": 17.656
  },
  {
   "text": "S\u00f3 uma arma chegava l\u00e1:",
   "s": 18.533,
   "e": 19.797
  },
  {
   "text": "a bomba antibunker,",
   "s": 20.073,
   "e": 21.053
  },
  {
   "text": "com mais de treze toneladas.",
   "s": 21.395,
   "e": 22.832
  },
  {
   "text": "E s\u00f3 um avi\u00e3o carrega essa bomba:",
   "s": 23.691,
   "e": 25.422
  },
  {
   "text": "o B-2.",
   "s": 25.73,
   "e": 26.439
  },
  {
   "text": "Trump autorizou a miss\u00e3o.",
   "s": 27.31,
   "e": 28.561
  },
  {
   "text": "O nome:",
   "s": 29.435,
   "e": 29.841
  },
  {
   "text": "Martelo da Meia-Noite.",
   "s": 30.099,
   "e": 31.295
  },
  {
   "text": "Sete bombardeiros invis\u00edveis decolaram do Missouri,",
   "s": 32.184,
   "e": 34.741
  },
  {
   "text": "e voaram mais de um dia sem parar.",
   "s": 35.097,
   "e": 36.859
  },
  {
   "text": "Para despistar,",
   "s": 37.675,
   "e": 38.458
  },
  {
   "text": "outros B-2 foram mandados na dire\u00e7\u00e3o contr\u00e1ria,",
   "s": 38.723,
   "e": 41.276
  },
  {
   "text": "para o Pac\u00edfico.",
   "s": 41.579,
   "e": 42.267
  },
  {
   "text": "Acontece que,",
   "s": 43.12,
   "e": 43.996
  },
  {
   "text": "de madrugada,",
   "s": 44.159,
   "e": 44.834
  },
  {
   "text": "os avi\u00f5es soltaram catorze bombas.",
   "s": 45.077,
   "e": 46.944
  },
  {
   "text": "Doze delas em cima de Fordow,",
   "s": 47.8,
   "e": 49.347
  },
  {
   "text": "pelos respiros do bunker.",
   "s": 49.653,
   "e": 50.894
  },
  {
   "text": "Um submarino ainda disparou m\u00edsseis contra uma terceira usina.",
   "s": 51.696,
   "e": 54.703
  },
  {
   "text": "Todos os avi\u00f5es voltaram para casa.",
   "s": 55.583,
   "e": 57.329
  },
  {
   "text": "Trump disse que as usinas foram destru\u00eddas.",
   "s": 58.189,
   "e": 60.375
  },
  {
   "text": "Avalia\u00e7\u00f5es posteriores discutiram o tamanho real do estrago.",
   "s": 61.246,
   "e": 64.382
  },
  {
   "text": "Foi a primeira vez na hist\u00f3ria que essa bomba gigante foi usada de verdade.",
   "s": 65.275,
   "e": 68.626
  }
 ]
