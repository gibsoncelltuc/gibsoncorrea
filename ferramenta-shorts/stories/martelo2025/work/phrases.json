 "phrases": [
  {
   "text": "Uma bomba gigante,",
   "s": 0.151,
   "e": 1.154
  },
  {
   "text": "feita para furar montanhas,",
   "s": 1.457,
   "e": 2.712
  },
  {
   "text": "foi usada de verdade pela primeira vez.",
   "s": 2.976,
   "e": 4.896
  },
  {
   "text": "Foi em junho de dois mil e vinte e cinco,",
   "s": 5.811,
   "e": 7.478
  },
  {
   "text": "contra usinas nucleares do Ir\u00e3.",
   "s": 7.771,
   "e": 9.405
  },
  {
   "text": "A principal,",
   "s": 10.226,
   "e": 10.847
  },
  {
   "text": "Fordow,",
   "s": 11.18,
   "e": 11.48
  },
  {
   "text": "fica de oitenta a noventa metros de profundidade,",
   "s": 11.81,
   "e": 14.014
  },
  {
   "text": "dentro de uma montanha.",
   "s": 14.251,
   "e": 15.27
  },
  {
   "text": "S\u00f3 uma bomba chegava l\u00e1,",
   "s": 16.15,
   "e": 17.447
  },
  {
   "text": "a antibunker,",
   "s": 17.642,
   "e": 18.37
  },
  {
   "text": "com treze toneladas.",
   "s": 18.674,
   "e": 19.816
  },
  {
   "text": "E s\u00f3 um avi\u00e3o a carrega:",
   "s": 20.661,
   "e": 21.984
  },
  {
   "text": "o B-2.",
   "s": 22.231,
   "e": 22.977
  },
  {
   "text": "A miss\u00e3o se chamou Martelo da Meia-Noite.",
   "s": 23.846,
   "e": 25.907
  },
  {
   "text": "Sete avi\u00f5es invis\u00edveis sa\u00edram do Missouri e viajaram dezoito horas at\u00e9 l\u00e1.",
   "s": 26.796,
   "e": 30.692
  },
  {
   "text": "Para despistar,",
   "s": 31.559,
   "e": 32.312
  },
  {
   "text": "outros avi\u00f5es foram mandados na dire\u00e7\u00e3o do Pac\u00edfico.",
   "s": 32.567,
   "e": 35.198
  },
  {
   "text": "Acontece que,",
   "s": 36.046,
   "e": 36.925
  },
  {
   "text": "de madrugada,",
   "s": 37.094,
   "e": 37.773
  },
  {
   "text": "catorze bombas ca\u00edram,",
   "s": 38.024,
   "e": 39.309
  },
  {
   "text": "doze delas sobre Fordow.",
   "s": 39.518,
   "e": 40.814
  },
  {
   "text": "Um submarino ainda lan\u00e7ou m\u00edsseis contra uma terceira usina.",
   "s": 41.693,
   "e": 44.615
  },
  {
   "text": "Depois,",
   "s": 45.484,
   "e": 45.989
  },
  {
   "text": "os avi\u00f5es voltaram para casa em seguran\u00e7a.",
   "s": 46.311,
   "e": 48.367
  },
  {
   "text": "Os Estados Unidos disseram que as usinas foram destru\u00eddas.",
   "s": 49.197,
   "e": 52.119
  },
  {
   "text": "Mas at\u00e9 hoje ningu\u00e9m concorda sobre o tamanho do estrago.",
   "s": 52.976,
   "e": 55.793
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 56.633,
   "e": 58.078
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 58.371,
   "e": 60.133
  }
 ]
