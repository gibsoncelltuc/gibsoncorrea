 "phrases": [
  {
   "text": "Para destruir um bunker escondido dentro de uma montanha,",
   "s": 0.167,
   "e": 2.68
  },
  {
   "text": "os Estados Unidos usaram uma arma que nunca tinha sa\u00eddo do papel.",
   "s": 2.948,
   "e": 6.237
  },
  {
   "text": "Foi em junho de dois mil e vinte e cinco.",
   "s": 7.147,
   "e": 8.871
  },
  {
   "text": "O alvo eram as usinas nucleares do Ir\u00e3.",
   "s": 9.728,
   "e": 11.858
  },
  {
   "text": "A principal,",
   "s": 12.677,
   "e": 13.314
  },
  {
   "text": "Fordow,",
   "s": 13.605,
   "e": 13.956
  },
  {
   "text": "fica a quase noventa metros de profundidade,",
   "s": 14.256,
   "e": 16.346
  },
  {
   "text": "dentro de uma montanha.",
   "s": 16.57,
   "e": 17.587
  },
  {
   "text": "S\u00f3 uma arma chegava l\u00e1:",
   "s": 18.472,
   "e": 19.714
  },
  {
   "text": "a arma antibunker,",
   "s": 19.908,
   "e": 20.817
  },
  {
   "text": "com mais de treze toneladas.",
   "s": 21.182,
   "e": 22.606
  },
  {
   "text": "E s\u00f3 um avi\u00e3o carrega essa arma:",
   "s": 23.464,
   "e": 25.163
  },
  {
   "text": "o B-2.",
   "s": 25.42,
   "e": 26.141
  },
  {
   "text": "Trump autorizou a miss\u00e3o.",
   "s": 27.0,
   "e": 28.252
  },
  {
   "text": "O nome:",
   "s": 29.126,
   "e": 29.533
  },
  {
   "text": "Martelo da Meia-Noite.",
   "s": 29.79,
   "e": 30.985
  },
  {
   "text": "Sete bombardeiros invis\u00edveis decolaram do Missouri,",
   "s": 31.878,
   "e": 34.432
  },
  {
   "text": "e voaram mais de um dia sem parar.",
   "s": 34.788,
   "e": 36.533
  },
  {
   "text": "Para despistar,",
   "s": 37.366,
   "e": 38.149
  },
  {
   "text": "outros B-2 foram mandados na dire\u00e7\u00e3o contr\u00e1ria,",
   "s": 38.414,
   "e": 40.967
  },
  {
   "text": "para o Pac\u00edfico.",
   "s": 41.27,
   "e": 41.958
  },
  {
   "text": "Acontece que,",
   "s": 42.818,
   "e": 43.699
  },
  {
   "text": "de madrugada,",
   "s": 43.847,
   "e": 44.5
  },
  {
   "text": "os avi\u00f5es soltaram catorze cargas explosivas.",
   "s": 44.755,
   "e": 47.228
  },
  {
   "text": "Doze delas em cima de Fordow,",
   "s": 48.082,
   "e": 49.629
  },
  {
   "text": "pelos respiros do bunker.",
   "s": 49.934,
   "e": 51.161
  },
  {
   "text": "Um submarino ainda lan\u00e7ou m\u00edsseis contra uma terceira usina.",
   "s": 51.965,
   "e": 54.887
  },
  {
   "text": "Todos os avi\u00f5es voltaram para casa.",
   "s": 55.762,
   "e": 57.509
  },
  {
   "text": "Trump disse que as usinas foram destru\u00eddas.",
   "s": 58.369,
   "e": 60.555
  },
  {
   "text": "Avalia\u00e7\u00f5es posteriores discutiram o tamanho real do estrago.",
   "s": 61.426,
   "e": 64.561
  },
  {
   "text": "Foi a primeira vez na hist\u00f3ria que essa arma gigante foi usada de verdade.",
   "s": 65.455,
   "e": 68.719
  }
 ]
