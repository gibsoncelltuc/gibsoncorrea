 "phrases": [
  {
   "text": "Em mil novecentos e trinta e dois,",
   "s": 0.0,
   "e": 2.123
  },
  {
   "text": "a Austr\u00e1lia declarou guerra aos p\u00e1ssaros.",
   "s": 2.289,
   "e": 4.733
  },
  {
   "text": "Vinte mil emus estavam destruindo as planta\u00e7\u00f5es de trigo no oeste da Austr\u00e1lia,",
   "s": 5.081,
   "e": 9.897
  },
  {
   "text": "e fazendeiros desesperados pediram ajuda ao ex\u00e9rcito.",
   "s": 10.067,
   "e": 13.456
  },
  {
   "text": "Ent\u00e3o o governo mandou soldados,",
   "s": 13.794,
   "e": 15.845
  },
  {
   "text": "duas metralhadoras,",
   "s": 16.025,
   "e": 17.28
  },
  {
   "text": "e dez mil balas.",
   "s": 17.448,
   "e": 18.468
  },
  {
   "text": "Contra emus.",
   "s": 18.853,
   "e": 19.651
  },
  {
   "text": "Mas emus s\u00e3o r\u00e1pidos,",
   "s": 19.987,
   "e": 21.348
  },
  {
   "text": "e n\u00e3o ficam parados.",
   "s": 21.515,
   "e": 22.759
  },
  {
   "text": "Sempre que os soldados miravam,",
   "s": 23.104,
   "e": 24.946
  },
  {
   "text": "os p\u00e1ssaros se espalhavam em todas as dire\u00e7\u00f5es,",
   "s": 25.117,
   "e": 28.133
  },
  {
   "text": "e fugiam correndo.",
   "s": 28.3,
   "e": 29.456
  },
  {
   "text": "Um atirador at\u00e9 montou uma metralhadora num caminh\u00e3o.",
   "s": 29.79,
   "e": 33.164
  },
  {
   "text": "Mas o caminh\u00e3o pulava tanto no ch\u00e3o irregular,",
   "s": 33.505,
   "e": 36.167
  },
  {
   "text": "que ele n\u00e3o acertava nenhum p\u00e1ssaro.",
   "s": 36.388,
   "e": 38.412
  },
  {
   "text": "Depois de uma semana,",
   "s": 38.762,
   "e": 39.959
  },
  {
   "text": "o ex\u00e9rcito tinha gasto milhares de balas,",
   "s": 40.138,
   "e": 42.663
  },
  {
   "text": "e os emus mal tinham sido arranhados.",
   "s": 42.84,
   "e": 45.043
  },
  {
   "text": "Os soldados se retiraram.",
   "s": 45.409,
   "e": 47.045
  },
  {
   "text": "A imprensa gargalhou,",
   "s": 47.382,
   "e": 48.916
  },
  {
   "text": "e um oficial admitiu que os emus lutavam como tanques.",
   "s": 49.084,
   "e": 52.387
  },
  {
   "text": "O ex\u00e9rcito tentou de novo,",
   "s": 52.721,
   "e": 54.375
  },
  {
   "text": "e finalmente abateu algumas centenas de p\u00e1ssaros.",
   "s": 54.543,
   "e": 57.606
  },
  {
   "text": "Mas os emus continuavam voltando.",
   "s": 57.983,
   "e": 60.087
  },
  {
   "text": "No final,",
   "s": 60.419,
   "e": 61.033
  },
  {
   "text": "os fazendeiros ganharam um sistema de recompensas.",
   "s": 61.201,
   "e": 64.402
  },
  {
   "text": "E a grande Guerra dos Emus entrou para a hist\u00f3ria como uma derrota do ex\u00e9rcito.",
   "s": 64.735,
   "e": 69.198
  },
  {
   "text": "Humanos,",
   "s": 69.535,
   "e": 70.013
  },
  {
   "text": "zero.",
   "s": 70.203,
   "e": 70.537
  },
  {
   "text": "Emus,",
   "s": 70.874,
   "e": 71.274
  },
  {
   "text": "um.",
   "s": 71.44,
   "e": 71.753
  }
 ]
}