 "phrases": [
  {
   "text": "Duas cidades italianas foram \u00e0 guerra por causa de um balde de madeira.",
   "s": 0.155,
   "e": 3.384
  },
  {
   "text": "M\u00f3dena e Bolonha se odiavam havia s\u00e9culos.",
   "s": 4.239,
   "e": 6.618
  },
  {
   "text": "Uma apoiava o imperador,",
   "s": 7.463,
   "e": 8.627
  },
  {
   "text": "a outra,",
   "s": 8.909,
   "e": 9.319
  },
  {
   "text": "o papa,",
   "s": 9.573,
   "e": 10.008
  },
  {
   "text": "e qualquer desculpa servia para brigar.",
   "s": 10.219,
   "e": 12.111
  },
  {
   "text": "Um soldado de M\u00f3dena empurrou o de Bolonha,",
   "s": 12.919,
   "e": 14.966
  },
  {
   "text": "que foi derrubado no ch\u00e3o,",
   "s": 15.264,
   "e": 16.442
  },
  {
   "text": "e todos riram.",
   "s": 16.721,
   "e": 17.446
  },
  {
   "text": "Numa noite,",
   "s": 18.312,
   "e": 18.954
  },
  {
   "text": "diz a lenda,",
   "s": 19.164,
   "e": 19.814
  },
  {
   "text": "soldados de M\u00f3dena entraram escondidos em Bolonha.",
   "s": 20.002,
   "e": 22.483
  },
  {
   "text": "N\u00e3o roubaram ouro,",
   "s": 23.324,
   "e": 24.227
  },
  {
   "text": "nem armas.",
   "s": 24.454,
   "e": 25.152
  },
  {
   "text": "Levaram o balde velho do po\u00e7o da pra\u00e7a,",
   "s": 25.998,
   "e": 28.013
  },
  {
   "text": "e voltaram para casa rindo.",
   "s": 28.26,
   "e": 29.55
  },
  {
   "text": "\"Devolvam o nosso balde\",",
   "s": 30.414,
   "e": 31.694
  },
  {
   "text": "exigiu Bolonha.",
   "s": 31.94,
   "e": 32.764
  },
  {
   "text": "\"Venham buscar\",",
   "s": 33.631,
   "e": 34.407
  },
  {
   "text": "respondeu M\u00f3dena.",
   "s": 34.677,
   "e": 35.524
  },
  {
   "text": "Bolonha juntou um ex\u00e9rcito de trinta mil homens,",
   "s": 36.387,
   "e": 38.917
  },
  {
   "text": "e marchou contra a vizinha.",
   "s": 39.131,
   "e": 40.251
  },
  {
   "text": "M\u00f3dena tinha s\u00f3 sete mil soldados.",
   "s": 41.123,
   "e": 43.045
  },
  {
   "text": "Parecia uma derrota certa,",
   "s": 43.914,
   "e": 45.331
  },
  {
   "text": "e r\u00e1pida.",
   "s": 45.546,
   "e": 46.069
  },
  {
   "text": "Acontece que,",
   "s": 46.94,
   "e": 47.754
  },
  {
   "text": "numa \u00fanica tarde de batalha,",
   "s": 47.984,
   "e": 49.359
  },
  {
   "text": "os sete mil atacaram de surpresa,",
   "s": 49.595,
   "e": 51.239
  },
  {
   "text": "e o ex\u00e9rcito gigante fugiu correndo.",
   "s": 51.559,
   "e": 53.356
  },
  {
   "text": "M\u00f3dena perseguiu os inimigos at\u00e9 os port\u00f5es de Bolonha,",
   "s": 54.233,
   "e": 57.01
  },
  {
   "text": "e ainda zombou deles do lado de fora.",
   "s": 57.315,
   "e": 59.271
  },
  {
   "text": "O balde nunca foi devolvido.",
   "s": 60.116,
   "e": 61.623
  },
  {
   "text": "Est\u00e1 guardado em M\u00f3dena at\u00e9 hoje,",
   "s": 62.479,
   "e": 64.178
  },
  {
   "text": "setecentos anos depois.",
   "s": 64.414,
   "e": 65.924
  }
 ]
}