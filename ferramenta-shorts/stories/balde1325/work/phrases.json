 "phrases": [
  {
   "text": "Dois vizinhos italianos foram \u00e0 guerra,",
   "s": 0.157,
   "e": 2.121
  },
  {
   "text": "e o pr\u00eamio do vencedor foi um balde de madeira.",
   "s": 2.372,
   "e": 4.549
  },
  {
   "text": "M\u00f3dena e Bolonha disputavam a fronteira havia d\u00e9cadas:",
   "s": 5.413,
   "e": 8.094
  },
  {
   "text": "M\u00f3dena tinha o imperador como patrono,",
   "s": 8.342,
   "e": 10.075
  },
  {
   "text": "Bolonha tinha o papa.",
   "s": 10.354,
   "e": 11.384
  },
  {
   "text": "Em mil trezentos e vinte e cinco,",
   "s": 12.249,
   "e": 13.71
  },
  {
   "text": "Bolonha juntou cerca de trinta mil soldados a p\u00e9 e marchou contra o territ\u00f3rio de M\u00f3dena.",
   "s": 14.019,
   "e": 18.338
  },
  {
   "text": "M\u00f3dena tinha menos de oito mil homens,",
   "s": 19.197,
   "e": 21.161
  },
  {
   "text": "entre cavaleiros e soldados a p\u00e9,",
   "s": 21.45,
   "e": 23.054
  },
  {
   "text": "e parecia perdida.",
   "s": 23.305,
   "e": 24.386
  },
  {
   "text": "Acontece que,",
   "s": 25.23,
   "e": 26.041
  },
  {
   "text": "ao p\u00f4r do sol de quinze de novembro,",
   "s": 26.202,
   "e": 27.873
  },
  {
   "text": "os modeneses atacaram,",
   "s": 28.144,
   "e": 29.369
  },
  {
   "text": "e o ex\u00e9rcito gigante de Bolonha fugiu em poucas horas.",
   "s": 29.713,
   "e": 32.49
  },
  {
   "text": "Morreram cerca de duas mil pessoas,",
   "s": 33.341,
   "e": 35.329
  },
  {
   "text": "e os modeneses chegaram aos muros de Bolonha.",
   "s": 35.613,
   "e": 37.745
  },
  {
   "text": "Em vez de invadir,",
   "s": 38.611,
   "e": 39.551
  },
  {
   "text": "fizeram uma festa l\u00e1 fora para zombar dos derrotados.",
   "s": 39.836,
   "e": 42.429
  },
  {
   "text": "Na volta,",
   "s": 43.282,
   "e": 43.811
  },
  {
   "text": "levaram como trof\u00e9u um balde de madeira,",
   "s": 44.062,
   "e": 45.986
  },
  {
   "text": "tirado de um po\u00e7o perto da porta de Bolonha.",
   "s": 46.234,
   "e": 48.305
  },
  {
   "text": "O balde ficou guardado na torre Ghirlandina,",
   "s": 49.197,
   "e": 51.425
  },
  {
   "text": "em M\u00f3dena,",
   "s": 51.673,
   "e": 52.175
  },
  {
   "text": "e virou s\u00edmbolo da vit\u00f3ria.",
   "s": 52.418,
   "e": 53.72
  },
  {
   "text": "Um poeta italiano transformou a hist\u00f3ria numa s\u00e1tira famosa,",
   "s": 54.547,
   "e": 57.426
  },
  {
   "text": "escrita por volta de mil seiscentos e quinze.",
   "s": 57.671,
   "e": 59.885
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 60.749,
   "e": 62.192
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 62.486,
   "e": 64.248
  }
 ]
}