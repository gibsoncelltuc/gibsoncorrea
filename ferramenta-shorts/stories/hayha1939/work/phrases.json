 "phrases": [
  {
   "text": "Um fazendeiro baixinho virou o soldado mais temido de uma guerra inteira.",
   "s": 0.142,
   "e": 3.338
  },
  {
   "text": "Era o inverno de mil novecentos e trinta e nove,",
   "s": 4.2,
   "e": 6.259
  },
  {
   "text": "e a Uni\u00e3o Sovi\u00e9tica invadiu a Finl\u00e2ndia.",
   "s": 6.61,
   "e": 8.758
  },
  {
   "text": "Os soldados finlandeses eram poucos,",
   "s": 9.613,
   "e": 11.501
  },
  {
   "text": "mas conheciam a floresta,",
   "s": 11.755,
   "e": 13.015
  },
  {
   "text": "a neve e o frio,",
   "s": 13.236,
   "e": 14.007
  },
  {
   "text": "que chegava a quarenta graus abaixo de zero.",
   "s": 14.26,
   "e": 16.261
  },
  {
   "text": "Um deles era um homem do campo,",
   "s": 17.105,
   "e": 18.543
  },
  {
   "text": "baixinho,",
   "s": 18.785,
   "e": 19.3
  },
  {
   "text": "chamado Simo H\u00e4yh\u00e4.",
   "s": 19.543,
   "e": 20.539
  },
  {
   "text": "Vestido de branco,",
   "s": 21.403,
   "e": 22.336
  },
  {
   "text": "ele esperava im\u00f3vel no meio da neve,",
   "s": 22.567,
   "e": 24.212
  },
  {
   "text": "horas a fio.",
   "s": 24.431,
   "e": 25.013
  },
  {
   "text": "Dizem que ele mantinha neve na boca,",
   "s": 25.846,
   "e": 27.522
  },
  {
   "text": "para o vapor da respira\u00e7\u00e3o n\u00e3o entregar a sua posi\u00e7\u00e3o.",
   "s": 27.786,
   "e": 30.319
  },
  {
   "text": "Em cerca de cem dias,",
   "s": 31.178,
   "e": 32.453
  },
  {
   "text": "contam mais de quinhentos inimigos abatidos por ele,",
   "s": 32.701,
   "e": 35.236
  },
  {
   "text": "com um fuzil de mira de ferro,",
   "s": 35.567,
   "e": 36.931
  },
  {
   "text": "sem luneta.",
   "s": 37.139,
   "e": 37.777
  },
  {
   "text": "Os sovi\u00e9ticos passaram a cham\u00e1-lo de Morte Branca.",
   "s": 38.645,
   "e": 41.084
  },
  {
   "text": "Em mar\u00e7o de mil novecentos e quarenta,",
   "s": 41.94,
   "e": 43.757
  },
  {
   "text": "uma bala atingiu o rosto dele.",
   "s": 44.02,
   "e": 45.642
  },
  {
   "text": "Ele sobreviveu,",
   "s": 46.497,
   "e": 47.302
  },
  {
   "text": "e acordou no dia em que a guerra terminou.",
   "s": 47.572,
   "e": 49.493
  },
  {
   "text": "Viveu at\u00e9 os noventa e seis anos,",
   "s": 50.336,
   "e": 52.074
  },
  {
   "text": "e nunca se achou her\u00f3i.",
   "s": 52.326,
   "e": 53.454
  },
  {
   "text": "Dizia que s\u00f3 tinha feito o seu trabalho.",
   "s": 54.319,
   "e": 56.299
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 57.124,
   "e": 58.569
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 58.861,
   "e": 60.623
  }
 ]
}