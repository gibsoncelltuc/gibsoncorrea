 "phrases": [
  {
   "text": "Inverno de mil novecentos e trinta e nove.",
   "s": 0.16,
   "e": 2.177
  },
  {
   "text": "A Uni\u00e3o Sovi\u00e9tica invadiu a Finl\u00e2ndia,",
   "s": 3.068,
   "e": 5.169
  },
  {
   "text": "com um ex\u00e9rcito enorme.",
   "s": 5.487,
   "e": 6.589
  },
  {
   "text": "Os soldados finlandeses eram poucos,",
   "s": 7.454,
   "e": 9.343
  },
  {
   "text": "mas conheciam a floresta,",
   "s": 9.597,
   "e": 10.856
  },
  {
   "text": "a neve e o frio,",
   "s": 11.077,
   "e": 11.848
  },
  {
   "text": "que chegava a quarenta graus abaixo de zero.",
   "s": 12.101,
   "e": 14.102
  },
  {
   "text": "Um deles era um fazendeiro baixinho chamado Simo H\u00e4yh\u00e4.",
   "s": 14.942,
   "e": 17.575
  },
  {
   "text": "Vestido de branco,",
   "s": 18.414,
   "e": 19.348
  },
  {
   "text": "ele esperava im\u00f3vel no meio da neve,",
   "s": 19.579,
   "e": 21.224
  },
  {
   "text": "horas a fio.",
   "s": 21.442,
   "e": 22.025
  },
  {
   "text": "Dizem que ele mantinha neve na boca,",
   "s": 22.857,
   "e": 24.533
  },
  {
   "text": "para o vapor da respira\u00e7\u00e3o n\u00e3o entregar a sua posi\u00e7\u00e3o.",
   "s": 24.797,
   "e": 27.33
  },
  {
   "text": "Em cerca de cem dias,",
   "s": 28.192,
   "e": 29.433
  },
  {
   "text": "ele teve mais de quinhentos inimigos confirmados,",
   "s": 29.684,
   "e": 32.142
  },
  {
   "text": "com uma carabina de mira de ferro,",
   "s": 32.425,
   "e": 33.999
  },
  {
   "text": "sem luneta.",
   "s": 34.215,
   "e": 34.837
  },
  {
   "text": "Os sovi\u00e9ticos passaram a cham\u00e1-lo de Morte Branca.",
   "s": 35.702,
   "e": 38.141
  },
  {
   "text": "Em mar\u00e7o de mil novecentos e quarenta,",
   "s": 38.997,
   "e": 40.814
  },
  {
   "text": "uma bala atingiu o rosto dele.",
   "s": 41.077,
   "e": 42.699
  },
  {
   "text": "Ele sobreviveu,",
   "s": 43.554,
   "e": 44.359
  },
  {
   "text": "e acordou no dia em que a guerra terminou.",
   "s": 44.629,
   "e": 46.55
  },
  {
   "text": "Viveu at\u00e9 os noventa e seis anos,",
   "s": 47.393,
   "e": 49.131
  },
  {
   "text": "e nunca se achou her\u00f3i.",
   "s": 49.383,
   "e": 50.511
  },
  {
   "text": "Dizia que s\u00f3 tinha feito o seu trabalho.",
   "s": 51.377,
   "e": 53.356
  }
 ]
}