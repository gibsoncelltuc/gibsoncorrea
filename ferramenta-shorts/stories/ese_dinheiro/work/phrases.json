 "phrases": [
  {
   "text": "E se todo o dinheiro do mundo sumisse de uma vez?",
   "s": 0.161,
   "e": 2.606
  },
  {
   "text": "Nota,",
   "s": 3.454,
   "e": 3.811
  },
  {
   "text": "moeda,",
   "s": 4.053,
   "e": 4.492
  },
  {
   "text": "cart\u00e3o e conta no banco.",
   "s": 4.747,
   "e": 6.006
  },
  {
   "text": "Primeira manh\u00e3:",
   "s": 6.888,
   "e": 7.484
  },
  {
   "text": "voc\u00ea chega na padaria e n\u00e3o tem como pagar o caf\u00e9.",
   "s": 7.719,
   "e": 9.989
  },
  {
   "text": "A sa\u00edda seria a mais antiga de todas:",
   "s": 10.821,
   "e": 12.819
  },
  {
   "text": "a troca.",
   "s": 12.988,
   "e": 13.415
  },
  {
   "text": "Uma galinha por uma cesta de comida.",
   "s": 14.279,
   "e": 15.948
  },
  {
   "text": "Acontece que a troca tem um problema:",
   "s": 16.82,
   "e": 18.623
  },
  {
   "text": "o padeiro pode n\u00e3o querer galinha.",
   "s": 18.901,
   "e": 20.474
  },
  {
   "text": "E a\u00ed,",
   "s": 21.327,
   "e": 21.686
  },
  {
   "text": "ningu\u00e9m come.",
   "s": 21.934,
   "e": 22.696
  },
  {
   "text": "Por isso,",
   "s": 23.582,
   "e": 24.011
  },
  {
   "text": "os povos sempre inventaram um dinheiro.",
   "s": 24.262,
   "e": 26.093
  },
  {
   "text": "Na ilha de Yap,",
   "s": 26.926,
   "e": 27.699
  },
  {
   "text": "no Pac\u00edfico,",
   "s": 27.973,
   "e": 28.634
  },
  {
   "text": "eram pedras gigantes.",
   "s": 28.877,
   "e": 29.986
  },
  {
   "text": "Algumas eram t\u00e3o pesadas que nunca sa\u00edam do lugar.",
   "s": 30.859,
   "e": 33.496
  },
  {
   "text": "Todo mundo s\u00f3 lembrava quem era o dono.",
   "s": 34.311,
   "e": 36.167
  },
  {
   "text": "Em poucas semanas,",
   "s": 37.031,
   "e": 38.033
  },
  {
   "text": "as feiras de troca tomariam as pra\u00e7as.",
   "s": 38.258,
   "e": 40.223
  },
  {
   "text": "Em poucos meses,",
   "s": 41.08,
   "e": 42.017
  },
  {
   "text": "alguma coisa viraria o novo dinheiro:",
   "s": 42.182,
   "e": 43.883
  },
  {
   "text": "sal,",
   "s": 44.155,
   "e": 44.451
  },
  {
   "text": "ouro,",
   "s": 44.614,
   "e": 44.908
  },
  {
   "text": "ou at\u00e9 figurinha.",
   "s": 45.109,
   "e": 45.957
  },
  {
   "text": "Isso j\u00e1 aconteceu em pris\u00f5es e em guerras:",
   "s": 46.828,
   "e": 48.884
  },
  {
   "text": "quando o dinheiro some,",
   "s": 49.173,
   "e": 50.087
  },
  {
   "text": "as pessoas inventam outro.",
   "s": 50.318,
   "e": 51.66
  },
  {
   "text": "Ou seja:",
   "s": 52.522,
   "e": 53.057
  },
  {
   "text": "dinheiro n\u00e3o \u00e9 papel.",
   "s": 53.291,
   "e": 54.369
  },
  {
   "text": "\u00c9 confian\u00e7a entre as pessoas.",
   "s": 55.227,
   "e": 56.833
  },
  {
   "text": "Se ele sumisse,",
   "s": 57.694,
   "e": 58.483
  },
  {
   "text": "a gente inventaria de novo.",
   "s": 58.675,
   "e": 59.916
  },
  {
   "text": "Em menos de um ano.",
   "s": 60.774,
   "e": 61.768
  }
 ]
