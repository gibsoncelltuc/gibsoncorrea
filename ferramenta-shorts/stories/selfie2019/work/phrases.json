 "phrases": [
  {
   "text": "Um presidente chegou ao palco mais importante do mundo,",
   "s": 0.152,
   "e": 2.707
  },
  {
   "text": "e antes de falar,",
   "s": 3.022,
   "e": 3.942
  },
  {
   "text": "tirou uma selfie.",
   "s": 4.161,
   "e": 5.008
  },
  {
   "text": "Foi em setembro de dois mil e dezenove,",
   "s": 5.925,
   "e": 7.549
  },
  {
   "text": "na Assembleia Geral da ONU,",
   "s": 7.739,
   "e": 9.016
  },
  {
   "text": "em Nova York.",
   "s": 9.3,
   "e": 10.031
  },
  {
   "text": "Ali,",
   "s": 10.87,
   "e": 11.195
  },
  {
   "text": "os l\u00edderes de quase todos os pa\u00edses fazem discursos longos e s\u00e9rios.",
   "s": 11.558,
   "e": 15.284
  },
  {
   "text": "Nayib Bukele,",
   "s": 16.141,
   "e": 16.999
  },
  {
   "text": "o novo presidente de El Salvador,",
   "s": 17.234,
   "e": 18.761
  },
  {
   "text": "tinha s\u00f3 trinta e oito anos.",
   "s": 19.053,
   "e": 20.388
  },
  {
   "text": "Acontece que,",
   "s": 21.246,
   "e": 22.167
  },
  {
   "text": "no p\u00falpito,",
   "s": 22.381,
   "e": 22.974
  },
  {
   "text": "ele pediu:",
   "s": 23.24,
   "e": 23.783
  },
  {
   "text": "s\u00f3 um segundo,",
   "s": 24.068,
   "e": 24.808
  },
  {
   "text": "por favor.",
   "s": 25.153,
   "e": 25.626
  },
  {
   "text": "E tirou o celular do bolso.",
   "s": 26.456,
   "e": 27.937
  },
  {
   "text": "Virou de costas para a plateia,",
   "s": 28.798,
   "e": 30.271
  },
  {
   "text": "e tirou uma selfie com o plen\u00e1rio inteiro atr\u00e1s.",
   "s": 30.517,
   "e": 32.734
  },
  {
   "text": "Depois,",
   "s": 33.588,
   "e": 34.115
  },
  {
   "text": "brincou:",
   "s": 34.329,
   "e": 34.775
  },
  {
   "text": "acreditem,",
   "s": 35.013,
   "e": 35.54
  },
  {
   "text": "muito mais gente vai ver essa selfie do que ouvir este discurso.",
   "s": 35.76,
   "e": 38.676
  },
  {
   "text": "E ele tinha raz\u00e3o.",
   "s": 39.539,
   "e": 40.472
  },
  {
   "text": "A foto rodou o planeta em poucas horas.",
   "s": 41.343,
   "e": 43.36
  },
  {
   "text": "Alguns acharam falta de respeito com a ONU.",
   "s": 44.227,
   "e": 46.335
  },
  {
   "text": "Outros acharam genial.",
   "s": 47.209,
   "e": 48.381
  },
  {
   "text": "No discurso,",
   "s": 49.243,
   "e": 49.933
  },
  {
   "text": "ele defendeu justamente isso:",
