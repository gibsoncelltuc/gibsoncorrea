 "phrases": [
  {
   "text": "Um presidente chegou ao p\u00falpito mais importante do mundo,",
   "s": 0.159,
   "e": 2.819
  },
  {
   "text": "e antes de falar,",
   "s": 3.124,
   "e": 4.065
  },
  {
   "text": "tirou uma selfie.",
   "s": 4.294,
   "e": 5.135
  },
  {
   "text": "Foi em setembro de dois mil e dezenove,",
   "s": 6.05,
   "e": 7.672
  },
  {
   "text": "na Assembleia Geral da ONU,",
   "s": 7.862,
   "e": 9.139
  },
  {
   "text": "em Nova York.",
   "s": 9.423,
   "e": 10.154
  },
  {
   "text": "Ali,",
   "s": 10.994,
   "e": 11.318
  },
  {
   "text": "os l\u00edderes de quase todos os pa\u00edses fazem discursos longos e s\u00e9rios.",
   "s": 11.681,
   "e": 15.407
  },
  {
   "text": "Nayib Bukele,",
   "s": 16.264,
   "e": 17.121
  },
  {
   "text": "o novo presidente de El Salvador,",
   "s": 17.357,
   "e": 18.891
  },
  {
   "text": "tinha s\u00f3 trinta e oito anos.",
   "s": 19.176,
   "e": 20.515
  },
  {
   "text": "Acontece que,",
   "s": 21.369,
   "e": 22.29
  },
  {
   "text": "no p\u00falpito,",
   "s": 22.504,
   "e": 23.097
  },
  {
   "text": "ele pediu:",
   "s": 23.363,
   "e": 23.906
  },
  {
   "text": "s\u00f3 um segundo,",
   "s": 24.191,
   "e": 24.93
  },
  {
   "text": "por favor.",
   "s": 25.279,
   "e": 25.754
  },
  {
   "text": "E tirou o celular do bolso.",
   "s": 26.578,
   "e": 28.059
  },
  {
   "text": "Virou de costas para o plen\u00e1rio,",
   "s": 28.926,
   "e": 30.352
  },
  {
   "text": "e tirou uma selfie com todos atr\u00e1s.",
   "s": 30.623,
   "e": 32.536
  },
  {
   "text": "Depois,",
   "s": 33.393,
   "e": 33.922
  },
  {
   "text": "brincou:",
   "s": 34.134,
   "e": 34.579
  },
  {
   "text": "acreditem,",
   "s": 34.818,
   "e": 35.345
  },
  {
   "text": "muito mais gente vai ver essa selfie do que ouvir este discurso.",
   "s": 35.565,
   "e": 38.482
  },
  {
   "text": "E ele tinha raz\u00e3o.",
   "s": 39.344,
   "e": 40.277
  },
  {
   "text": "A foto rodou o planeta em poucas horas.",
   "s": 41.148,
   "e": 43.165
  },
  {
   "text": "Alguns acharam falta de respeito com a ONU.",
   "s": 44.032,
   "e": 46.139
  },
  {
   "text": "Outros acharam genial.",
   "s": 47.014,
   "e": 48.186
  },
  {
   "text": "No discurso,",
   "s": 49.048,
   "e": 49.737
  },
  {
   "text": "ele defendeu justamente isso:",
   "s": 50.022,
   "e": 51.436
  },
