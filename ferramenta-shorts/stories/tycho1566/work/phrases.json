 "phrases": [
  {
   "text": "Um dos maiores astr\u00f4nomos da hist\u00f3ria perdeu o nariz numa briga por causa de matem\u00e1tica.",
   "s": 0.151,
   "e": 4.267
  },
  {
   "text": "Era mil quinhentos e sessenta e seis.",
   "s": 5.107,
   "e": 6.954
  },
  {
   "text": "Tycho Brahe,",
   "s": 7.808,
   "e": 8.382
  },
  {
   "text": "um jovem nobre da Dinamarca,",
   "s": 8.586,
   "e": 10.03
  },
  {
   "text": "estudava numa cidade da Alemanha.",
   "s": 10.225,
   "e": 11.891
  },
  {
   "text": "Numa festa,",
   "s": 12.754,
   "e": 13.438
  },
  {
   "text": "ele discutiu com um primo sobre quem era o melhor em matem\u00e1tica.",
   "s": 13.682,
   "e": 16.451
  },
  {
   "text": "A briga n\u00e3o acabou ali.",
   "s": 17.274,
   "e": 18.518
  },
  {
   "text": "Dias depois,",
   "s": 19.375,
   "e": 20.146
  },
  {
   "text": "os dois resolveram tudo num duelo de espadas,",
   "s": 20.454,
   "e": 22.797
  },
  {
   "text": "no escuro.",
   "s": 22.963,
   "e": 23.452
  },
  {
   "text": "Acontece que o primo acertou um golpe certeiro,",
   "s": 24.326,
   "e": 26.545
  },
  {
   "text": "e cortou fora um peda\u00e7o do nariz de Tycho.",
   "s": 26.864,
   "e": 28.826
  },
  {
   "text": "Para esconder o buraco,",
   "s": 29.701,
   "e": 30.722
  },
  {
   "text": "ele passou a usar um nariz de metal,",
   "s": 30.985,
   "e": 32.593
  },
  {
   "text": "colado no rosto.",
   "s": 32.88,
   "e": 33.752
  },
  {
   "text": "Anos depois,",
   "s": 34.607,
   "e": 35.326
  },
  {
   "text": "o rei da Dinamarca deu a ele uma ilha inteira,",
   "s": 35.62,
   "e": 37.704
  },
  {
   "text": "s\u00f3 para estudar o c\u00e9u.",
   "s": 37.919,
   "e": 38.989
  },
  {
   "text": "L\u00e1,",
   "s": 39.851,
   "e": 40.082
  },
  {
   "text": "ele construiu um castelo observat\u00f3rio,",
   "s": 40.303,
   "e": 42.081
  },
  {
   "text": "e anotou a posi\u00e7\u00e3o de mais de mil estrelas,",
   "s": 42.408,
   "e": 44.543
  },
  {
   "text": "sem telesc\u00f3pio.",
   "s": 44.748,
   "e": 45.493
  },
  {
   "text": "As anota\u00e7\u00f5es eram t\u00e3o precisas,",
   "s": 46.359,
   "e": 48.18
  },
  {
   "text": "que ajudaram Kepler a descobrir como os planetas giram em volta do Sol.",
   "s": 48.381,
   "e": 51.689
  },
  {
   "text": "Essa descoberta mudou a astronomia para sempre.",
   "s": 52.569,
   "e": 54.982
  },
  {
   "text": "E Tycho entrou para a hist\u00f3ria assim:",
   "s": 55.839,
   "e": 57.329
  },
  {
   "text": "com a cabe\u00e7a nas estrelas,",
   "s": 57.643,
   "e": 59.001
  },
  {
   "text": "e o nariz de metal.",
   "s": 59.241,
   "e": 60.117
  }
 ]
