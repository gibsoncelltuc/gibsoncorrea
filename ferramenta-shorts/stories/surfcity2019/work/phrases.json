 "phrases": [
  {
   "text": "Em dois mil e dezenove,",
   "s": 0.162,
   "e": 1.113
  },
  {
   "text": "o presidente Nayib Bukele lan\u00e7ou a Surf City El Salvador.",
   "s": 1.428,
   "e": 4.416
  },
  {
   "text": "O plano:",
   "s": 5.237,
   "e": 5.673
  },
  {
   "text": "mostrar as praias de La Libertad,",
   "s": 5.966,
   "e": 7.57
  },
  {
   "text": "como Punta Roca e El Sunzal,",
   "s": 7.818,
   "e": 9.304
  },
  {
   "text": "ao mundo.",
   "s": 9.512,
   "e": 9.966
  },
  {
   "text": "Em dois mil e vinte e um,",
   "s": 10.818,
   "e": 11.722
  },
  {
   "text": "o pa\u00eds sediou o Mundial de Surfe,",
   "s": 12.036,
   "e": 13.697
  },
  {
   "text": "com duzentos e cinquenta e sete atletas.",
   "s": 13.968,
   "e": 15.873
  },
  {
   "text": "Aquele evento valeu vaga para as Olimp\u00edadas de T\u00f3quio,",
   "s": 16.722,
   "e": 19.17
  },
  {
   "text": "e as praias viraram manchete.",
   "s": 19.517,
   "e": 20.996
  },
  {
   "text": "Em dois mil e vinte e tr\u00eas,",
   "s": 21.855,
   "e": 22.916
  },
  {
   "text": "vieram duzentos e noventa e quatro competidores,",
   "s": 23.125,
   "e": 25.39
  },
  {
   "text": "de olho em Paris.",
   "s": 25.58,
   "e": 26.443
  },
  {
   "text": "O governo estimou quinhentos mil empregos em dez anos,",
   "s": 27.3,
   "e": 30.067
  },
  {
   "text": "mas \u00e9 uma proje\u00e7\u00e3o oficial,",
   "s": 30.328,
   "e": 31.753
  },
  {
   "text": "n\u00e3o uma auditoria.",
   "s": 31.981,
   "e": 32.875
  },
  {
   "text": "Cr\u00edticos dizem que as obras na costa preocupam moradores e ambientalistas.",
   "s": 33.721,
   "e": 37.51
  },
  {
   "text": "A Surf City dois leva o projeto para o leste do pa\u00eds.",
   "s": 38.356,
   "e": 41.189
  },
  {
   "text": "Em dois mil e vinte e cinco,",
   "s": 42.035,
   "e": 43.096
  },
  {
   "text": "o Mundial voltou a La Bocana e El Sunzal.",
   "s": 43.397,
   "e": 45.556
  },
  {
   "text": "Entre n\u00fameros otimistas e d\u00favidas,",
   "s": 46.396,
   "e": 48.096
  },
  {
   "text": "uma coisa \u00e9 certa:",
   "s": 48.359,
   "e": 49.306
  },
  {
   "text": "El Salvador virou assunto entre surfistas.",
   "s": 49.571,
   "e": 51.626
  }
 ]
