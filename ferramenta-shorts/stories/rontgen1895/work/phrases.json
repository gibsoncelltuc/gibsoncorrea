 "phrases": [
  {
   "text": "Um cientista tirou a primeira foto de dentro do corpo humano,",
   "s": 0.153,
   "e": 3.008
  },
  {
   "text": "e assustou a pr\u00f3pria esposa.",
   "s": 3.394,
   "e": 4.742
  },
  {
   "text": "Era mil oitocentos e noventa e cinco,",
   "s": 5.589,
   "e": 7.32
  },
  {
   "text": "numa cidade da Alemanha.",
   "s": 7.631,
   "e": 8.803
  },
  {
   "text": "Wilhelm R\u00f6ntgen passava as noites no laborat\u00f3rio,",
   "s": 9.639,
   "e": 11.951
  },
  {
   "text": "testando um tubo de vidro que soltava fa\u00edscas.",
   "s": 12.281,
   "e": 14.492
  },
  {
   "text": "Numa noite,",
   "s": 15.35,
   "e": 15.929
  },
  {
   "text": "ele cobriu o tubo com papel\u00e3o preto,",
   "s": 16.158,
   "e": 17.778
  },
  {
   "text": "e apagou a luz.",
   "s": 18.056,
   "e": 18.995
  },
  {
   "text": "Acontece que,",
   "s": 19.86,
   "e": 20.705
  },
  {
   "text": "do outro lado da sala,",
   "s": 20.965,
   "e": 22.129
  },
  {
   "text": "uma tela come\u00e7ou a brilhar no escuro.",
   "s": 22.39,
   "e": 24.166
  },
  {
   "text": "Ele p\u00f4s a m\u00e3o na frente do tubo,",
   "s": 25.022,
   "e": 26.6
  },
  {
   "text": "e viu os pr\u00f3prios ossos na tela.",
   "s": 26.962,
   "e": 28.609
  },
  {
   "text": "Duas semanas depois,",
   "s": 29.449,
   "e": 30.671
  },
  {
   "text": "ele chamou a esposa,",
   "s": 30.93,
   "e": 31.885
  },
  {
   "text": "Anna,",
   "s": 32.091,
   "e": 32.344
  },
  {
   "text": "e fotografou a m\u00e3o dela,",
   "s": 32.592,
   "e": 33.904
  },
  {
   "text": "com a alian\u00e7a.",
   "s": 34.143,
   "e": 34.742
  },
  {
   "text": "Dizem que ela olhou a chapa,",
   "s": 35.59,
   "e": 36.867
  },
  {
   "text": "e disse:",
   "s": 37.073,
   "e": 37.533
  },
  {
   "text": "\"Eu vi a minha morte.\"",
   "s": 37.774,
   "e": 38.712
  },
  {
   "text": "A not\u00edcia correu o mundo.",
   "s": 39.556,
   "e": 40.782
  },
  {
   "text": "Jornais,",
   "s": 41.629,
   "e": 42.231
  },
  {
   "text": "m\u00e9dicos e curiosos queriam ver o raio misterioso.",
   "s": 42.462,
   "e": 44.977
  },
  {
   "text": "Como ningu\u00e9m sabia o que era,",
   "s": 45.858,
   "e": 47.226
  },
  {
   "text": "ele chamou de raio X.",
   "s": 47.437,
   "e": 48.915
  },
  {
   "text": "X, de desconhecido.",
   "s": 49.103,
   "e": 49.972
  },
  {
   "text": "Em mil novecentos e um,",
   "s": 50.807,
   "e": 51.914
  },
  {
   "text": "R\u00f6ntgen ganhou o primeiro Pr\u00eamio Nobel de F\u00edsica da hist\u00f3ria.",
   "s": 52.162,
   "e": 54.718
  },
  {
   "text": "E nunca quis patentear a descoberta.",
   "s": 55.566,
   "e": 57.447
  },
  {
   "text": "O raio X era de todo mundo.",
   "s": 58.304,
   "e": 59.872
  }
 ]
}