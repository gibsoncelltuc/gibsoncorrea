 "phrases": [
  {
   "text": "Um cientista tirou a primeira foto de dentro do corpo humano,",
   "s": 0.153,
   "e": 3.008
  },
  {
   "text": "e assustou a pr\u00f3pria esposa.",
   "s": 3.394,
   "e": 4.742
  },
  {
   "text": "Era mil oitocentos e noventa e cinco,",
   "s": 5.589,
   "e": 7.32
  },
  {
   "text": "numa cidade da Alemanha.",
   "s": 7.631,
   "e": 8.803
  },
  {
   "text": "Wilhelm R\u00f6ntgen passava as noites no laborat\u00f3rio,",
   "s": 9.639,
   "e": 11.951
  },
  {
   "text": "testando um tubo de vidro que soltava fa\u00edscas.",
   "s": 12.281,
   "e": 14.492
  },
  {
   "text": "Numa noite,",
   "s": 15.35,
   "e": 15.929
  },
  {
   "text": "ele cobriu o tubo com papel\u00e3o preto,",
   "s": 16.158,
   "e": 17.778
  },
  {
   "text": "e apagou a luz.",
   "s": 18.056,
   "e": 18.995
  },
  {
   "text": "Acontece que,",
   "s": 19.86,
   "e": 20.705
  },
  {
   "text": "do outro lado da sala,",
   "s": 20.965,
   "e": 22.129
  },
  {
   "text": "uma tela come\u00e7ou a brilhar no escuro.",
   "s": 22.39,
   "e": 24.166
  },
  {
   "text": "Ele p\u00f4s a m\u00e3o na frente do tubo,",
   "s": 25.022,
   "e": 26.6
  },
  {
   "text": "e viu os pr\u00f3prios ossos na tela.",
   "s": 26.962,
   "e": 28.609
  },
  {
   "text": "Duas semanas depois,",
   "s": 29.449,
   "e": 30.674
  },
  {
   "text": "ele chamou a esposa,",
   "s": 30.93,
   "e": 31.885
  },
  {
   "text": "Anna,",
   "s": 32.091,
   "e": 32.344
  },
  {
   "text": "e fotografou a m\u00e3o dela,",
   "s": 32.592,
   "e": 33.904
  },
  {
   "text": "com a alian\u00e7a.",
   "s": 34.143,
   "e": 34.742
  },
  {
   "text": "Conta-se que ela olhou a chapa e disse que tinha visto a pr\u00f3pria morte.",
   "s": 35.6,
   "e": 38.63
  },
  {
   "text": "A not\u00edcia correu o mundo,",
   "s": 39.49,
   "e": 40.682
  },
  {
   "text": "e m\u00e9dicos e curiosos queriam ver o raio misterioso.",
   "s": 41.036,
   "e": 43.59
  },
  {
   "text": "Sem saber o que era,",
   "s": 44.454,
   "e": 45.519
  },
  {
   "text": "ele chamou de raio X:",
   "s": 45.788,
   "e": 47.015
  },
  {
   "text": "X,",
   "s": 47.242,
   "e": 47.641
  },
  {
   "text": "de desconhecido.",
   "s": 47.865,
   "e": 48.729
  },
  {
   "text": "Em mil novecentos e um,",
   "s": 49.573,
   "e": 50.657
  },
  {
   "text": "R\u00f6ntgen ganhou o primeiro Nobel de F\u00edsica,",
   "s": 50.917,
   "e": 52.701
  },
  {
   "text": "e nunca patenteou a descoberta.",
   "s": 52.968,
   "e": 54.615
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 55.45,
   "e": 56.895
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 57.187,
   "e": 58.949
  }
 ]
}