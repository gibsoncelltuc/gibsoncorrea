 "phrases": [
  {
   "text": "Durante vinte e quatro anos,",
   "s": 0.151,
   "e": 1.452
  },
  {
   "text": "um peda\u00e7o do Brasil foi holand\u00eas.",
   "s": 1.77,
   "e": 3.545
  },
  {
   "text": "E se eles nunca tivessem sa\u00eddo?",
   "s": 4.396,
   "e": 6.043
  },
  {
   "text": "Em mil seiscentos e trinta,",
   "s": 6.885,
   "e": 8.158
  },
  {
   "text": "navios holandeses tomaram Pernambuco,",
   "s": 8.42,
   "e": 10.28
  },
  {
   "text": "atr\u00e1s do a\u00e7\u00facar mais valioso do mundo.",
   "s": 10.61,
   "e": 12.633
  },
  {
   "text": "O governador Maur\u00edcio de Nassau trouxe pintores,",
   "s": 13.486,
   "e": 15.861
  },
  {
   "text": "cientistas e engenheiros para Recife.",
   "s": 16.08,
   "e": 17.994
  },
  {
   "text": "Construiu uma das primeiras grandes pontes do Brasil,",
   "s": 18.862,
   "e": 21.382
  },
  {
   "text": "e a cidade ganhou a primeira sinagoga das Am\u00e9ricas.",
   "s": 21.739,
   "e": 24.141
  },
  {
   "text": "Acontece que portugueses,",
   "s": 25.005,
   "e": 26.436
  },
  {
   "text": "ind\u00edgenas,",
   "s": 26.641,
   "e": 27.285
  },
  {
   "text": "africanos e colonos se uniram,",
   "s": 27.518,
   "e": 29.012
  },
  {
   "text": "e venceram as batalhas dos Guararapes.",
   "s": 29.374,
   "e": 31.329
  },
  {
   "text": "Em mil seiscentos e cinquenta e quatro,",
   "s": 32.189,
   "e": 33.807
  },
  {
   "text": "os holandeses foram embora de vez.",
   "s": 34.074,
   "e": 35.83
  },
  {
   "text": "E se tivessem ficado?",
   "s": 36.687,
   "e": 37.8
  },
  {
   "text": "Talvez o Nordeste fosse hoje outro pa\u00eds,",
   "s": 38.644,
   "e": 40.838
  },
  {
   "text": "falando holand\u00eas.",
   "s": 41.102,
   "e": 42.02
  },
  {
   "text": "Isso n\u00e3o \u00e9 t\u00e3o maluco:",
   "s": 42.88,
   "e": 43.996
  },
  {
   "text": "o Suriname,",
   "s": 44.373,
   "e": 44.951
  },
  {
   "text": "aqui do lado do Brasil,",
   "s": 45.211,
   "e": 46.369
  },
  {
   "text": "foi col\u00f4nia holandesa e fala holand\u00eas at\u00e9 hoje.",
   "s": 46.664,
   "e": 48.937
  },
  {
   "text": "E mais:",
   "s": 49.807,
   "e": 50.276
  },
  {
   "text": "em mil seiscentos e sessenta e sete,",
   "s": 50.479,
   "e": 52.085
  },
  {
   "text": "a Holanda trocou com os ingleses.",
   "s": 52.294,
   "e": 53.939
  },
  {
   "text": "Ficou com o Suriname,",
   "s": 54.861,
   "e": 55.873
  },
  {
   "text": "e entregou a vila de Nova Amsterd\u00e3.",
   "s": 56.133,
   "e": 57.939
  },
  {
   "text": "Essa vila hoje se chama Nova York.",
   "s": 58.767,
   "e": 60.721
  },
  {
   "text": "Uma troca de terras,",
   "s": 61.585,
   "e": 62.669
  },
  {
   "text": "e o mapa do mundo podia ser completamente diferente.",
   "s": 62.92,
   "e": 65.474
  }
 ]
