 "phrases": [
  {
   "text": "Uma picape blindada teve as janelas quebradas ao vivo,",
   "s": 0.16,
   "e": 2.784
  },
  {
   "text": "no pr\u00f3prio lan\u00e7amento.",
   "s": 3.029,
   "e": 4.082
  },
  {
   "text": "Foi em novembro de dois mil e dezenove,",
   "s": 5.006,
   "e": 6.593
  },
  {
   "text": "na Calif\u00f3rnia.",
   "s": 6.758,
   "e": 7.459
  },
  {
   "text": "A Tesla apresentava o Cybertruck,",
   "s": 8.309,
   "e": 9.817
  },
  {
   "text": "e Musk garantiu que o vidro era super resistente.",
   "s": 10.187,
   "e": 12.7
  },
  {
   "text": "Para provar,",
   "s": 13.577,
   "e": 14.164
  },
  {
   "text": "o designer Franz von Holzhausen jogou uma esfera de a\u00e7o na janela.",
   "s": 14.36,
   "e": 17.608
  },
  {
   "text": "Acontece que o vidro rachou,",
   "s": 18.441,
   "e": 19.985
  },
  {
   "text": "ao vivo,",
   "s": 20.171,
   "e": 20.621
  },
  {
   "text": "na frente de toda a plateia.",
   "s": 20.845,
   "e": 22.219
  },
  {
   "text": "Ele tentou de novo,",
   "s": 23.089,
   "e": 24.065
  },
  {
   "text": "em outra janela,",
   "s": 24.312,
   "e": 25.125
  },
  {
   "text": "e ela tamb\u00e9m rachou.",
   "s": 25.361,
   "e": 26.398
  },
  {
   "text": "Musk brincou:",
   "s": 27.27,
   "e": 28.015
  },
  {
   "text": "pelo menos a bola n\u00e3o atravessou.",
   "s": 28.374,
   "e": 30.04
  },
  {
   "text": "Depois,",
   "s": 30.91,
   "e": 31.453
  },
  {
   "text": "Musk explicou na internet que,",
   "s": 31.693,
   "e": 33.31
  },
  {
   "text": "nos ensaios,",
   "s": 33.501,
   "e": 34.245
  },
  {
   "text": "a mesma esfera tinha batido na mesma janela sem nem arranhar.",
   "s": 34.418,
   "e": 37.336
  },
  {
   "text": "A plateia riu,",
   "s": 38.138,
   "e": 38.92
  },
  {
   "text": "a internet tamb\u00e9m,",
   "s": 39.096,
   "e": 40.096
  },
  {
   "text": "e a cena deu o que falar no mundo inteiro.",
   "s": 40.407,
   "e": 42.317
  },
  {
   "text": "Mesmo assim,",
   "s": 43.179,
   "e": 43.829
  },
  {
   "text": "poucos dias depois,",
   "s": 44.101,
   "e": 45.156
  },
  {
   "text": "Musk anunciou mais de cento e quarenta mil reservas da picape.",
   "s": 45.4,
   "e": 48.477
  },
  {
   "text": "Uma picape,",
   "s": 49.337,
   "e": 49.957
  },
  {
   "text": "uma esfera de a\u00e7o e uma janela que n\u00e3o aguentou:",
   "s": 50.11,
   "e": 52.318
  },
  {
   "text": "um lan\u00e7amento inesquec\u00edvel.",
   "s": 52.602,
   "e": 53.908
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 54.767,
   "e": 56.217
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 56.507,
   "e": 58.269
  }
 ]
