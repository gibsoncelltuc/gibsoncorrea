 "phrases": [
  {
   "text": "Durante d\u00e9cadas,",
   "s": 0.159,
   "e": 1.01
  },
  {
   "text": "todo foguete era jogado fora depois de um voo.",
   "s": 1.221,
   "e": 3.569
  },
  {
   "text": "At\u00e9 que um desceu de r\u00e9.",
   "s": 4.414,
   "e": 5.67
  },
  {
   "text": "Foi em dezembro de dois mil e quinze,",
   "s": 6.576,
   "e": 8.031
  },
  {
   "text": "no Cabo Canaveral,",
   "s": 8.242,
   "e": 9.182
  },
  {
   "text": "na Fl\u00f3rida.",
   "s": 9.379,
   "e": 9.98
  },
  {
   "text": "Elon Musk queria reaproveitar foguetes,",
   "s": 10.819,
   "e": 12.927
  },
  {
   "text": "em vez de jog\u00e1-los fora.",
   "s": 13.109,
   "e": 14.374
  },
  {
   "text": "Muitos achavam imposs\u00edvel.",
   "s": 15.237,
   "e": 16.634
  },
  {
   "text": "As primeiras tentativas de pouso deram errado,",
   "s": 17.527,
   "e": 19.701
  },
  {
   "text": "e os foguetes tombaram no mar.",
   "s": 19.984,
   "e": 21.357
  },
  {
   "text": "Em vinte e um de dezembro,",
   "s": 22.149,
   "e": 23.222
  },
  {
   "text": "o Falcon nove decolou com onze sat\u00e9lites.",
   "s": 23.462,
   "e": 25.758
  },
  {
   "text": "Depois de soltar o topo,",
   "s": 26.612,
   "e": 27.906
  },
  {
   "text": "a parte de baixo voltou para a Terra.",
   "s": 28.151,
   "e": 29.966
  },
  {
   "text": "Acontece que ela desceu de r\u00e9,",
   "s": 30.811,
   "e": 32.331
  },
  {
   "text": "de p\u00e9,",
   "s": 32.529,
   "e": 32.931
  },
  {
   "text": "com o motor aceso freando a queda.",
   "s": 33.314,
   "e": 34.831
  },
  {
   "text": "E pousou inteira,",
   "s": 35.7,
   "e": 36.608
  },
  {
   "text": "abrindo as pernas no \u00faltimo segundo.",
   "s": 36.84,
   "e": 38.618
  },
  {
   "text": "Os funcion\u00e1rios da SpaceX comemoraram e se abra\u00e7aram.",
   "s": 39.489,
   "e": 42.307
  },
  {
   "text": "Foi a primeira vez que o primeiro est\u00e1gio de um foguete orbital voltou e pousou inteiro.",
   "s": 43.221,
   "e": 47.112
  },
  {
   "text": "Hoje,",
   "s": 47.946,
   "e": 48.296
  },
  {
   "text": "pousar de r\u00e9 virou rotina.",
   "s": 48.521,
   "e": 49.898
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 50.757,
   "e": 52.2
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
