 "phrases": [
  {
   "text": "Um cientista misturou as etiquetas de uns passarinhos,",
   "s": 0.149,
   "e": 2.676
  },
  {
   "text": "e isso explicou a vida na Terra.",
   "s": 2.888,
   "e": 4.363
  },
  {
   "text": "Em mil oitocentos e trinta e cinco,",
   "s": 5.217,
   "e": 6.794
  },
  {
   "text": "Charles Darwin chegou \u00e0s ilhas Gal\u00e1pagos,",
   "s": 7.056,
   "e": 9.018
  },
  {
   "text": "no navio Beagle.",
   "s": 9.233,
   "e": 9.965
  },
  {
   "text": "Coletou bichos,",
   "s": 10.831,
   "e": 11.701
  },
  {
   "text": "plantas e uns passarinhos pequenos,",
   "s": 11.981,
   "e": 13.538
  },
  {
   "text": "de ilha em ilha.",
   "s": 13.736,
   "e": 14.467
  },
  {
   "text": "A viagem do Beagle durou quase cinco anos,",
   "s": 15.327,
   "e": 17.613
  },
  {
   "text": "dando a volta ao mundo.",
   "s": 17.785,
   "e": 18.733
  },
  {
   "text": "Achou que eram aves bem diferentes,",
   "s": 19.588,
   "e": 21.492
  },
  {
   "text": "e nem anotou de que ilha vinha cada uma.",
   "s": 21.793,
   "e": 23.542
  },
  {
   "text": "Em Londres,",
   "s": 24.384,
   "e": 24.92
  },
  {
   "text": "o especialista John Gould revelou:",
   "s": 25.141,
   "e": 26.77
  },
  {
   "text": "eram todos tentilh\u00f5es,",
   "s": 27.057,
   "e": 28.273
  },
  {
   "text": "de esp\u00e9cies diferentes.",
   "s": 28.463,
   "e": 29.665
  },
  {
   "text": "A diferen\u00e7a estava no bico:",
   "s": 30.515,
   "e": 31.856
  },
  {
   "text": "uns grossos para quebrar sementes,",
   "s": 32.227,
   "e": 33.869
  },
  {
   "text": "outros finos para pegar insetos.",
   "s": 34.134,
   "e": 35.855
  },
  {
   "text": "Acontece que,",
   "s": 36.706,
   "e": 37.559
  },
  {
   "text": "em cada ilha,",
   "s": 37.761,
   "e": 38.44
  },
  {
   "text": "o bico tinha mudado de acordo com a comida.",
   "s": 38.729,
   "e": 40.754
  },
  {
   "text": "Os bichos com o bico certo sobreviviam melhor,",
   "s": 41.604,
   "e": 44.009
  },
  {
   "text": "e passavam isso para os filhos.",
   "s": 44.303,
   "e": 45.771
  },
  {
   "text": "Essa ideia virou a sele\u00e7\u00e3o natural,",
   "s": 46.63,
   "e": 48.289
  },
  {
   "text": "publicada em mil oitocentos e cinquenta e nove.",
   "s": 48.594,
   "e": 50.634
  },
  {
   "text": "No fim,",
   "s": 51.519,
   "e": 51.926
  },
  {
   "text": "o erro das etiquetas virou um acerto de bico.",
   "s": 52.221,
   "e": 54.446
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 55.291,
   "e": 56.736
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 57.028,
   "e": 58.79
  }
 ]
}