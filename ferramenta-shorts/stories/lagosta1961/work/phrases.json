 "phrases": [
  {
   "text": "Voc\u00ea acha que guerra \u00e9 por petr\u00f3leo?",
   "s": 0.155,
   "e": 1.863
  },
  {
   "text": "O Brasil quase brigou por lagosta.",
   "s": 2.701,
   "e": 4.446
  },
  {
   "text": "E a briga dependia de uma pergunta:",
   "s": 5.289,
   "e": 8.419
  },
  {
   "text": "a lagosta anda ou nada?",
   "s": 9.259,
   "e": 10.669
  },
  {
   "text": "Em 1961, barcos franceses pescavam lagosta na costa de Pernambuco.",
   "s": 10.958,
   "e": 13.877
  },
  {
   "text": "O Brasil dizia:",
   "s": 14.741,
   "e": 15.647
  },
  {
   "text": "lagosta anda no fundo do mar,",
   "s": 15.886,
   "e": 17.361
  },
  {
   "text": "\u00e9 nossa.",
   "s": 17.572,
   "e": 18.027
  },
  {
   "text": "A Fran\u00e7a respondia:",
   "s": 18.902,
   "e": 19.989
  },
  {
   "text": "lagosta nada,",
   "s": 20.239,
   "e": 20.963
  },
  {
   "text": "\u00e9 de quem pescar.",
   "s": 21.208,
   "e": 22.075
  },
  {
   "text": "A Fran\u00e7a mandou um navio de guerra para a costa.",
   "s": 22.89,
   "e": 25.159
  },
  {
   "text": "Acontece que o Brasil n\u00e3o recuou e mandou navios e avi\u00f5es.",
   "s": 26.021,
   "e": 29.185
  },
  {
   "text": "Mas o tiro nunca veio.",
   "s": 30.041,
   "e": 31.254
  },
  {
   "text": "Os dois governos fizeram um acordo.",
   "s": 32.105,
   "e": 33.894
  },
  {
   "text": "No fim,",
   "s": 34.726,
   "e": 35.136
  },
  {
   "text": "alguns barcos franceses puderam pescar,",
   "s": 35.363,
   "e": 37.426
  },
  {
   "text": "com limite.",
   "s": 37.672,
   "e": 38.224
  },
  {
   "text": "Petr\u00f3leo,",
   "s": 39.103,
   "e": 39.544
  },
  {
   "text": "ouro,",
   "s": 39.864,
   "e": 40.12
  },
  {
   "text": "terra?",
   "s": 40.429,
   "e": 40.697
  },
  {
   "text": "Aqui,",
   "s": 41.561,
   "e": 41.9
  },
  {
   "text": "o motivo foi uma lagosta.",
   "s": 42.142,
   "e": 43.434
  }
 ]
