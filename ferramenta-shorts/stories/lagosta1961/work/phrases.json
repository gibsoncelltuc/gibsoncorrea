 "phrases": [
  {
   "text": "A Fran\u00e7a e o Brasil quase entraram em guerra por causa de uma lagosta.",
   "s": 0.167,
   "e": 3.423
  },
  {
   "text": "Era mil novecentos e sessenta e um.",
   "s": 4.272,
   "e": 6.02
  },
  {
   "text": "Barcos franceses pescavam lagostas na costa de Pernambuco,",
   "s": 6.878,
   "e": 9.794
  },
  {
   "text": "e os pescadores brasileiros n\u00e3o gostaram.",
   "s": 10.12,
   "e": 12.066
  },
  {
   "text": "O Brasil dizia:",
   "s": 12.931,
   "e": 13.838
  },
  {
   "text": "\"Lagosta anda no fundo do mar,",
   "s": 14.091,
   "e": 15.571
  },
  {
   "text": "ent\u00e3o \u00e9 nossa.\"",
   "s": 15.796,
   "e": 16.564
  },
  {
   "text": "A Fran\u00e7a respondia:",
   "s": 17.43,
   "e": 18.54
  },
  {
   "text": "\"Lagosta nada,",
   "s": 18.766,
   "e": 19.541
  },
  {
   "text": "ent\u00e3o \u00e9 de todo mundo.\"",
   "s": 19.746,
   "e": 20.867
  },
  {
   "text": "A discuss\u00e3o esquentou,",
   "s": 21.735,
   "e": 22.834
  },
  {
   "text": "e a Fran\u00e7a mandou um navio de guerra para proteger os pescadores dela.",
   "s": 23.129,
   "e": 26.419
  },
  {
   "text": "Acontece que o Brasil n\u00e3o recuou.",
   "s": 27.261,
   "e": 29.128
  },
  {
   "text": "Mandou navios e avi\u00f5es para a costa,",
   "s": 29.986,
   "e": 31.907
  },
  {
   "text": "e a tens\u00e3o subiu.",
   "s": 32.109,
   "e": 33.067
  },
  {
   "text": "Marinheiros dos dois lados se encararam no mar,",
   "s": 33.922,
   "e": 36.233
  },
  {
   "text": "e todo mundo esperou o primeiro tiro.",
   "s": 36.508,
   "e": 38.223
  },
  {
   "text": "Mas o tiro nunca veio.",
   "s": 39.075,
   "e": 40.288
  },
  {
   "text": "Os dois governos se reuniram e conversaram,",
   "s": 41.142,
   "e": 43.269
  },
  {
   "text": "em vez de brigar.",
   "s": 43.502,
   "e": 44.344
  },
  {
   "text": "Em mil novecentos e sessenta e tr\u00eas,",
   "s": 45.164,
   "e": 46.8
  },
  {
   "text": "fecharam um acordo:",
   "s": 47.047,
   "e": 47.937
  },
  {
   "text": "alguns barcos franceses podiam pescar,",
   "s": 48.229,
   "e": 50.299
  },
  {
   "text": "com limite.",
   "s": 50.538,
   "e": 51.095
  },
  {
   "text": "No fim,",
   "s": 51.962,
   "e": 52.364
  },
  {
   "text": "ningu\u00e9m perguntou para a lagosta de que lado ela queria ficar.",
   "s": 52.594,
   "e": 55.421
  }
 ]
