 "phrases": [
  {
   "text": "Roma inteira foi salva por um bando de gansos barulhentos.",
   "s": 0.2,
   "e": 3.047
  },
  {
   "text": "Os gauleses tinham invadido a cidade,",
   "s": 3.906,
   "e": 5.713
  },
  {
   "text": "e queimado quase tudo.",
   "s": 5.931,
   "e": 7.112
  },
  {
   "text": "Quem n\u00e3o escapou,",
   "s": 7.979,
   "e": 8.79
  },
  {
   "text": "tombou.",
   "s": 9.057,
   "e": 9.381
  },
  {
   "text": "Os romanos que sobraram se trancaram no Capit\u00f3lio,",
   "s": 10.251,
   "e": 12.558
  },
  {
   "text": "uma colina cercada de muralhas,",
   "s": 12.857,
   "e": 14.456
  },
  {
   "text": "sem comida,",
   "s": 14.662,
   "e": 15.271
  },
  {
   "text": "e sem sa\u00edda.",
   "s": 15.489,
   "e": 16.255
  },
  {
   "text": "L\u00e1 em cima,",
   "s": 17.088,
   "e": 17.797
  },
  {
   "text": "a fome apertava.",
   "s": 18.013,
   "e": 18.939
  },
  {
   "text": "\"Vamos comer os gansos\",",
   "s": 19.783,
   "e": 20.926
  },
  {
   "text": "pediu um soldado.",
   "s": 21.189,
   "e": 21.942
  },
  {
   "text": "\"S\u00e3o sagrados\",",
   "s": 22.811,
   "e": 23.634
  },
  {
   "text": "respondeu o sacerdote.",
   "s": 23.904,
   "e": 25.084
  },
  {
   "text": "Numa noite sem lua,",
   "s": 25.941,
   "e": 27.008
  },
  {
   "text": "os gauleses escalaram a colina em sil\u00eancio.",
   "s": 27.241,
   "e": 29.337
  },
  {
   "text": "Os guardas dormiam.",
   "s": 30.195,
   "e": 31.25
  },
  {
   "text": "Ningu\u00e9m ouviu nada.",
   "s": 32.131,
   "e": 33.241
  },
  {
   "text": "Acontece que os gansos acordaram,",
   "s": 34.086,
   "e": 35.733
  },
  {
   "text": "e come\u00e7aram a gritar e a bater as asas.",
   "s": 36.086,
   "e": 38.142
  },
  {
   "text": "Um soldado chamado M\u00e2nlio pulou da cama,",
   "s": 38.992,
   "e": 40.932
  },
  {
   "text": "e derrubou o primeiro invasor muralha abaixo.",
   "s": 41.221,
   "e": 43.228
  },
  {
   "text": "O gaul\u00eas tombou,",
   "s": 44.061,
   "e": 44.988
  },
  {
   "text": "levando os outros junto.",
   "s": 45.253,
   "e": 46.444
  },
  {
   "text": "O alarme acordou todo mundo,",
   "s": 47.295,
   "e": 48.817
  },
  {
   "text": "os romanos correram para a muralha,",
   "s": 49.086,
   "e": 50.605
  },
  {
   "text": "e o ataque fracassou.",
   "s": 50.852,
   "e": 52.002
  },
  {
   "text": "Desde ent\u00e3o,",
   "s": 52.863,
   "e": 53.514
  },
  {
   "text": "todo ano,",
   "s": 53.723,
   "e": 54.27
  },
  {
   "text": "os gansos ganhavam um desfile pelas ruas de Roma.",
   "s": 54.593,
   "e": 57.036
  },
  {
   "text": "E os guardas,",
   "s": 57.9,
   "e": 58.643
  },
  {
   "text": "que dormiram a noite inteira,",
   "s": 58.853,
   "e": 60.127
  },
  {
   "text": "levaram um castigo.",
   "s": 60.357,
   "e": 61.329
  }
 ]
