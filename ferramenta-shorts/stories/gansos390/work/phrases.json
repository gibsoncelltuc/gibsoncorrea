 "phrases": [
  {
   "text": "Um bando de gansos barulhentos salvou Roma numa s\u00f3 noite.",
   "s": 0.148,
   "e": 3.202
  },
  {
   "text": "Em trezentos e noventa antes de Cristo,",
   "s": 4.066,
   "e": 5.902
  },
  {
   "text": "os gauleses de Breno tomaram Roma e queimaram quase tudo.",
   "s": 6.213,
   "e": 9.065
  },
  {
   "text": "Os romanos que sobraram se trancaram no Capit\u00f3lio,",
   "s": 9.922,
   "e": 12.163
  },
  {
   "text": "uma colina fortificada.",
   "s": 12.442,
   "e": 13.67
  },
  {
   "text": "Os gauleses cercaram a colina,",
   "s": 14.492,
   "e": 16.052
  },
  {
   "text": "e a fome apertou os dois lados.",
   "s": 16.328,
   "e": 17.988
  },
  {
   "text": "Numa noite sem lua,",
   "s": 18.84,
   "e": 19.901
  },
  {
   "text": "eles tentaram escalar em sil\u00eancio,",
   "s": 20.133,
   "e": 21.605
  },
  {
   "text": "e os guardas n\u00e3o ouviram nada.",
   "s": 22.001,
   "e": 23.54
  },
  {
   "text": "Acontece que os gansos sagrados da deusa Juno ouviram,",
   "s": 24.407,
   "e": 26.99
  },
  {
   "text": "e come\u00e7aram a gritar e a bater as asas.",
   "s": 27.348,
   "e": 29.389
  },
  {
   "text": "O barulho acordou o soldado Marco M\u00e2nlio,",
   "s": 30.249,
   "e": 32.209
  },
  {
   "text": "que foi at\u00e9 a muralha e impediu a subida dos gauleses.",
   "s": 32.51,
   "e": 35.158
  },
  {
   "text": "A subida fracassou,",
   "s": 36.023,
   "e": 37.108
  },
  {
   "text": "mas os gauleses mantiveram o cerco.",
   "s": 37.359,
   "e": 39.114
  },
  {
   "text": "No fim,",
   "s": 39.952,
   "e": 40.345
  },
  {
   "text": "depois de sete meses com fome,",
   "s": 40.546,
   "e": 42.172
  },
  {
   "text": "Roma pagou mil libras de ouro,",
   "s": 42.455,
   "e": 43.812
  },
  {
   "text": "e os gauleses foram embora.",
   "s": 44.131,
   "e": 45.476
  },
  {
   "text": "Os gansos salvaram a colina,",
   "s": 46.311,
   "e": 47.724
  },
  {
   "text": "mas o ouro foi embora do mesmo jeito.",
   "s": 47.964,
   "e": 49.861
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 50.711,
   "e": 52.156
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 52.448,
   "e": 54.211
  }
 ]
}