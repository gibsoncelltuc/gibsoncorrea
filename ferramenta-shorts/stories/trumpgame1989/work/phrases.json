 "phrases": [
  {
   "text": "Donald Trump lan\u00e7ou um jogo de tabuleiro com o pr\u00f3prio rosto no dinheiro.",
   "s": 0.158,
   "e": 3.617
  },
  {
   "text": "Era mil novecentos e oitenta e nove,",
   "s": 4.463,
   "e": 6.055
  },
  {
   "text": "e ele era um empres\u00e1rio famoso de Nova York.",
   "s": 6.377,
   "e": 8.477
  },
  {
   "text": "Uma f\u00e1brica de brinquedos fez o jogo:",
   "s": 9.341,
   "e": 11.132
  },
  {
   "text": "comprar pr\u00e9dios,",
   "s": 11.528,
   "e": 12.364
  },
  {
   "text": "cassinos e hot\u00e9is at\u00e9 ficar o mais rico.",
   "s": 12.58,
   "e": 14.595
  },
  {
   "text": "As notas eram de dez,",
   "s": 15.454,
   "e": 16.786
  },
  {
   "text": "cinquenta e cem milh\u00f5es de d\u00f3lares,",
   "s": 16.984,
   "e": 18.567
  },
  {
   "text": "com a cara do Trump.",
   "s": 18.846,
   "e": 19.727
  },
  {
   "text": "O pr\u00f3prio Trump apareceu no comercial de TV,",
   "s": 20.593,
   "e": 22.94
  },
  {
   "text": "segurando a caixa do jogo.",
   "s": 23.183,
   "e": 24.494
  },
  {
   "text": "Acontece que o manual era longo,",
   "s": 25.355,
   "e": 26.942
  },
  {
   "text": "e as fam\u00edlias abriam a caixa e n\u00e3o entendiam nada.",
   "s": 27.226,
   "e": 29.501
  },
  {
   "text": "A f\u00e1brica esperava vender dois milh\u00f5es de jogos,",
   "s": 30.338,
   "e": 32.851
  },
  {
   "text": "e vendeu oitocentos mil.",
   "s": 33.103,
   "e": 34.385
  },
  {
   "text": "Em dois mil e quatro,",
   "s": 35.251,
   "e": 36.096
  },
  {
   "text": "Trump virou estrela do programa O Aprendiz.",
