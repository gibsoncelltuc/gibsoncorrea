 "phrases": [
  {
   "text": "Um foguete de Elon Musk levou sessenta sat\u00e9lites de uma vez.",
   "s": 0.155,
   "e": 3.356
  },
  {
   "text": "E,",
   "s": 4.208,
   "e": 4.35
  },
  {
   "text": "dias depois,",
   "s": 4.606,
   "e": 5.336
  },
  {
   "text": "o c\u00e9u ficou estranho.",
   "s": 5.575,
   "e": 6.617
  },
  {
   "text": "Foi em maio de dois mil e dezenove,",
   "s": 7.542,
   "e": 8.996
  },
  {
   "text": "na Fl\u00f3rida.",
   "s": 9.214,
   "e": 9.864
  },
  {
   "text": "O projeto se chama Starlink.",
   "s": 10.697,
   "e": 12.184
  },
  {
   "text": "A ideia:",
   "s": 13.049,
   "e": 13.555
  },
  {
   "text": "milhares de sat\u00e9lites voando baixo,",
   "s": 13.818,
   "e": 15.676
  },
  {
   "text": "levando internet a qualquer canto da Terra.",
   "s": 15.897,
   "e": 17.987
  },
  {
   "text": "O Falcon Nove decolou com os sat\u00e9lites empilhados,",
   "s": 18.86,
   "e": 21.311
  },
  {
   "text": "como pratos.",
   "s": 21.525,
   "e": 22.236
  },
  {
   "text": "Acontece que,",
   "s": 23.11,
   "e": 23.942
  },
  {
   "text": "noites depois,",
   "s": 24.147,
   "e": 24.955
  },
  {
   "text": "surgiu no c\u00e9u uma fila de luzes em linha reta.",
   "s": 25.186,
   "e": 27.504
  },
  {
   "text": "Muita gente achou que era disco voador.",
   "s": 28.371,
   "e": 30.248
  },
  {
   "text": "Um astr\u00f4nomo explicou:",
   "s": 31.046,
   "e": 32.103
  },
  {
   "text": "eram os sat\u00e9lites,",
   "s": 32.486,
   "e": 33.408
  },
  {
   "text": "ainda juntinhos,",
   "s": 33.659,
   "e": 34.524
  },
  {
   "text": "brilhando com o sol.",
   "s": 34.671,
   "e": 35.634
  },
  {
   "text": "Para usar,",
   "s": 36.519,
   "e": 37.014
  },
  {
   "text": "basta uma antena do tamanho de uma caixa de pizza,",
   "s": 37.151,
   "e": 39.445
  },
  {
   "text": "apontada para o c\u00e9u.",
   "s": 39.615,
   "e": 40.661
  },
  {
   "text": "Em dois mil e vinte e dois,",
   "s": 41.516,
   "e": 42.493
  },
  {
   "text": "uma tempestade solar derrubou quase quarenta sat\u00e9lites novos.",
   "s": 42.76,
   "e": 46.049
  },
  {
   "text": "Ca\u00edram e queimaram no ar.",
   "s": 46.912,
   "e": 48.067
  },
  {
   "text": "No mesmo ano,",
   "s": 48.884,
   "e": 49.617
  },
  {
   "text": "a antena chegou ao Brasil,",
   "s": 49.814,
   "e": 51.079
  },
  {
   "text": "at\u00e9 em escolas no meio da Amaz\u00f4nia.",
   "s": 51.337,
   "e": 52.963
  },
  {
   "text": "Hoje s\u00e3o mais de sete mil sat\u00e9lites Starlink.",
   "s": 53.838,
   "e": 56.227
  },
  {
   "text": "A maior frota da hist\u00f3ria.",
   "s": 57.096,
   "e": 58.367
  },
  {
   "text": "Ent\u00e3o,",
   "s": 59.221,
   "e": 59.629
  },
  {
   "text": "se voc\u00ea vir uma fila de luzes no c\u00e9u,",
   "s": 59.881,
   "e": 61.797
  },
  {
   "text": "calma.",
   "s": 62.105,
   "e": 62.402
  },
  {
   "text": "Pode ser a internet passando.",
   "s": 63.289,
   "e": 64.786
  },
  {
   "text": "Voc\u00ea j\u00e1 viu?",
   "s": 65.647,
   "e": 66.341
  }
 ]
