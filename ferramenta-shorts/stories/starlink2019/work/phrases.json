 "phrases": [
  {
   "text": "Em maio de dois mil e dezenove,",
   "s": 0.16,
   "e": 1.49
  },
  {
   "text": "a SpaceX lan\u00e7ou um foguete Falcon 9 com sessenta sat\u00e9lites de uma vez.",
   "s": 1.685,
   "e": 5.564
  },
  {
   "text": "O lan\u00e7amento foi em Cabo Canaveral,",
   "s": 6.421,
   "e": 8.169
  },
  {
   "text": "na Fl\u00f3rida,",
   "s": 8.401,
   "e": 9.026
  },
  {
   "text": "e eram os primeiros sat\u00e9lites do Starlink,",
   "s": 9.336,
   "e": 11.2
  },
  {
   "text": "a internet espacial.",
   "s": 11.465,
   "e": 12.603
  },
  {
   "text": "Um dia depois,",
   "s": 13.469,
   "e": 14.316
  },
  {
   "text": "um rastreador de sat\u00e9lites holand\u00eas,",
   "s": 14.588,
   "e": 16.488
  },
  {
   "text": "Marco Langbroek,",
   "s": 16.729,
   "e": 17.497
  },
  {
   "text": "filmou o c\u00e9u.",
   "s": 17.753,
   "e": 18.413
  },
  {
   "text": "Ele registrou uma fila de luzes,",
   "s": 19.284,
   "e": 20.88
  },
  {
   "text": "que levava cerca de tr\u00eas minutos para passar.",
   "s": 21.144,
   "e": 23.332
  },
  {
   "text": "Ele contou pelo menos cinquenta e seis objetos brilhando em linha.",
   "s": 24.125,
   "e": 27.138
  },
  {
   "text": "Acontece que o site holand\u00eas de avistamentos de OVNIs recebeu mais de cento e cinquenta relatos.",
   "s": 28.013,
   "e": 32.736
  },
  {
   "text": "Jornais de v\u00e1rios pa\u00edses explicaram que n\u00e3o eram OVNIs,",
   "s": 33.593,
   "e": 36.394
  },
  {
   "text": "e sim sat\u00e9lites.",
   "s": 36.565,
   "e": 37.558
  },
  {
   "text": "Os sat\u00e9lites ainda estavam juntos,",
   "s": 38.42,
   "e": 40.092
  },
  {
   "text": "em fila,",
   "s": 40.283,
   "e": 40.725
  },
  {
   "text": "logo depois do lan\u00e7amento.",
   "s": 40.951,
   "e": 42.255
  },
  {
   "text": "A imagem da fila de luzes se espalhou por v\u00e1rios pa\u00edses e virou assunto na internet.",
   "s": 43.109,
   "e": 47.215
  },
  {
   "text": "Moral da hist\u00f3ria:",
   "s": 48.082,
   "e": 48.881
  },
  {
   "text": "se olhar o c\u00e9u e vir uma fila de luzes,",
   "s": 49.109,
   "e": 51.023
  },
  {
   "text": "pode ser uma fila de sat\u00e9lites,",
   "s": 51.341,
   "e": 52.873
  },
  {
   "text": "e n\u00e3o alien\u00edgenas.",
   "s": 53.148,
   "e": 54.161
  }
 ]
