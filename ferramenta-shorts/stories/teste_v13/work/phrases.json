   "e": 7.782
  },
  {
   "text": "que empurram ele para cima.",
   "s": 8.01,
   "e": 9.337
  },
  {
   "text": "Diante dos convidados,",
   "s": 10.162,
   "e": 11.403
  },
  {
   "text": "o carro decolou e voou por cima da pista.",
   "s": 11.701,
   "e": 13.866
  },
  {
   "text": "Segundo a Tesla,",
   "s": 14.746,
   "e": 15.636
  },
  {
   "text": "ele vai de zero a cem em menos de um segundo.",
   "s": 15.829,
   "e": 17.758
  },
  {
   "text": "Depois o carro acelerou e pulou bem alto diante de todos.",
   "s": 18.625,
   "e": 21.712
  },
  {
   "text": "No fim ele desceu devagar e pousou no asfalto.",
