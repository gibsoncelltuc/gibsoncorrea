 "phrases": [
  {
   "text": "Um mofo esquecido no meio da bagun\u00e7a acabou salvando milh\u00f5es de vidas.",
   "s": 0.154,
   "e": 3.599
  },
  {
   "text": "Era mil novecentos e vinte e oito,",
   "s": 4.45,
   "e": 6.006
  },
  {
   "text": "em Londres,",
   "s": 6.28,
   "e": 6.863
  },
  {
   "text": "e Alexander Fleming era famoso pela mesa bagun\u00e7ada.",
   "s": 7.093,
   "e": 9.864
  },
  {
   "text": "Ele estudava bact\u00e9rias e deixava os pratos de cultura empilhados na bancada.",
   "s": 10.707,
   "e": 14.201
  },
  {
   "text": "Eram pratinhos de vidro com uma gelatina onde as bact\u00e9rias cresciam.",
   "s": 15.05,
   "e": 18.286
  },
  {
   "text": "Um dia,",
   "s": 19.151,
   "e": 19.619
  },
  {
   "text": "ele saiu de f\u00e9rias por um m\u00eas e n\u00e3o limpou nada.",
   "s": 19.825,
   "e": 22.162
  },
  {
   "text": "Quando voltou,",
   "s": 23.005,
   "e": 23.65
  },
  {
   "text": "achou um prato estragado,",
   "s": 23.899,
   "e": 25.116
  },
  {
   "text": "coberto de bolor verde.",
   "s": 25.347,
   "e": 26.655
  },
  {
   "text": "Ele ia jogar o prato fora,",
   "s": 27.485,
   "e": 28.854
  },
  {
   "text": "mas olhou melhor.",
   "s": 29.084,
   "e": 29.841
  },
  {
   "text": "Acontece que,",
   "s": 30.672,
   "e": 31.513
  },
  {
   "text": "em volta do mofo,",
   "s": 31.741,
   "e": 32.599
  },
  {
   "text": "as bact\u00e9rias tinham sumido.",
   "s": 32.852,
   "e": 34.223
  },
  {
   "text": "O mofo soltava algo que matava as bact\u00e9rias,",
   "s": 35.083,
   "e": 37.493
  },
  {
   "text": "e ele deu a isso o nome de penicilina.",
   "s": 37.711,
   "e": 39.49
  },
  {
   "text": "Anos depois,",
   "s": 40.356,
   "e": 41.055
  },
  {
   "text": "outros cientistas transformaram o bolor em rem\u00e9dio,",
   "s": 41.303,
   "e": 43.634
  },
  {
   "text": "e ele salvou milh\u00f5es de pessoas.",
   "s": 43.996,
   "e": 45.664
  },
  {
   "text": "Em mil novecentos e quarenta e cinco,",
   "s": 46.514,
   "e": 48.102
  },
  {
   "text": "Fleming ganhou o Nobel.",
   "s": 48.395,
   "e": 49.361
  },
  {
   "text": "No fim,",
   "s": 50.208,
   "e": 50.593
  },
  {
   "text": "a bagun\u00e7a dele valeu mais que qualquer faxina.",
   "s": 50.827,
   "e": 53.103
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 53.961,
   "e": 55.404
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 55.699,
   "e": 57.46
  }
 ]
}