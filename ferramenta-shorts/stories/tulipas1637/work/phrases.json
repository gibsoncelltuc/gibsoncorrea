 "phrases": [
  {
   "text": "Uma \u00fanica flor j\u00e1 custou o pre\u00e7o de uma casa inteira.",
   "s": 0.158,
   "e": 2.75
  },
  {
   "text": "Era a Holanda,",
   "s": 3.616,
   "e": 4.24
  },
  {
   "text": "e a tulipa tinha acabado de chegar do Oriente.",
   "s": 4.512,
   "e": 6.766
  },
  {
   "text": "Colorida,",
   "s": 7.642,
   "e": 8.189
  },
  {
   "text": "rara,",
   "s": 8.39,
   "e": 8.701
  },
  {
   "text": "e na moda.",
   "s": 8.946,
   "e": 9.43
  },
  {
   "text": "Os ricos queriam as mais raras.",
   "s": 10.296,
   "e": 11.92
  },
  {
   "text": "\"Dou mil moedas por esse bulbo\",",
   "s": 12.764,
   "e": 14.325
  },
  {
   "text": "dizia um.",
   "s": 14.579,
   "e": 15.153
  },
  {
   "text": "\"Dou duas mil\",",
   "s": 16.017,
   "e": 16.861
  },
  {
   "text": "gritava outro.",
   "s": 17.031,
   "e": 17.781
  },
  {
   "text": "Logo,",
   "s": 18.631,
   "e": 18.974
  },
  {
   "text": "o pa\u00eds inteiro estava comprando.",
   "s": 19.229,
   "e": 20.722
  },
  {
   "text": "Padeiros,",
   "s": 21.588,
   "e": 22.063
  },
  {
   "text": "sapateiros,",
   "s": 22.224,
   "e": 22.904
  },
  {
   "text": "gente que nunca tinha plantado nada.",
   "s": 23.11,
   "e": 24.848
  },
  {
   "text": "Ningu\u00e9m queria a flor de verdade.",
   "s": 25.684,
   "e": 27.325
  },
  {
   "text": "Queriam vender o papel mais caro na semana seguinte,",
   "s": 28.198,
   "e": 30.718
  },
  {
   "text": "e ficar ricos.",
   "s": 30.936,
   "e": 31.758
  },
  {
   "text": "Contam que um marinheiro comeu um bulbo no almo\u00e7o,",
   "s": 32.623,
   "e": 34.75
  },
  {
   "text": "achando que era cebola.",
   "s": 35.019,
   "e": 36.111
  },
  {
   "text": "Valia uma fortuna.",
   "s": 36.949,
   "e": 37.963
  },
  {
   "text": "Acontece que,",
   "s": 38.841,
   "e": 39.675
  },
  {
   "text": "num leil\u00e3o de fevereiro,",
   "s": 39.904,
   "e": 40.922
  },
  {
   "text": "o vendedor abriu os lances,",
   "s": 41.244,
   "e": 42.646
  },
  {
   "text": "e ningu\u00e9m levantou a m\u00e3o.",
   "s": 42.854,
   "e": 43.916
  },
  {
   "text": "A not\u00edcia correu.",
   "s": 44.783,
   "e": 45.675
  },
  {
   "text": "Em poucos dias,",
   "s": 46.529,
   "e": 47.441
  },
  {
   "text": "todo mundo quis vender,",
   "s": 47.659,
   "e": 48.809
  },
  {
   "text": "e n\u00e3o havia mais comprador.",
   "s": 49.136,
   "e": 50.466
  },
  {
   "text": "Os pre\u00e7os desabaram.",
   "s": 51.291,
   "e": 52.404
  },
  {
   "text": "Quem tinha trocado a casa por flores ficou s\u00f3 com as flores,",
   "s": 53.28,
   "e": 56.19
  },
  {
   "text": "e as d\u00edvidas.",
   "s": 56.378,
   "e": 57.11
  },
  {
   "text": "O marinheiro,",
   "s": 57.969,
   "e": 58.539
  },
  {
   "text": "pelo menos,",
   "s": 58.837,
   "e": 59.386
  },
  {
   "text": "almo\u00e7ou bem.",
   "s": 59.518,
   "e": 60.23
  }
