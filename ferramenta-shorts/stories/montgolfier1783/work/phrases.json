 "phrases": [
  {
   "text": "Os primeiros passageiros de um bal\u00e3o n\u00e3o foram pessoas.",
   "s": 0.154,
   "e": 2.806
  },
  {
   "text": "Foram uma ovelha,",
   "s": 3.716,
   "e": 4.396
  },
  {
   "text": "um pato e um galo.",
   "s": 4.522,
   "e": 5.459
  },
  {
   "text": "Era mil setecentos e oitenta e tr\u00eas,",
   "s": 6.315,
   "e": 8.178
  },
  {
   "text": "na Fran\u00e7a.",
   "s": 8.351,
   "e": 8.964
  },
  {
   "text": "Os irm\u00e3os Montgolfier,",
   "s": 9.829,
   "e": 10.922
  },
  {
   "text": "donos de uma f\u00e1brica de papel,",
   "s": 11.112,
   "e": 12.57
  },
  {
   "text": "repararam que a fuma\u00e7a quente fazia sacos de papel flutuarem.",
   "s": 12.849,
   "e": 15.821
  },
  {
   "text": "Ent\u00e3o costuraram um bal\u00e3o gigante de pano e papel,",
   "s": 16.677,
   "e": 19.325
  },
  {
   "text": "e encheram de ar quente.",
   "s": 19.624,
   "e": 20.711
  },
  {
   "text": "S\u00f3 que ningu\u00e9m sabia se dava para respirar l\u00e1 em cima.",
   "s": 21.581,
   "e": 24.277
  },
  {
   "text": "E se o ar do c\u00e9u matasse?",
   "s": 25.142,
   "e": 26.532
  },
  {
   "text": "A solu\u00e7\u00e3o:",
   "s": 27.384,
   "e": 27.969
  },
  {
   "text": "mandar bichos na frente.",
   "s": 28.228,
   "e": 29.482
  },
  {
   "text": "Uma ovelha,",
   "s": 30.329,
   "e": 30.855
  },
  {
   "text": "um pato e um galo entraram na cesta.",
   "s": 31.041,
   "e": 32.772
  },
  {
   "text": "No pal\u00e1cio de Versalhes,",
   "s": 33.625,
   "e": 34.885
  },
  {
   "text": "o rei Lu\u00eds dezesseis e a rainha Maria Antonieta vieram assistir,",
   "s": 35.169,
   "e": 38.348
  },
  {
   "text": "com uma multid\u00e3o.",
   "s": 38.654,
   "e": 39.346
  },
  {
   "text": "Acontece que o bal\u00e3o levantou voo de verdade,",
   "s": 40.209,
   "e": 42.526
  },
  {
   "text": "e foi embora pelo c\u00e9u,",
   "s": 42.842,
   "e": 43.969
  },
  {
   "text": "com os bichos dentro.",
   "s": 44.284,
   "e": 45.235
  },
  {
   "text": "Oito minutos depois,",
   "s": 46.086,
   "e": 47.167
  },
  {
   "text": "ele desceu num bosque a uns tr\u00eas quil\u00f4metros dali.",
   "s": 47.366,
   "e": 49.704
  },
  {
   "text": "Os irm\u00e3os correram para ver.",
   "s": 50.566,
   "e": 51.956
  },
  {
   "text": "Os tr\u00eas bichos estavam vivos e bem!",
   "s": 52.78,
   "e": 54.763
  },
  {
   "text": "Dava para respirar no c\u00e9u.",
   "s": 55.614,
   "e": 57.034
  },
  {
   "text": "Dois meses depois,",
   "s": 57.891,
   "e": 58.925
  },
  {
   "text": "foi a vez de dois homens voarem sobre Paris.",
   "s": 59.177,
   "e": 61.404
  },
  {
   "text": "A humanidade tinha chegado ao c\u00e9u.",
   "s": 62.262,
   "e": 63.996
  },
  {
   "text": "E tudo gra\u00e7as a uma ovelha,",
   "s": 64.874,
   "e": 66.211
  },
  {
   "text": "um pato e um galo corajosos.",
   "s": 66.421,
   "e": 67.99
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 68.83,
   "e": 70.277
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 70.57,
   "e": 72.332
  }
 ]
