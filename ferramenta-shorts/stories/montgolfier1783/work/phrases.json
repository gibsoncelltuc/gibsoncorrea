 "phrases": [
  {
   "text": "Os primeiros passageiros de um bal\u00e3o n\u00e3o foram pessoas.",
   "s": 0.154,
   "e": 2.806
  },
  {
   "text": "Foram uma ovelha,",
   "s": 3.716,
   "e": 4.396
  },
  {
   "text": "um pato e um galo.",
   "s": 4.522,
   "e": 5.457
  },
  {
   "text": "Era mil setecentos e oitenta e tr\u00eas,",
   "s": 6.315,
   "e": 8.178
  },
  {
   "text": "na Fran\u00e7a.",
   "s": 8.351,
   "e": 8.964
  },
  {
   "text": "Os irm\u00e3os Montgolfier,",
   "s": 9.83,
   "e": 10.931
  },
  {
   "text": "donos de uma f\u00e1brica de papel,",
   "s": 11.114,
   "e": 12.571
  },
  {
   "text": "viram que a fuma\u00e7a quente fazia sacos de papel flutuarem.",
   "s": 12.84,
   "e": 15.628
  },
  {
   "text": "Ent\u00e3o fizeram um bal\u00e3o gigante de pano e papel,",
   "s": 16.487,
   "e": 19.01
  },
  {
   "text": "cheio de ar quente.",
   "s": 19.284,
   "e": 20.176
  },
  {
   "text": "S\u00f3 que ningu\u00e9m sabia se dava para respirar l\u00e1 em cima.",
   "s": 21.047,
   "e": 23.744
  },
  {
   "text": "A solu\u00e7\u00e3o:",
   "s": 24.611,
   "e": 25.197
  },
  {
   "text": "mandar bichos na frente.",
   "s": 25.456,
   "e": 26.708
  },
  {
   "text": "Uma ovelha,",
   "s": 27.557,
   "e": 28.081
  },
  {
   "text": "um pato e um galo entraram na cesta.",
   "s": 28.269,
   "e": 29.993
  },
  {
   "text": "Em Versalhes,",
   "s": 30.859,
   "e": 31.576
  },
  {
   "text": "o rei Lu\u00eds dezesseis e Maria Antonieta assistiram,",
   "s": 31.884,
   "e": 34.356
  },
  {
   "text": "no meio de uma multid\u00e3o.",
   "s": 34.633,
   "e": 35.759
  },
  {
   "text": "Acontece que o bal\u00e3o levantou voo de verdade,",
   "s": 36.614,
   "e": 38.933
  },
  {
   "text": "com os bichos dentro.",
   "s": 39.247,
   "e": 40.194
  },
  {
   "text": "Oito minutos depois,",
   "s": 41.057,
   "e": 42.146
  },
  {
   "text": "ele desceu num bosque a tr\u00eas quil\u00f4metros dali,",
   "s": 42.393,
   "e": 44.603
  },
  {
   "text": "e os bichos estavam vivos:",
   "s": 44.848,
   "e": 46.306
  },
  {
   "text": "dava para respirar no c\u00e9u.",
   "s": 46.503,
   "e": 47.874
  },
  {
   "text": "Dois meses depois,",
   "s": 48.741,
   "e": 49.79
  },
  {
   "text": "outro bal\u00e3o levou dois homens por cima de Paris.",
   "s": 50.033,
   "e": 52.516
  },
  {
   "text": "Tudo gra\u00e7as a tr\u00eas bichos corajosos.",
   "s": 53.384,
   "e": 55.508
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 56.359,
   "e": 57.803
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 58.096,
   "e": 59.858
  }
 ]
