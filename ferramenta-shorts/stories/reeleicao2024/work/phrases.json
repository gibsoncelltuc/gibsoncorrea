 "phrases": [
  {
   "text": "Donald Trump perdeu a elei\u00e7\u00e3o de dois mil e vinte.",
   "s": 0.162,
   "e": 2.615
  },
  {
   "text": "Quatro anos depois,",
   "s": 3.477,
   "e": 4.558
  },
  {
   "text": "voltou para a Casa Branca.",
   "s": 4.775,
   "e": 5.985
  },
  {
   "text": "Foi em novembro de dois mil e vinte e quatro,",
   "s": 6.898,
   "e": 8.625
  },
  {
   "text": "nos Estados Unidos.",
   "s": 8.772,
   "e": 9.823
  },
  {
   "text": "Milh\u00f5es de americanos foram \u00e0s urnas escolher entre Trump e a vice-presidente Kamala Harris.",
   "s": 10.687,
   "e": 15.105
  },
  {
   "text": "A contagem entrou pela madrugada.",
   "s": 15.958,
   "e": 17.612
  },
  {
   "text": "Os estados indecisos iam decidir tudo.",
   "s": 18.449,
   "e": 20.519
  },
  {
   "text": "Acontece que Trump venceu em todos os estados decisivos,",
   "s": 21.376,
   "e": 24.499
  },
  {
   "text": "e somou trezentos e doze votos no col\u00e9gio eleitoral.",
   "s": 24.749,
   "e": 27.487
  },
  {
   "text": "Os apoiadores comemoraram a noite inteira.",
   "s": 28.355,
   "e": 30.516
  },
  {
   "text": "Trump subiu ao palco e declarou vit\u00f3ria.",
   "s": 31.386,
   "e": 33.403
  },
  {
   "text": "Foi um feito raro:",
   "s": 34.32,
   "e": 35.156
  },
  {
   "text": "ele virou s\u00f3 o segundo presidente da hist\u00f3ria com dois mandatos separados.",
   "s": 35.429,
   "e": 38.974
  },
  {
   "text": "O primeiro foi Grover Cleveland,",
   "s": 39.833,
   "e": 41.347
  },
  {
   "text": "h\u00e1 mais de cento e trinta anos.",
   "s": 41.537,
   "e": 43.057
  },
  {
   "text": "Em vinte de janeiro de dois mil e vinte e cinco,",
   "s": 43.91,
   "e": 45.873
  },
  {
   "text": "ele tomou posse de novo.",
   "s": 46.09,
   "e": 47.198
  },
  {
   "text": "Antes ele tinha sido o presidente quarenta e cinco.",
   "s": 48.064,
   "e": 50.474
  },
  {
   "text": "Agora,",
   "s": 51.323,
   "e": 51.771
  },
  {
   "text": "era o quarenta e sete.",
   "s": 51.966,
   "e": 52.973
  },
  {
   "text": "Perdeu,",
   "s": 53.848,
   "e": 54.267
  },
  {
   "text": "voltou e ganhou.",
   "s": 54.52,
   "e": 55.322
  },
  {
   "text": "Uma das maiores viradas da pol\u00edtica americana.",
   "s": 56.179,
   "e": 58.409
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 59.25,
   "e": 60.695
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 60.987,
   "e": 62.749
  }
 ]
