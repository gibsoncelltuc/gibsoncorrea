 "phrases": [
  {
   "text": "Uma frota de navios de guerra foi capturada por soldados a cavalo.",
   "s": 0.161,
   "e": 3.46
  },
  {
   "text": "Era mil setecentos e noventa e cinco,",
   "s": 4.304,
   "e": 6.07
  },
  {
   "text": "a Fran\u00e7a invadia a Holanda,",
   "s": 6.308,
   "e": 7.63
  },
  {
   "text": "e fazia um frio absurdo.",
   "s": 7.891,
   "e": 9.253
  },
  {
   "text": "A frota holandesa estava ancorada perto de Den Helder,",
   "s": 10.116,
   "e": 12.62
  },
  {
   "text": "e o mar congelou em volta dela.",
   "s": 12.967,
   "e": 14.496
  },
  {
   "text": "Os navios ficaram presos no gelo,",
   "s": 15.326,
   "e": 16.919
  },
  {
   "text": "sem conseguir sair do lugar.",
   "s": 17.221,
   "e": 18.684
  },
  {
   "text": "Do outro lado,",
   "s": 19.477,
   "e": 20.241
  },
  {
   "text": "os franceses tinham cavalaria,",
   "s": 20.474,
   "e": 21.974
  },
  {
   "text": "os hussardos,",
   "s": 22.221,
   "e": 22.88
  },
  {
   "text": "e nenhum navio.",
   "s": 23.077,
   "e": 23.858
  },
  {
   "text": "O chefe da cavalaria teve uma ideia maluca:",
   "s": 24.729,
   "e": 26.787
  },
  {
   "text": "atacar a frota a cavalo.",
   "s": 27.047,
   "e": 28.285
  },
  {
   "text": "S\u00f3 que ningu\u00e9m sabia se o gelo ia aguentar o peso de centenas de cavalos.",
   "s": 29.163,
   "e": 32.904
  },
  {
   "text": "Na noite de vinte e tr\u00eas de janeiro,",
   "s": 33.745,
   "e": 35.279
  },
  {
   "text": "os hussardos atravessaram o gelo,",
   "s": 35.602,
   "e": 37.093
  },
  {
   "text": "com panos nos cascos dos cavalos.",
   "s": 37.405,
   "e": 39.198
  },
  {
   "text": "Acontece que os holandeses nem tentaram lutar.",
   "s": 40.073,
   "e": 42.471
  },
  {
   "text": "A frota inteira se rendeu.",
   "s": 43.271,
   "e": 44.653
  },
  {
   "text": "Mais de uma dezena de navios de guerra,",
   "s": 45.528,
   "e": 47.339
  },
  {
   "text": "capturados por soldados a cavalo.",
   "s": 47.566,
   "e": 49.411
  },
  {
   "text": "Cavalaria um,",
   "s": 50.252,
   "e": 50.95
  },
  {
   "text": "marinha zero.",
   "s": 51.193,
   "e": 51.935
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 52.768,
   "e": 54.213
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 54.505,
   "e": 56.267
  }
 ]
