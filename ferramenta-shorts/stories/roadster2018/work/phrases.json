 "phrases": [
  {
   "text": "Um carro de verdade est\u00e1 dando voltas ao redor do Sol at\u00e9 hoje.",
   "s": 0.155,
   "e": 3.494
  },
  {
   "text": "\u00c9 um Tesla Roadster vermelho,",
