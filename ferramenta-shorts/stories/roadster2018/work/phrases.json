 "phrases": [
  {
   "text": "Em fevereiro de dois mil e dezoito,",
   "s": 0.15,
   "e": 1.56
  },
  {
   "text": "um Tesla de verdade foi lan\u00e7ado para o espa\u00e7o.",
   "s": 1.814,
   "e": 4.209
  },
  {
   "text": "Era um Roadster vermelho,",
   "s": 5.079,
   "e": 6.303
  },
  {
   "text": "e quem teve a ideia foi Elon Musk,",
   "s": 6.577,
   "e": 8.291
  },
  {
   "text": "o dono da SpaceX.",
   "s": 8.547,
   "e": 9.765
  },
  {
   "text": "O voo de estreia do Falcon Heavy,",
   "s": 10.627,
   "e": 12.197
  },
  {
   "text": "o maior foguete da empresa,",
   "s": 12.463,
   "e": 13.755
  },
  {
   "text": "aconteceu em seis de fevereiro,",
   "s": 13.997,
   "e": 15.485
  },
  {
   "text": "em Cabo Canaveral,",
   "s": 15.762,
   "e": 16.714
  },
  {
   "text": "nos Estados Unidos.",
   "s": 16.855,
   "e": 17.955
  },
  {
   "text": "Como era s\u00f3 um teste,",
   "s": 18.828,
   "e": 19.895
  },
  {
   "text": "em vez de colocar peso de concreto,",
   "s": 20.177,
   "e": 21.847
  },
  {
   "text": "Musk resolveu mandar o Roadster.",
   "s": 22.128,
   "e": 23.651
  },
  {
   "text": "O foguete decolou com um estrondo!",
   "s": 24.513,
   "e": 26.219
  },
  {
   "text": "No banco do motorista foi sentado um boneco de astronauta,",
   "s": 27.087,
   "e": 29.895
  },
  {
   "text": "chamado Starman.",
   "s": 30.213,
   "e": 31.089
  },
  {
   "text": "No painel,",
   "s": 31.919,
   "e": 32.472
  },
  {
   "text": "estava escrito:",
   "s": 32.692,
   "e": 33.39
  },
  {
   "text": "N\u00e3o entre em p\u00e2nico.",
   "s": 33.59,
   "e": 34.573
  },
  {
   "text": "O Roadster saiu da \u00f3rbita da Terra,",
   "s": 35.437,
   "e": 37.34
  },
  {
   "text": "e seguiu em \u00f3rbita ao redor do Sol.",
   "s": 37.649,
   "e": 39.32
  },
  {
   "text": "E ele continua l\u00e1 em cima,",
   "s": 40.184,
   "e": 41.569
  },
  {
   "text": "dando voltas,",
   "s": 41.776,
   "e": 42.535
  },
  {
   "text": "at\u00e9 hoje.",
   "s": 42.714,
   "e": 43.286
  },
  {
   "text": "Um Roadster,",
