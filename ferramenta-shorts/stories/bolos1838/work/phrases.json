 "phrases": [
  {
   "text": "A Fran\u00e7a invadiu o M\u00e9xico por causa de uma conta de confeitaria.",
   "s": 0.163,
   "e": 3.322
  },
  {
   "text": "Um confeiteiro franc\u00eas tinha uma loja perto da Cidade do M\u00e9xico,",
   "s": 4.156,
   "e": 7.23
  },
  {
   "text": "famosa pelos doces.",
   "s": 7.533,
   "e": 8.676
  },
  {
   "text": "Um dia,",
   "s": 9.535,
   "e": 9.985
  },
  {
   "text": "oficiais mexicanos entraram,",
   "s": 10.237,
   "e": 11.75
  },
  {
   "text": "comeram tudo o que havia,",
   "s": 12.056,
   "e": 13.257
  },
  {
   "text": "quebraram a loja,",
   "s": 13.452,
   "e": 14.296
  },
  {
   "text": "e sa\u00edram sem pagar.",
   "s": 14.513,
   "e": 15.665
  },
  {
   "text": "O confeiteiro escreveu ao rei da Fran\u00e7a.",
   "s": 16.467,
   "e": 18.315
  },
  {
   "text": "\"Quero sessenta mil pesos\",",
   "s": 19.188,
   "e": 20.579
  },
  {
   "text": "pediu ele.",
   "s": 20.825,
   "e": 21.366
  },
  {
   "text": "A loja inteira valia mil.",
   "s": 22.234,
   "e": 23.55
  },
  {
   "text": "O rei gostou da ideia,",
   "s": 24.42,
   "e": 25.531
  },
  {
   "text": "juntou outras queixas,",
   "s": 25.75,
   "e": 26.997
  },
  {
   "text": "e cobrou seiscentos mil.",
   "s": 27.274,
   "e": 28.806
  },
  {
   "text": "\"Paguem, ou mandamos a marinha\",",
   "s": 29.074,
   "e": 30.105
  },
  {
   "text": "avisou a Fran\u00e7a.",
   "s": 30.254,
   "e": 31.152
  },
  {
   "text": "O M\u00e9xico riu da cobran\u00e7a,",
   "s": 31.998,
   "e": 33.335
  },
  {
   "text": "e n\u00e3o pagou um centavo.",
   "s": 33.594,
   "e": 34.748
  },
  {
   "text": "Acontece que a Fran\u00e7a mandou mesmo.",
   "s": 35.626,
   "e": 37.5
  },
  {
   "text": "Navios de guerra fecharam todos os portos do pa\u00eds.",
   "s": 38.359,
   "e": 41.065
  },
  {
   "text": "Os canh\u00f5es franceses bombardearam a fortaleza de Veracruz,",
   "s": 41.927,
   "e": 44.998
  },
  {
   "text": "e os soldados tomaram a cidade.",
   "s": 45.284,
   "e": 46.779
  },
  {
   "text": "Um general mexicano correu para o combate,",
   "s": 47.63,
   "e": 49.623
  },
  {
   "text": "e perdeu uma perna para um tiro de canh\u00e3o.",
   "s": 49.886,
   "e": 51.708
  },
  {
   "text": "Meses depois,",
   "s": 52.559,
   "e": 53.358
  },
  {
   "text": "o M\u00e9xico pagou os seiscentos mil pesos,",
   "s": 53.634,
   "e": 55.653
  },
  {
   "text": "e a Fran\u00e7a foi embora.",
   "s": 55.92,
   "e": 57.003
  },
  {
   "text": "Nunca um doce custou t\u00e3o caro.",
   "s": 57.856,
   "e": 59.533
  }
