 "phrases": [
  {
   "text": "A car lifted off the ground and flew in front of guests.",
   "s": 0.265,
   "e": 2.967
  },
  {
   "text": "And it was not a special effect.",
   "s": 3.47,
   "e": 4.986
  },
  {
   "text": "It was Elon Musk's new invention,",
   "s": 5.487,
   "e": 7.211
  },
  {
   "text": "at a SpaceX base,",
   "s": 7.417,
   "e": 8.627
  },
  {
   "text": "in Texas,",
   "s": 8.777,
   "e": 9.471
  },
  {
   "text": "in October twenty twenty-six.",
   "s": 9.691,
   "e": 11.327
  },
  {
   "text": "The first trick:",
   "s": 11.84,
   "e": 12.631
  },
  {
   "text": "a suction system sticks the car to the track,",
   "s": 12.966,
   "e": 15.224
  },
  {
