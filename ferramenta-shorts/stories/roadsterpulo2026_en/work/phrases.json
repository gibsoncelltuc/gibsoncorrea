   "e": 27.297
  },
  {
   "text": "ten hidden nozzles,",
   "s": 27.8,
   "e": 28.853
  },
  {
   "text": "that blow compressed air downward.",
   "s": 29.09,
   "e": 30.614
  },
  {
   "text": "That is how it took off and flew,",
   "s": 31.129,
   "e": 32.628
  },
  {
   "text": "on its thrusters,",
   "s": 32.827,
   "e": 33.71
  },
  {
   "text": "over parked vehicles.",
   "s": 34.042,
   "e": 35.166
  },
  {
   "text": "And,",
   "s": 35.677,
   "e": 35.888
  },
  {
   "text": "according to Tesla,",
   "s": 36.031,
   "e": 37.008
  },
  {
