 "phrases": [
  {
   "text": "Elon Musk mandou construir uma torre com bra\u00e7os gigantes,",
   "s": 0.16,
   "e": 3.123
  },
  {
   "text": "para pegar um foguete no ar.",
   "s": 3.362,
   "e": 4.548
  },
  {
   "text": "Foi em outubro de dois mil e vinte e quatro,",
   "s": 5.417,
   "e": 7.03
  },
  {
   "text": "na base de foguetes da SpaceX,",
   "s": 7.329,
   "e": 9.092
  },
  {
   "text": "no Texas.",
   "s": 9.251,
   "e": 9.949
  },
  {
   "text": "Normalmente,",
   "s": 10.807,
   "e": 11.513
  },
  {
   "text": "a parte de baixo do foguete \u00e9 descartada,",
   "s": 11.713,
   "e": 13.768
  },
  {
   "text": "ou pousa sobre pernas,",
   "s": 14.05,
   "e": 15.233
  },
  {
   "text": "que pesam e custam caro.",
   "s": 15.47,
   "e": 16.748
  },
  {
   "text": "A ideia de Musk:",
   "s": 17.586,
   "e": 18.541
  },
  {
   "text": "tirar as pernas do foguete,",
   "s": 18.774,
   "e": 20.122
  },
  {
   "text": "e fazer a pr\u00f3pria torre agarrar o propulsor na volta.",
   "s": 20.43,
   "e": 22.916
  },
  {
   "text": "Os engenheiros chamaram a torre de Mechazilla,",
   "s": 23.777,
   "e": 25.822
  },
  {
   "text": "e os bra\u00e7os de pauzinhos.",
   "s": 26.055,
   "e": 27.404
  },
  {
   "text": "No dia do teste,",
   "s": 28.259,
   "e": 29.109
  },
  {
   "text": "o propulsor gigante decolou com trinta e tr\u00eas motores acesos.",
   "s": 29.401,
   "e": 32.49
  },
  {
   "text": "Minutos depois,",
   "s": 33.342,
   "e": 34.249
  },
  {
   "text": "ele voltou descendo de r\u00e9,",
   "s": 34.47,
   "e": 35.767
  },
  {
   "text": "direto na dire\u00e7\u00e3o da torre.",
   "s": 36.035,
   "e": 37.434
  },
  {
   "text": "Acontece que,",
   "s": 38.316,
   "e": 39.168
  },
  {
   "text": "no \u00faltimo segundo,",
   "s": 39.372,
   "e": 40.3
  },
  {
   "text": "os bra\u00e7os se fecharam,",
   "s": 40.577,
   "e": 41.691
  },
  {
   "text": "e seguraram o foguete no ar.",
   "s": 41.999,
   "e": 43.349
  },
  {
   "text": "Os engenheiros comemoraram:",
   "s": 44.17,
   "e": 45.464
  },
  {
   "text": "era a primeira vez na hist\u00f3ria.",
   "s": 45.775,
   "e": 47.044
  },
  {
   "text": "Assim,",
   "s": 47.885,
   "e": 48.279
  },
  {
   "text": "o propulsor que antes ia para o lixo pode voar de novo,",
   "s": 48.526,
   "e": 51.279
  },
  {
   "text": "v\u00e1rias vezes.",
   "s": 51.511,
   "e": 52.293
  },
  {
   "text": "Parece filme de rob\u00f4 gigante,",
   "s": 53.167,
