 "phrases": [
  {
   "text": "Dois estados americanos foram \u00e0 guerra,",
   "s": 0.161,
   "e": 2.139
  },
  {
   "text": "e o \u00fanico ferido levou uma canivetada.",
   "s": 2.403,
   "e": 4.298
  },
  {
   "text": "De um lado,",
   "s": 5.132,
   "e": 5.773
  },
  {
   "text": "Ohio.",
   "s": 6.037,
   "e": 6.542
  },
  {
   "text": "Do outro,",
   "s": 7.408,
   "e": 7.893
  },
  {
   "text": "Michigan.",
   "s": 8.09,
   "e": 8.609
  },
  {
   "text": "Os dois juravam que a cidade de Toledo era deles,",
   "s": 9.431,
   "e": 11.746
  },
  {
   "text": "por causa de um erro num mapa antigo.",
   "s": 12.034,
   "e": 13.713
  },
  {
   "text": "O governador de Michigan tinha vinte e tr\u00eas anos.",
   "s": 14.571,
   "e": 16.906
  },
  {
   "text": "\"Mandem a mil\u00edcia\",",
   "s": 17.767,
   "e": 18.724
  },
  {
   "text": "ordenou ele.",
   "s": 18.99,
   "e": 19.64
  },
  {
   "text": "Ohio respondeu com a pr\u00f3pria mil\u00edcia,",
   "s": 20.515,
   "e": 22.529
  },
  {
   "text": "e as duas tropas chegaram \u00e0 beira do rio,",
   "s": 22.881,
   "e": 24.919
  },
  {
   "text": "frente a frente.",
   "s": 25.277,
   "e": 25.979
  },
  {
   "text": "Houve gritos,",
   "s": 26.839,
   "e": 27.547
  },
  {
   "text": "amea\u00e7as,",
   "s": 27.749,
   "e": 28.351
  },
  {
   "text": "e tiros.",
   "s": 28.547,
   "e": 29.04
  },
  {
   "text": "Todos para o alto.",
   "s": 29.919,
   "e": 30.831
  },
  {
   "text": "Ningu\u00e9m acertou ningu\u00e9m.",
   "s": 31.667,
   "e": 32.901
  },
  {
   "text": "Acontece que a \u00fanica baixa foi um xerife de Michigan,",
   "s": 33.777,
   "e": 36.394
  },
  {
   "text": "espetado na perna por um rapaz com um canivete.",
   "s": 36.663,
   "e": 38.979
  },
  {
   "text": "O presidente mandou os dois pararem,",
   "s": 39.845,
   "e": 41.591
  },
  {
   "text": "e o Congresso ofereceu um acordo.",
   "s": 41.885,
   "e": 43.434
  },
  {
   "text": "Ningu\u00e9m queria ceder.",
   "s": 44.284,
   "e": 45.412
  },
  {
   "text": "Ohio ficou com Toledo.",
   "s": 46.239,
   "e": 47.579
  },
  {
   "text": "Michigan levou,",
   "s": 48.431,
   "e": 49.268
  },
  {
   "text": "de consola\u00e7\u00e3o,",
   "s": 49.516,
   "e": 50.305
  },
  {
   "text": "um peda\u00e7o de floresta gelada que ningu\u00e9m queria.",
   "s": 50.563,
   "e": 52.914
  },
  {
   "text": "S\u00f3 que debaixo daquela floresta havia cobre e ferro.",
   "s": 53.771,
   "e": 56.285
  },
  {
   "text": "Uma fortuna.",
   "s": 57.15,
   "e": 57.897
  },
  {
   "text": "No fim das contas,",
   "s": 58.737,
   "e": 59.772
  },
  {
   "text": "Michigan perdeu a guerra,",
   "s": 60.004,
   "e": 61.25
  },
  {
   "text": "e ficou rico.",
