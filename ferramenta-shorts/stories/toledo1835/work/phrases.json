 "phrases": [
  {
   "text": "Em mil oitocentos e trinta e cinco,",
   "s": 0.151,
   "e": 1.676
  },
  {
   "text": "os Estados Unidos quase tiveram uma guerra civil por causa de uma faixa de terra:",
   "s": 1.985,
   "e": 5.828
  },
  {
   "text": "a faixa de Toledo.",
   "s": 6.088,
   "e": 7.045
  },
  {
   "text": "De um lado,",
   "s": 7.875,
   "e": 8.455
  },
  {
   "text": "o estado de Ohio.",
   "s": 8.696,
   "e": 9.724
  },
  {
   "text": "Do outro,",
   "s": 10.584,
   "e": 11.034
  },
  {
   "text": "o territ\u00f3rio de Michigan.",
   "s": 11.326,
   "e": 12.509
  },
  {
   "text": "Os dois diziam que a terra era deles.",
   "s": 13.33,
   "e": 15.248
  },
  {
   "text": "O governador de Michigan tinha s\u00f3 vinte e tr\u00eas anos,",
   "s": 16.116,
   "e": 18.569
  },
  {
   "text": "e mandou a mil\u00edcia para a fronteira.",
   "s": 18.805,
   "e": 20.371
  },
  {
   "text": "Ohio respondeu com a pr\u00f3pria mil\u00edcia,",
   "s": 21.239,
   "e": 23.246
  },
  {
   "text": "e as duas tropas ficaram frente a frente.",
   "s": 23.578,
   "e": 25.61
  },
  {
   "text": "Houve tiros,",
   "s": 26.466,
   "e": 27.18
  },
  {
   "text": "mas para o alto.",
   "s": 27.415,
   "e": 28.191
  },
  {
   "text": "Ningu\u00e9m acertou ningu\u00e9m.",
   "s": 29.044,
   "e": 30.278
  },
  {
   "text": "O \u00fanico ferido da guerra foi um xerife,",
   "s": 31.161,
   "e": 33.041
  },
  {
   "text": "esfaqueado na perna com um canivete.",
   "s": 33.251,
   "e": 35.079
  },
  {
   "text": "O governo federal mandou os dois pararem,",
   "s": 35.945,
   "e": 37.936
  },
  {
   "text": "e o Congresso prop\u00f4s um acordo.",
   "s": 38.25,
   "e": 39.731
  },
  {
   "text": "Ohio ficou com Toledo.",
   "s": 40.594,
   "e": 41.936
  },
  {
   "text": "Michigan ganhou,",
   "s": 42.784,
   "e": 43.585
  },
  {
   "text": "de consola\u00e7\u00e3o,",
   "s": 43.823,
   "e": 44.623
  },
  {
   "text": "a Pen\u00ednsula Superior,",
   "s": 44.845,
   "e": 45.92
  },
  {
   "text": "cheia de cobre e de ferro.",
   "s": 46.123,
   "e": 47.393
  },
  {
   "text": "Michigan virou estado,",
   "s": 48.237,
   "e": 49.374
  },
  {
   "text": "e o pr\u00eamio de consola\u00e7\u00e3o valeu muito mais que Toledo.",
   "s": 49.629,
   "e": 52.172
  }
 ]
