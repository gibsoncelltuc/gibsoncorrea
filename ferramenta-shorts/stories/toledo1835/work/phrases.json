  },
  {
   "text": "um xerife,",
   "s": 24.381,
   "e": 24.906
  },
  {
   "text": "esfaqueado numa taverna.",
   "s": 25.072,
   "e": 26.238
  },
  {
   "text": "Ohio ficou com Toledo.",
   "s": 27.036,
   "e": 28.264
  },
  {
   "text": "Michigan levou uma floresta gelada.",
   "s": 29.04,
   "e": 30.644
  },
  {
   "text": "Acontece que debaixo da floresta havia cobre e ferro.",
   "s": 31.438,
   "e": 33.847
  },
  {
   "text": "Michigan perdeu e ficou rico.",
