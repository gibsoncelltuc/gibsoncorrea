 "phrases": [
  {
   "text": "Dois estados foram \u00e0 guerra,",
   "s": 0.153,
   "e": 1.463
  },
  {
   "text": "e o \u00fanico ferido levou uma canivetada.",
   "s": 1.699,
   "e": 3.425
  },
  {
   "text": "E quem perdeu a guerra acabou ficando rico.",
   "s": 4.184,
   "e": 6.133
  },
  {
   "text": "Ohio e Michigan disputavam Toledo por causa de um mapa errado.",
   "s": 6.908,
   "e": 9.822
  },
  {
   "text": "O governador de Michigan,",
   "s": 10.595,
   "e": 11.725
  },
  {
   "text": "de 23 anos,",
   "s": 11.908,
   "e": 12.759
  },
  {
   "text": "ocupou Toledo.",
   "s": 12.986,
   "e": 13.675
  },
  {
   "text": "Ohio mandou a pr\u00f3pria mil\u00edcia.",
   "s": 14.48,
   "e": 16.056
  },
  {
   "text": "As tropas ficaram frente a frente.",
   "s": 16.828,
   "e": 18.373
  },
  {
   "text": "Houve gritos e tiros para o alto.",
   "s": 19.16,
   "e": 20.651
  },
  {
   "text": "Ningu\u00e9m acertou ningu\u00e9m.",
   "s": 21.418,
   "e": 22.558
  },
  {
   "text": "O \u00fanico ferido:",
