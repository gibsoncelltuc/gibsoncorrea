 "phrases": [
  {
   "text": "Dois estados americanos foram \u00e0 guerra,",
   "s": 0.161,
   "e": 2.139
  },
  {
   "text": "e o \u00fanico ferido levou uma canivetada.",
   "s": 2.403,
   "e": 4.298
  },
  {
   "text": "De um lado,",
   "s": 5.132,
   "e": 5.773
  },
  {
   "text": "Ohio.",
   "s": 6.037,
   "e": 6.542
  },
  {
   "text": "Do outro,",
   "s": 7.408,
   "e": 7.893
  },
  {
   "text": "Michigan.",
   "s": 8.09,
   "e": 8.609
  },
  {
   "text": "Os dois juravam que a cidade de Toledo era deles,",
   "s": 9.431,
   "e": 11.746
  },
  {
   "text": "por causa de um erro num mapa antigo.",
   "s": 12.034,
   "e": 13.713
  },
  {
   "text": "O governador de Michigan tinha s\u00f3 vinte e tr\u00eas anos,",
   "s": 14.572,
   "e": 16.988
  },
  {
   "text": "e mandou a mil\u00edcia ocupar Toledo.",
   "s": 17.272,
   "e": 18.828
  },
  {
   "text": "Ohio respondeu com a pr\u00f3pria mil\u00edcia,",
   "s": 19.674,
   "e": 21.688
  },
  {
   "text": "e as duas tropas chegaram \u00e0 beira do rio,",
   "s": 22.04,
   "e": 24.078
  },
  {
   "text": "frente a frente.",
   "s": 24.436,
   "e": 25.138
  },
  {
   "text": "Houve gritos,",
   "s": 25.999,
   "e": 26.669
  },
  {
   "text": "amea\u00e7as,",
   "s": 26.884,
   "e": 27.486
  },
  {
   "text": "e tiros por cima dos top\u00f3grafos de Ohio.",
   "s": 27.73,
   "e": 29.851
  },
  {
   "text": "Todos para o alto.",
   "s": 30.728,
   "e": 31.64
  },
  {
   "text": "Ningu\u00e9m acertou ningu\u00e9m.",
   "s": 32.476,
   "e": 33.71
  },
  {
   "text": "Acontece que a \u00fanica baixa foi um xerife de Michigan,",
   "s": 34.592,
   "e": 37.246
  },
  {
   "text": "espetado numa briga de taverna por um rapaz com um canivete.",
   "s": 37.48,
   "e": 40.357
  },
  {
   "text": "O presidente mandou os dois pararem,",
   "s": 41.222,
   "e": 42.968
  },
  {
   "text": "e o Congresso ofereceu um acordo.",
   "s": 43.262,
   "e": 44.81
  },
  {
   "text": "Ningu\u00e9m queria ceder.",
   "s": 45.661,
   "e": 46.789
  },
  {
   "text": "Ohio ficou com Toledo.",
   "s": 47.616,
   "e": 48.956
  },
  {
   "text": "Michigan levou,",
   "s": 49.808,
   "e": 50.645
  },
  {
   "text": "de consola\u00e7\u00e3o,",
   "s": 50.892,
   "e": 51.682
  },
  {
   "text": "um peda\u00e7o de floresta gelada que ningu\u00e9m queria.",
   "s": 51.94,
   "e": 54.294
  },
  {
   "text": "S\u00f3 que debaixo daquela floresta havia cobre e ferro.",
   "s": 55.148,
   "e": 57.662
  },
  {
   "text": "Uma fortuna.",
   "s": 58.527,
   "e": 59.263
  },
  {
   "text": "No fim das contas,",
   "s": 60.114,
   "e": 61.153
  },
  {
   "text": "Michigan perdeu a guerra,",
   "s": 61.381,
   "e": 62.627
  },
  {
   "text": "e ficou rico.",
   "s": 62.888,
   "e": 63.548
  },
  {
   "text": "Agora n\u00e3o deixe de comentar:",
   "s": 64.403,
   "e": 65.848
  },
  {
   "text": "qual deve ser o tema do pr\u00f3ximo v\u00eddeo?",
   "s": 66.141,
   "e": 67.903
  }
 ]
