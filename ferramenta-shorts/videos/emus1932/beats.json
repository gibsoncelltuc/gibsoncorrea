     1.2
    ],
    [
     "cannon",
     3.5,
     0.5,
     1.0
    ]
   ],
   "text": "10.000 BALAS",
   "tat": 6,
   "crowd": {
    "n": 14,
    "outfit": "AUS",
    "march": true
   }
  },
  {
   "say": "Mas emus são rápidos, e não ficam parados. Sempre que os soldados miravam, os pássaros se espalhavam em todas as direções, e fugiam correndo.",
   "shot": "group",
   "who": [
    "AUS:0:shock",
    "AUS:1:nervous"
   ],
   "emus": {
    "n": 10,
    "mode": "scatter",
    "x": 4.0,
    "z": 0.0
   }
  },
  {
   "say": "Um atirador até montou uma metralhadora num caminhão. Mas o caminhão pulava tanto no chão irregular, que ele não acertava nenhum pássaro.",
   "shot": "track",
   "who": [
    "AUS:2:grin"
