 "beats": [
  {
   "say": "Em mil novecentos e trinta e dois, a Austrália declarou guerra aos pássaros.",
   "shot": "reveal",
   "who": [],
   "text": "1932",
   "tat": 0,
   "light": "desert",
   "emus": {
    "n": 10,
    "mode": "stand",
    "x": 0.5,
    "z": 1.0,
    "cols": 5
   }
  },
  {
   "say": "Vinte mil emus estavam destruindo as plantações de trigo no oeste da Austrália, e fazendeiros desesperados pediram ajuda ao exército.",
   "shot": "group",
   "who": [
    "FARM:0:shock",
    "FARM:1:nervous"
   ],
   "text": "20.000 EMUS",
   "tat": 3,
   "tstyle": "red",
   "emus": {
    "n": 8,
    "mode": "stand",
    "x": 5.5,
    "z": 0.5,
    "cols": 3
   }
  },
  {
   "say": "Então o governo mandou soldados, duas metralhadoras, e dez mil balas. Contra emus.",
   "shot": "two",
   "who": [
    "AUS:0:stern",
    "AUS:1:grin",
    "AUS:2:neutral"
   ],
   "props": [
