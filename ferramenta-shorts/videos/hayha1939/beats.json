 "beats": [
  {
   "say": "Inverno de mil novecentos e trinta e nove. A União Soviética invadiu a Finlândia, com um exército enorme.",
   "shot": "crowd",
   "who": [
    "SOV:0:stern",
    "FIN:0:shock"
   ],
   "text": "1939",
   "tat": 0,
   "tstyle": "red",
   "mood": "march",
   "batalha": true,
   "impact": true,
   "crowd": {
    "n": 12,
    "outfits": [
     "SOV",
     "FIN"
    ]
   },
   "mapa": "FINLÂNDIA",
   "mapa_at": 1
  },
  {
   "say": "Os soldados finlandeses eram poucos, mas conheciam a floresta, a neve e o frio, de até quarenta graus abaixo de zero.",
   "shot": "group",
   "who": [
    "FIN:0:stern",
    "FIN:1:nervous",
    "FIN:2:stern"
   ],
   "text": "-40 °C",
   "tat": 18,
   "tstyle": "white",
   "mood": "tense",
   "set": "mountain"
  },
  {
   "say": "Um deles era um fazendeiro baixinho chamado Simo Häyhä.",
   "shot": "close",
   "who": [
    "SIM:0:smile"
   ],
   "text": "SIMO HÄYHÄ",
   "tat": 8,
   "tstyle": "blue",
   "interior": "madeira"
  },
  {
   "say": "Vestido de branco, ele esperava imóvel no meio da neve, horas a fio.",
   "shot": "low",
   "who": [
    "BRA:0:stern"
   ],
   "mood": "tense"
  },
  {
   "say": "Dizem que ele mantinha neve na boca, para o vapor da respiração não entregar a sua posição.",
   "shot": "close",
   "who": [
    "BRA:0:neutral"
   ],
   "text": "NEVE NA BOCA",
   "tat": 5,
   "tstyle": "white"
  },
  {
   "say": "Em cerca de cem dias, ele teve mais de quinhentos inimigos confirmados, com uma carabina de mira de ferro, sem luneta.",
   "shot": "two",
   "who": [
    "BRA:0:stern",
    "FIN:0:shock"
   ],
   "text": "100 DIAS",
   "tat": 4,
   "tstyle": "gold"
  },
  {
   "say": "Os soviéticos passaram a chamá-lo de Morte Branca.",
   "shot": "close",
   "who": [
    "SOV:1:shock"
   ],
   "text": "MORTE BRANCA",
   "tat": 8,
   "tstyle": "red",
   "interior": "pedra"
  },
  {
   "say": "Em março de mil novecentos e quarenta, uma bala atingiu o rosto dele. Ele sobreviveu, e acordou no dia em que a guerra terminou.",
   "shot": "two",
   "who": [
    "BRA:0:pained",
    "FIN:1:nervous"
   ],
   "mood": "calm",
   "interior": "loja"
  },
  {
   "say": "Viveu até os noventa e seis anos, e nunca se achou herói. Dizia que só tinha feito o seu trabalho.",
   "shot": "close",
   "who": [
    "BRA:0:smile"
   ],
   "text": "SÓ FEZ O SEU TRABALHO",
   "tat": 17,
   "tstyle": "white",
