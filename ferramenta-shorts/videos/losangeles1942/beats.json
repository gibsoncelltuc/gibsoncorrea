    "gun@45",
    "gun@60",
    "gun@75"
   ],
   "text": "1.400 TIROS",
   "tat": 9,
   "tstyle": "red",
   "light": "dusk"
  },
  {
   "say": "Os soldados atiravam, a cidade tremia, e nenhum avião inimigo apareceu.",
   "shot": "two",
   "who": [
    "SOL:1:shock",
    "CIV:0:pained"
   ],
   "fx": [
    "burst@20"
