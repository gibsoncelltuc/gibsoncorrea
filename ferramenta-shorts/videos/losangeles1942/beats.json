 "beats": [
  {
   "say": "Fevereiro de mil novecentos e quarenta e dois. Dois meses depois de Pearl Harbor, os Estados Unidos estavam em pânico.",
   "shot": "wide",
   "who": [
    "CIV:0:nervous",
    "CIV:1:nervous"
   ],
   "text": "1942",
   "tat": 0
  },
  {
   "say": "À noite, o radar viu algo no céu de Los Angeles, e as sirenes tocaram na cidade inteira.",
   "shot": "two",
   "who": [
    "WAR:0:shock",
    "CIV:2:shock"
   ],
   "text": "SIRENES",
   "tat": 12,
   "tstyle": "red",
   "light": "night",
   "sfx": [
    "sting@10"
   ]
  },
  {
   "say": "Apagaram as luzes, e os holofotes encontraram um objeto que ninguém sabia o que era.",
   "shot": "group",
   "who": [
    "WAR:1:nervous",
    "CIV:3:nervous",
    "SOL:0:shock"
   ],
   "text": "O QUE É ISSO?",
   "tat": 9,
   "tstyle": "white",
   "light": "night"
  },
  {
   "say": "As baterias antiaéreas abriram fogo. Foram mais de mil e quatrocentos tiros.",
   "shot": "group",
   "who": [
    "SOL:0:grin",
    "SOL:1:shock",
    "SOL:2:grin"
   ],
   "fx": [
    "burst@40",
