   "who": [
    "OHI:1:grin",
    "MIC:1:pained",
    "GOV:0:nervous"
   ],
   "text": "PRÊMIO DE CONSOLAÇÃO",
   "tat": 12,
   "tstyle": "gold"
  },
  {
   "say": "Michigan virou estado, e o prêmio de consolação valeu muito mais que Toledo.",
